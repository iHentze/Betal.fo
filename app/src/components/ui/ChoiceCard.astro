---
/**
 * A selectable card. Selected is surface-3 plus a lime hairline — never a lime fill.
 */
interface Props {
  name: string;
  value: string;
  title: string;
  hint?: string;
  checked?: boolean;
  disabled?: boolean;
  type?: "radio" | "checkbox";
  required?: boolean;
}

const {
  name,
  value,
  title,
  hint,
  checked = false,
  disabled = false,
  type = "radio",
  required = false,
} = Astro.props;
---

<label class:list={["choice-card", checked && "is-selected", disabled && "is-disabled"]}>
  <input
    type={type}
    name={name}
    value={value}
    checked={checked}
    disabled={disabled}
    required={required}
    data-required={required || undefined}
  />
  <div class="choice-card-title">{title}</div>
  {hint && <div class="choice-card-hint">{hint}</div>}
  <slot />
</label>
