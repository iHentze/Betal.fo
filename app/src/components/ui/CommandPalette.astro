---
/**
 * Command palette.
 *
 * This is where the resemblance to Linear is actually earned. The visual language can
 * be copied, but what makes Linear feel like Linear is that everything is reachable
 * from the keyboard — and for staff who run closes and process refunds all day, being
 * able to jump straight to a merchant or open a transaction by reference is the
 * difference between a tool and a website.
 */
interface Props {
  /** Navigation targets available to the current user, already role-filtered. */
  commands: Array<{ id: string; label: string; href: string; hint?: string }>;
}

const { commands } = Astro.props;
---

<dialog id="command-palette" class="modal" aria-label="Skipanir">
  <div style="padding: .5rem .625rem; border-bottom: 1px solid var(--color-line)">
    <input
      id="command-input"
      class="input"
      type="text"
      placeholder="Leita ella far til…"
      autocomplete="off"
      style="border: 0; background: transparent; padding: .25rem"
    />
  </div>
  <ul id="command-results" role="listbox" style="max-height: 20rem; overflow-y: auto; padding: .25rem">
    {
      commands.map((command, index) => (
        <li
          role="option"
          data-href={command.href}
          data-label={command.label.toLowerCase()}
          aria-selected={index === 0 ? "true" : "false"}
          class="list-row"
          style="border-bottom: 0; border-radius: var(--radius-control); cursor: pointer"
        >
          <span class="list-row-primary">{command.label}</span>
          {command.hint && <span class="list-row-meta">{command.hint}</span>}
        </li>
      ))
    }
  </ul>
</dialog>

<script>
  const dialog = document.getElementById("command-palette") as HTMLDialogElement | null;
  const input = document.getElementById("command-input") as HTMLInputElement | null;
  const list = document.getElementById("command-results");

  if (dialog && input && list) {
    const options = () =>
      Array.from(list.querySelectorAll<HTMLLIElement>("li:not([hidden])"));

    const select = (target: HTMLLIElement | undefined) => {
      if (!target) return;
      for (const option of options()) option.setAttribute("aria-selected", "false");
      target.setAttribute("aria-selected", "true");
      target.scrollIntoView({ block: "nearest" });
    };

    const open = () => {
      input.value = "";
      for (const option of Array.from(list.querySelectorAll<HTMLLIElement>("li"))) {
        option.hidden = false;
      }
      select(options()[0]);
      dialog.showModal();
      input.focus();
    };

    document.addEventListener("keydown", (event) => {
      // Cmd+K on macOS, Ctrl+K elsewhere.
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        dialog.open ? dialog.close() : open();
      }
    });

    input.addEventListener("input", () => {
      const query = input.value.trim().toLowerCase();
      for (const option of Array.from(list.querySelectorAll<HTMLLIElement>("li"))) {
        const label = option.dataset.label ?? "";
        option.hidden = query.length > 0 && !label.includes(query);
      }
      select(options()[0]);
    });

    input.addEventListener("keydown", (event) => {
      const visible = options();
      const current = visible.findIndex(
        (option) => option.getAttribute("aria-selected") === "true",
      );

      if (event.key === "ArrowDown") {
        event.preventDefault();
        select(visible[Math.min(current + 1, visible.length - 1)]);
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        select(visible[Math.max(current - 1, 0)]);
      } else if (event.key === "Enter") {
        event.preventDefault();
        const href = visible[current]?.dataset.href;
        if (href) window.location.href = href;
      }
    });

    list.addEventListener("click", (event) => {
      const option = (event.target as HTMLElement).closest("li");
      const href = option?.dataset.href;
      if (href) window.location.href = href;
    });
  }
</script>
