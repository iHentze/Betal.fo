---
/**
 * The betal wordmark, taken from the brand guide (Samleiki) as vector rather than a
 * traced bitmap, so it stays sharp at any size.
 *
 * Inherits `currentColor`, so it is green on dark surfaces and navy on light ones
 * without shipping two files.
 */
interface Props {
  /** Rendered width. The height follows the artwork's own ratio. */
  width?: string;
  class?: string;
  title?: string;
}

const { width = "5.5rem", class: className = "", title = "betal" } = Astro.props;
