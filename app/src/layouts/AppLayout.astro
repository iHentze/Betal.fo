---
import "~/styles/app.css";
import { fo } from "~/content/fo";
import CommandPalette from "~/components/ui/CommandPalette.astro";

/**
 * The application shell.
 *
 * Sidebar plus main column, with a thin top bar carrying a breadcrumb instead of a
 * large page heading — the breadcrumb is the title. Nothing here is wider than it
 * needs to be, because the point of this layout is to get out of the way of the data.
 */
export interface Crumb {
  label: string;
  href?: string;
}

export interface NavItem {
  label: string;
  href: string;
  count?: number;
}

export interface NavSection {
  label?: string;
  items: NavItem[];
}

interface Props {
  title: string;
  crumbs: Crumb[];
  nav: NavSection[];
  /** Shown in the sidebar header: the merchant, or "Betal" for staff. */
  context: string;
}

const { title, crumbs, nav, context } = Astro.props;
const path = Astro.url.pathname;

const commands = nav.flatMap((section) =>
  section.items.map((item) => ({
    id: item.href,
    label: item.label,
    href: item.href,
    hint: section.label,
  })),
);
---

<!doctype html>
<html lang="fo">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {fo.brand}</title>
    <meta name="theme-color" content="#0d0033" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="shell">
      <nav class="sidebar" aria-label={fo.nav.overview}>
        <div
          style="display:flex; align-items:center; gap:.5rem; padding:.375rem .5rem .5rem"
        >
          <span class="brand" style="font-size: var(--text-base)">{fo.brand}</span>
          <span style="font-size: var(--text-2xs); color: var(--color-ink-faint)">
            {context}
          </span>
        </div>

        {
          nav.map((section) => (
            <>
              {section.label && <div class="sidebar-section">{section.label}</div>}
              {section.items.map((item) => (
                <a
                  class="nav-item"
                  href={item.href}
                  aria-current={
                    path === item.href || path.startsWith(`${item.href}/`)
                      ? "page"
                      : undefined
                  }
                >
                  <span>{item.label}</span>
                  {item.count !== undefined && (
                    <span class="nav-count">{item.count}</span>
                  )}
                </a>
              ))}
            </>
          ))
        }

        <div style="margin-top:auto; padding:.5rem; font-size: var(--text-2xs); color: var(--color-ink-faint)">
          <kbd>⌘K</kbd> fyri skipanir
        </div>
      </nav>

      <div style="min-width:0; display:flex; flex-direction:column">
        <header class="topbar">
          {
            crumbs.map((crumb, index) => (
              <>
                {index > 0 && <span class="breadcrumb-sep">/</span>}
                {crumb.href ? (
                  <a href={crumb.href} style="color:inherit; text-decoration:none">
                    {crumb.label}
                  </a>
                ) : (
                  <span style="color: var(--color-ink)">{crumb.label}</span>
                )}
              </>
            ))
          }
          <div class="topbar-actions">
            <slot name="actions" />
          </div>
        </header>

        <slot name="banner" />

        <main style="min-width:0; flex:1">
          <slot />
        </main>
      </div>
    </div>

    <CommandPalette commands={commands} />
  </body>
</html>
