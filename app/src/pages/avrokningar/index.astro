---
import { env } from "~/lib/env";
import AppLayout from "~/layouts/AppLayout.astro";
import Amount from "~/components/ui/Amount.astro";
import { fo } from "~/content/fo";
import { navFor, formatDate } from "~/lib/nav";
import { scopeToMerchant } from "~/lib/auth";
import { listSettlementTransfers, settlementFeeBreakdown } from "~/lib/db/queries";
import { sumDecimals } from "~/lib/money";

export const prerender = false;

const actor = Astro.locals.actor!;
const db = env.DB;
const merchantId = scopeToMerchant(actor, Astro.url.searchParams.get("handil"));

const transfers = await listSettlementTransfers(db, merchantId, 50);

// The fee breakdown is the point of this screen: it answers "why is the money in my
// bank less than what I sold?", which is the question merchants ask constantly and
// almost no gateway dashboard answers.
const breakdowns = await Promise.all(
  transfers.map(async (transfer) => ({
    transfer,
    fees: await settlementFeeBreakdown(db, transfer.id as string),
  })),
);

const feeLabels: Record<string, string> = {
  ACQUIRER_FEE: fo.settlements.acquirerFee,
  INTERCHANGE_FEE: fo.settlements.interchangeFee,
  SCHEME_FEE: fo.settlements.schemeFee,
  RESERVE: fo.settlements.reserve,
  ADJUSTMENT: fo.settlements.adjustment,
  FEE: fo.settlements.fee,
};

const nav = navFor(actor);
---

<AppLayout
  title={fo.settlements.title}
  crumbs={[{ label: fo.settlements.title }]}
  nav={nav}
  context={actor.kind === "staff" ? "Betal" : ""}
>
  <p
    style="padding:.75rem .875rem; font-size: var(--text-xs); color: var(--color-ink-muted); border-bottom:1px solid var(--color-line)"
  >
    {fo.settlements.explainer}
  </p>

  {
    breakdowns.length === 0 ? (
      <p style="padding:2rem .875rem; color: var(--color-ink-muted)">
        {fo.settlements.empty}
      </p>
    ) : (
      breakdowns.map(({ transfer, fees }) => {
        const totalFees =
          fees.length > 0 ? sumDecimals(fees.map((f) => f.total)) : "0.00";
        return (
          <section style="border-bottom:1px solid var(--color-line)">
            <div class="list-row" style="min-height:2.5rem">
              <span class="list-row-primary">
                {formatDate(transfer.posting_date as string)}
                <span style="color: var(--color-ink-muted); margin-left:.5rem">
                  {transfer.acquirer as string}
                </span>
              </span>
              <span class="list-row-meta">
                <span>
                  {String(transfer.transaction_count ?? 0)}{" "}
                  {fo.settlements.transactionCount.toLowerCase()}
                </span>
                <Amount
                  decimal={transfer.net_amount as string}
                  currency={transfer.currency as string}
                />
              </span>
            </div>

            {fees.length > 0 && (
              <div style="padding:.25rem .875rem .75rem 2rem">
                <div
                  style="font-size: var(--text-2xs); color: var(--color-ink-faint); margin-bottom:.25rem"
                >
                  {fo.settlements.breakdown}
                </div>
                {fees.map((fee) => (
                  <div class="property-row" style="max-width:22rem">
                    <span class="property-label" style="width:10rem">
                      {feeLabels[fee.type] ?? fee.type}
                    </span>
                    <span class="property-value">
                      <Amount decimal={fee.total} />
                    </span>
                  </div>
                ))}
                <div class="property-row" style="max-width:22rem; border-top:1px solid var(--color-line); margin-top:.25rem; padding-top:.25rem">
                  <span class="property-label" style="width:10rem">
                    {fo.settlements.fees}
                  </span>
                  <span class="property-value">
                    <Amount decimal={totalFees} />
                  </span>
                </div>
              </div>
            )}
          </section>
        );
      })
    )
  }
</AppLayout>
