---
import AppLayout from "~/layouts/AppLayout.astro";
import Amount from "~/components/ui/Amount.astro";
import { env } from "~/lib/env";
import { fo } from "~/content/fo";
import { navFor, formatDate } from "~/lib/nav";
import { merchantScopeOrNull } from "~/lib/auth";
import { listSettlementTransfers, settlementFeeBreakdown } from "~/lib/db/queries";
import { sumDecimals, decimalToMinor } from "~/lib/money";

export const prerender = false;

const actor = Astro.locals.actor!;
const db = env.DB;
const merchantId = merchantScopeOrNull(actor, Astro.url.searchParams.get("handil"));
// Staff reach these screens from their own sidebar before choosing a merchant,
// which is a navigation state rather than an error.
if (!merchantId) return Astro.redirect("/betal/handlar");

const transfers = await listSettlementTransfers(db, merchantId, 50);

// The fee breakdown is the point of this screen: it answers "why is the money in my
// bank less than what I sold?", which merchants ask constantly and almost no gateway
// dashboard answers.
const rows = await Promise.all(
  transfers.map(async (transfer) => {
    const fees = await settlementFeeBreakdown(db, transfer.id as string);
    const totalFees = fees.length > 0 ? sumDecimals(fees.map((f) => f.total)) : "0.00";
    const netMinor = decimalToMinor(transfer.net_amount as string);
    const feesMinor = decimalToMinor(totalFees);
    return {
      transfer,
      fees,
      totalFees,
      netMinor,
      feesMinor,
      // What the sales were worth before the acquirer took its cut.
      grossMinor: netMinor - feesMinor,
    };
  }),
);

const totals = rows.reduce(
  (acc, row) => ({
    net: acc.net + row.netMinor,
    fees: acc.fees + row.feesMinor,
    gross: acc.gross + row.grossMinor,
  }),
  { net: 0, fees: 0, gross: 0 },
);

const feeLabels: Record<string, string> = {
  ACQUIRER_FEE: fo.settlements.acquirerFee,
  INTERCHANGE_FEE: fo.settlements.interchangeFee,
  SCHEME_FEE: fo.settlements.schemeFee,
  RESERVE: fo.settlements.reserve,
  ADJUSTMENT: fo.settlements.adjustment,
  FEE: fo.settlements.fee,
};

const COLUMNS = "minmax(7rem, 1fr) 7rem 5rem 8.5rem 8rem 9rem";
const nav = navFor(actor, merchantId);
---

<AppLayout
  title={fo.settlements.title}
  crumbs={[{ label: fo.settlements.title }]}
  nav={nav}
  context={actor.kind === "staff" ? "Betal" : ""}
>
  <div class="page-header">
    <div>
      <div class="stat-label">Útgoldið tilsamans</div>
      <div class="stat-value"><Amount minor={totals.net} currency="DKK" /></div>
      <div class="stat-sub">{rows.length} avrokningar</div>
    </div>
    <div>
      <div class="stat-label">Sølan var</div>
      <div class="stat-value" style="font-size:1.125rem">
        <Amount minor={totals.gross} />
      </div>
    </div>
    <div>
      <div class="stat-label">{fo.settlements.fees}</div>
      <div class="stat-value" style="font-size:1.125rem">
        <Amount minor={totals.fees} />
      </div>
      <div class="stat-sub">
        {totals.gross > 0
          ? `${((Math.abs(totals.fees) / totals.gross) * 100).toFixed(2).replace(".", ",")} %`
          : "—"}
      </div>
    </div>
  </div>

  <p
    style="padding:.625rem .875rem; font-size: var(--text-xs); color: var(--color-ink-muted); border-bottom:1px solid var(--color-line)"
  >
    {fo.settlements.explainer}
  </p>

  {
    rows.length === 0 ? (
      <div class="empty">
        <div class="empty-title">{fo.settlements.empty}</div>
        Avrokningar koma, tá innloysarin hevur útgoldið.
      </div>
    ) : (
      <div class="table" style={`--cols: ${COLUMNS}`}>
        <div class="group-header">
          <span class="group-title">{fo.settlements.posted}</span>
          <span class="group-count">{fo.transactions.acquirer}</span>
          <span class="group-count cell-num">{fo.settlements.transactionCount}</span>
          <span class="group-count cell-num">Sølan</span>
          <span class="group-count cell-num">{fo.settlements.fees}</span>
          <span class="group-count cell-num">{fo.settlements.netAmount}</span>
        </div>

        {rows.map((row) => (
          <details>
            <summary class="trow" style="cursor:pointer; list-style:none">
              <span class="cell-primary">
                {formatDate(row.transfer.posting_date as string)}
              </span>
              <span class="cell-quiet">{row.transfer.acquirer as string}</span>
              <span class="cell-quiet cell-num">
                {String(row.transfer.transaction_count ?? 0)}
              </span>
              <span class="cell-num" style="color: var(--color-ink-secondary)">
                <Amount minor={row.grossMinor} />
              </span>
              <span class="cell-num">
                <Amount minor={row.feesMinor} />
              </span>
              <span class="cell-amount">
                <Amount
                  minor={row.netMinor}
                  currency={row.transfer.currency as string}
                />
              </span>
            </summary>

            {row.fees.length > 0 && (
              <div
                style="padding:.5rem .875rem .875rem 1.5rem; background: var(--color-surface-1); border-bottom:1px solid var(--color-line)"
              >
                <div class="stat-label" style="margin-bottom:.375rem">
                  {fo.settlements.breakdown}
                </div>
                {row.fees.map((fee) => (
                  <div
                    style="display:grid; grid-template-columns: 12rem 8rem 5rem; gap:.875rem; padding:.1875rem 0; font-size: var(--text-xs)"
                  >
                    <span style="color: var(--color-ink-muted)">
                      {feeLabels[fee.type] ?? fee.type}
                    </span>
                    <span class="cell-num">
                      <Amount decimal={fee.total} />
                    </span>
                    <span class="cell-num" style="color: var(--color-ink-faint)">
                      {row.grossMinor > 0
                        ? `${((Math.abs(decimalToMinor(fee.total)) / row.grossMinor) * 100).toFixed(2).replace(".", ",")} %`
                        : ""}
                    </span>
                  </div>
                ))}
                <div
                  style="display:grid; grid-template-columns: 12rem 8rem 5rem; gap:.875rem; padding:.375rem 0 0; margin-top:.25rem; border-top:1px solid var(--color-line); font-size: var(--text-xs)"
                >
                  <span style="color: var(--color-ink-secondary)">
                    {fo.settlements.fees}
                  </span>
                  <span class="cell-num" style="color: var(--color-ink)">
                    <Amount decimal={row.totalFees} />
                  </span>
                  <span />
                </div>
              </div>
            )}
          </details>
        ))}
      </div>
    )
  }
</AppLayout>
