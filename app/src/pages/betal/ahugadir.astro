---
import AppLayout from "~/layouts/AppLayout.astro";
import StatusBadge from "~/components/ui/StatusBadge.astro";
import { fo } from "~/content/fo";
import { navFor, formatDateTime } from "~/lib/nav";
import { listLeads, type LeadState } from "~/lib/ops";
import type { StatusDescriptor } from "~/lib/status";

export const prerender = false;

const actor = Astro.locals.actor!;
if (actor.kind !== "staff") return Astro.redirect("/");

const db = Astro.locals.runtime.env.DB;
const state = (Astro.url.searchParams.get("stoda") ?? undefined) as
  | LeadState
  | undefined;

const leads = await listLeads(db, state);
const nav = navFor(actor);

const leadStatus: Record<string, StatusDescriptor> = {
  new: { tone: "processing", label: "Nýggjur" },
  contacted: { tone: "pending", label: "Samband tikið" },
  qualified: { tone: "pending", label: "Áhugaverdur" },
  won: { tone: "success", label: "Vunnin" },
  lost: { tone: "voided", label: "Mistur" },
};

const productLabels: Record<string, string> = {
  alnetinum: "Á alnetinum",
  stadnum: "Á staðnum",
  hald: "Hald",
  lon: "Løn",
};
---

<AppLayout
  title={fo.nav.leads}
  crumbs={[{ label: "Betal" }, { label: fo.nav.leads }]}
  nav={nav}
  context="Betal"
>
  <div
    style="display:flex; gap:.375rem; padding:.5rem .875rem; border-bottom:1px solid var(--color-line)"
  >
    {
      [
        { label: fo.common.all, value: null },
        { label: "Nýggir", value: "new" },
        { label: "Samband tikið", value: "contacted" },
        { label: "Vunnir", value: "won" },
      ].map((option) => (
        <a
          class="btn"
          href={option.value ? `?stoda=${option.value}` : "/betal/ahugadir"}
          style={
            (state ?? null) === option.value
              ? "background: var(--color-surface-3)"
              : undefined
          }
        >
          {option.label}
        </a>
      ))
    }
  </div>

  {
    leads.length === 0 ? (
      <p style="padding:2rem .875rem; color: var(--color-ink-muted)">
        {fo.common.noResults}
      </p>
    ) : (
      leads.map((lead: any) => (
        <div class="list-row" style="align-items:flex-start; min-height:2.5rem">
          <StatusBadge status={leadStatus[lead.state] ?? leadStatus.new!} iconOnly />
          <span style="flex:1; min-width:0">
            <span class="list-row-primary">
              {lead.company || lead.name}
            </span>
            {lead.message && (
              <div
                class="truncate-cell"
                style="font-size: var(--text-xs); color: var(--color-ink-muted); max-width:38rem"
              >
                {lead.message}
              </div>
            )}
          </span>
          <span class="list-row-meta">
            {lead.product && <span>{productLabels[lead.product] ?? lead.product}</span>}
            <a href={`mailto:${lead.email}`} style="color:inherit">
              {lead.email}
            </a>
            <span>{formatDateTime(lead.created_at_ms)}</span>
          </span>
        </div>
      ))
    )
  }

  <div class="list-footer">{leads.length} {fo.nav.leads.toLowerCase()}</div>
</AppLayout>
