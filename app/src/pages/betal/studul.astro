---
import AppLayout from "~/layouts/AppLayout.astro";
import StatusBadge from "~/components/ui/StatusBadge.astro";
import { fo } from "~/content/fo";
import { navFor, formatDateTime } from "~/lib/nav";
import type { StatusDescriptor } from "~/lib/status";

export const prerender = false;

const actor = Astro.locals.actor!;
if (actor.kind !== "staff") return Astro.redirect("/");

const db = Astro.locals.runtime.env.DB;

const tickets = await db
  .prepare(
    `SELECT t.*, m.name AS merchant_name,
            (SELECT COUNT(*) FROM ticket_message tm WHERE tm.ticket_id = t.id)
              AS message_count
       FROM ticket t
       LEFT JOIN merchant m ON m.id = t.merchant_id
      WHERE t.state != 'resolved'
      ORDER BY t.updated_at_ms DESC
      LIMIT 100`,
  )
  .all<Record<string, any>>();

const nav = navFor(actor);

const ticketStatus: Record<string, StatusDescriptor> = {
  open: { tone: "processing", label: "Opin" },
  waiting: { tone: "pending", label: "Bíðar eftir kunda" },
  resolved: { tone: "success", label: "Loyst" },
};
---

<AppLayout
  title={fo.nav.support}
  crumbs={[{ label: "Betal" }, { label: fo.nav.support }]}
  nav={nav}
  context="Betal"
>
  {
    tickets.results.length === 0 ? (
      <p style="padding:2rem .875rem; color: var(--color-ink-muted)">
        Ongar opnar mál.
      </p>
    ) : (
      tickets.results.map((ticket) => (
        <div class="list-row">
          <StatusBadge status={ticketStatus[ticket.state] ?? ticketStatus.open!} iconOnly />
          <span class="list-row-primary">{ticket.subject}</span>
          <span class="list-row-meta">
            {ticket.merchant_name && <span>{ticket.merchant_name}</span>}
            {/* Most support questions are about one payment, so the ticket links
                straight to it. */}
            {ticket.transaction_id && (
              <a
                href={`/gjaldingar/${ticket.transaction_id}`}
                style="color:inherit; font-family: var(--font-mono); font-size: var(--text-2xs)"
              >
                {ticket.transaction_id}
              </a>
            )}
            <span class="tnum">{ticket.message_count}</span>
            <span>{formatDateTime(ticket.updated_at_ms)}</span>
          </span>
        </div>
      ))
    )
  }

  <div class="list-footer">{tickets.results.length} opin mál</div>
</AppLayout>
