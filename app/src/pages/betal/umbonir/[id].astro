---
import AppLayout from "~/layouts/AppLayout.astro";
import Banner from "~/components/ui/Banner.astro";
import Field from "~/components/ui/Field.astro";
import Settings from "~/components/ui/Settings.astro";
import StatusBadge from "~/components/ui/StatusBadge.astro";
import { env } from "~/lib/env";
import { fo } from "~/content/fo";
import { navFor, formatDateTime } from "~/lib/nav";
import { loadPack } from "~/lib/onboarding/application";
import { missingDocKinds } from "~/lib/onboarding/steps";
import { wizardPath } from "~/lib/onboarding/access";
import {
  acquirerStatus,
  applicationStatus,
  financeStatus,
  sectorStatus,
} from "~/lib/status";
import { parseEygaSnapshot } from "~/lib/onboarding/eyga";

export const prerender = false;

const actor = Astro.locals.actor!;
if (actor.kind !== "staff") return Astro.redirect("/");

const id = Astro.params.id!;
const pack = await loadPack(env.DB, id);
if (!pack) return Astro.redirect("/betal/umbonir");

const app = pack.application;
const nav = navFor(actor);
const missing = missingDocKinds(pack);
const error = Astro.url.searchParams.get("feilur");
const wizard = wizardPath(id, "felag", actor, app.merchant_id);
const registry = parseEygaSnapshot(app.registry_snapshot);
const merchant = await env.DB
  .prepare(`SELECT name FROM merchant WHERE id = ?1`)
  .bind(app.merchant_id)
  .first<{ name: string }>();
---

<AppLayout
  title={merchant?.name ?? fo.nav.applications}
  crumbs={[
    { label: "Betal" },
    { label: fo.nav.applications, href: "/betal/umbonir" },
    { label: merchant?.name ?? "Umsókn" },
  ]}
  nav={nav}
  context="Betal"
>
  <a slot="actions" class="btn" href={wizard}>
    Síggj umsókn
  </a>

  {
    error && (
      <Fragment slot="banner">
        <Banner tone="failed" title={error} />
      </Fragment>
    )
  }

  <div class="page-header">
    <div>
      <div class="stat-label">Støða</div>
      <div class="stat-value" style="font-size:1.125rem">
        <StatusBadge status={applicationStatus(app.state)} variant="pill" />
      </div>
    </div>
    <div>
      <div class="stat-label">Tilmæltur innloysari</div>
      <div class="stat-value" style="font-size:1.125rem">
        {acquirerStatus(app.recommended_acquirer).label}
      </div>
      <div class="stat-sub">{app.screening_reason ?? "Skoðan ikki koyrd enn"}</div>
    </div>
    <div>
      <div class="stat-label">Skjøl ið vantar</div>
      <div class="stat-value tnum">{missing.length}</div>
    </div>
  </div>

  <div style="padding:1.25rem .875rem; max-width:44rem">
    <Settings title="Skoðan" description="Sama regla hvørja ferð. Starvsfólk kunnu skriva yvir, men tað verður skrásett.">
      <div style="padding:.875rem; display:flex; flex-wrap:wrap; gap:.5rem">
        {app.vertical_sector != null && (
          <StatusBadge status={sectorStatus(app.vertical_sector)} variant="pill" />
        )}
        {app.equity && <StatusBadge status={financeStatus(app.equity)} variant="pill" />}
        {app.operations && <StatusBadge status={financeStatus(app.operations)} variant="pill" />}
        {(app.chosen_acquirer || app.recommended_acquirer) && (
          <StatusBadge
            status={acquirerStatus(app.chosen_acquirer ?? app.recommended_acquirer)}
            variant="pill"
          />
        )}
        {!app.equity && !app.operations && app.vertical_sector == null && (
          <span class="field-hint">Skoðan ikki koyrd — vinnugrein og roknskapur vantar</span>
        )}
      </div>
    </Settings>

    <Settings title="Felag">
      <div style="padding:.875rem; display:grid; gap:.35rem; font-size: var(--text-sm)">
        <div>
          {app.legal_name}
          {app.company_type ? ` · ${app.company_type}` : ""}
          · V-tal <span class="tnum">{app.v_tal ?? "—"}</span>
        </div>
        <div style="color: var(--color-ink-muted)">
          {app.address_line_one}, {app.postal_code} {app.city}
        </div>
        <div style="color: var(--color-ink-muted)">{app.sells}</div>
        {registry && (
          <div style="margin-top:.5rem; display:flex; gap:.5rem; align-items:center">
            <span class="source-badge">eyga.fo</span>
            <a href={registry.sourceUrl} target="_blank" rel="noreferrer">
              Skrásetingarnr. <span class="tnum">{registry.registryNumber}</span> ↗
            </a>
          </div>
        )}
      </div>
    </Settings>

    {registry && (
      <Settings
        title="Alment eigarayvirlit"
        description="Snapshot frá Eyga, tá ið handilin váttaði felagið."
      >
        <div style="padding:0 .875rem .875rem">
          {(registry.beneficialOwners.length > 0
            ? registry.beneficialOwners
            : registry.owners).map((owner) => (
            <div class="registry-person">
              <span>
                <strong>{owner.name}</strong>
                {owner.description && <small>{owner.description}</small>}
              </span>
              {owner.ownershipBps != null && (
                <span class="tnum">{(owner.ownershipBps / 100).toLocaleString("fo-FO")} %</span>
              )}
            </div>
          ))}
        </div>
      </Settings>
    )}

    <Settings title="Eigarar">
      {pack.owners.length === 0 ? (
        <div class="empty">Ongir eigarar skrásettir</div>
      ) : (
        pack.owners.map((owner) => (
          <div class="settings-row">
            <div>
              <div class="settings-row-title">{owner.name}</div>
              <div class="settings-row-description tnum">
                {owner.email ?? "Eingin teldupostur"}
                {owner.is_signatory ? " · undirskrivari · P-tal frá Samleikanum" : ""}
              </div>
            </div>
          </div>
        ))
      )}
    </Settings>

    <Settings title="Skjøl">
      {pack.documents.length === 0 ? (
        <div class="empty">Einki lagt upp</div>
      ) : (
        pack.documents.map((doc) => (
          <div class="settings-row">
            <div>
              <div class="settings-row-title">{doc.kind}</div>
              <div class="settings-row-description">{doc.file_name} · <span class="tnum">{doc.byte_size}</span> B</div>
            </div>
            <div class="settings-row-control">
              <a class="btn" href={`/api/betal/umbonir/${id}/skjol/${doc.id}`}>Opna</a>
            </div>
          </div>
        ))
      )}
    </Settings>

    <Settings title="Hendingar">
      <div class="timeline" style="padding: .875rem">
        {pack.events.map((event) => (
          <div class="timeline-item">
            <span class="timeline-label">
              {fo.onboarding.events[event.kind as keyof typeof fo.onboarding.events] ?? event.kind}
              {event.actor_email ? ` · ${event.actor_email}` : ""}
            </span>
            <span class="timeline-meta tnum">{formatDateTime(event.at_ms)}</span>
          </div>
        ))}
      </div>
    </Settings>

    <Settings title="Gerðir" description="Innloysarin verður settur í ePay av einum menniskja. Hetta er okkara pakki.">
      <form method="POST" action={`/api/betal/umbonir/${id}`} style="padding:.875rem; display:grid; gap:.75rem">
        <input type="hidden" name="action" id="staff-action" value="submit" />
        <Field label="Innloysari" name="acquirer" value={app.chosen_acquirer ?? app.recommended_acquirer ?? "swedbank"} />
        <Field label="Uttanveltar tilvísing" name="external_ref" />
        <Field label="Viðmerking" name="reason" type="textarea" />
        <div style="display:flex; flex-wrap:wrap; gap:.5rem">
          <button
            class="btn btn-primary"
            type="submit"
            disabled={app.state !== "pack_ready"}
            title={app.state !== "pack_ready" ? "Pakkin er ikki klárur" : undefined}
            onclick="document.getElementById('staff-action').value='submit'"
          >
            Merk sent
          </button>
          <button class="btn" type="submit" onclick="document.getElementById('staff-action').value='reroute'">
            Flyt innloysara
          </button>
          <button class="btn" type="submit" onclick="document.getElementById('staff-action').value='request_docs'">
            Bið um skjøl
          </button>
          <button class="btn btn-danger" type="submit" onclick="document.getElementById('staff-action').value='reject'">
            Avvís
          </button>
        </div>
      </form>
      <form method="POST" action={`/api/betal/umbonir/${id}`} style="padding:0 .875rem .875rem; display:flex; gap:.5rem; align-items:end">
        <input type="hidden" name="action" value="sector" />
        <Field label="Set geiri við hond" name="sector" value={String(app.vertical_sector ?? 0)} />
        <button class="btn" type="submit">Goym geiri</button>
      </form>
    </Settings>
  </div>
</AppLayout>
