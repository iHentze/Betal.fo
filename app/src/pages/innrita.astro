---
import "~/styles/app.css";
import { fo } from "~/content/fo";

export const prerender = false;

const sent = Astro.url.searchParams.get("sent") === "1";
const next = Astro.url.searchParams.get("next") ?? "/";
---

<!doctype html>
<html lang="fo">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Innrita · {fo.brand}</title>
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <main
      style="display:grid; place-items:center; min-height:100dvh; padding:1rem"
    >
      <div style="width:min(22rem, 100%)">
        <div class="brand" style="font-size:1.5rem; margin-bottom:1.5rem">
          {fo.brand}
        </div>

        {
          sent ? (
            <div>
              <h1 style="font-size: var(--text-base); margin-bottom:.5rem">
                Vit hava sent tær ein teldupost
              </h1>
              <p style="font-size: var(--text-sm); color: var(--color-ink-muted)">
                Trýst á leinkjuna í teldupostinum fyri at innrita. Leinkjan riggar í 15
                minuttir.
              </p>
            </div>
          ) : (
            <form method="POST" action="/api/auth/leinki">
              <h1 style="font-size: var(--text-base); margin-bottom:.75rem">
                Innrita
              </h1>
              <input type="hidden" name="next" value={next} />
              <label
                for="email"
                style="display:block; font-size: var(--text-xs); color: var(--color-ink-muted); margin-bottom:.25rem"
              >
                Teldupostur
              </label>
              <input
                id="email"
                class="input"
                type="email"
                name="email"
                required
                autocomplete="email"
                autofocus
              />
              <button class="btn btn-primary" type="submit" style="margin-top:.75rem; width:100%">
                Send innritingarleinki
              </button>
            </form>
          )
        }
      </div>
    </main>
  </body>
</html>
