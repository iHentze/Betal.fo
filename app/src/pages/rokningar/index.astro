---
import AppLayout from "~/layouts/AppLayout.astro";
import Amount from "~/components/ui/Amount.astro";
import StatusBadge from "~/components/ui/StatusBadge.astro";
import { env } from "~/lib/env";
import { fo } from "~/content/fo";
import { navFor, formatDate } from "~/lib/nav";
import { merchantScopeOrNull } from "~/lib/auth";
import { invoiceStatus } from "~/lib/status";

export const prerender = false;

const actor = Astro.locals.actor!;
const db = env.DB;
const merchantId = merchantScopeOrNull(actor, Astro.url.searchParams.get("handil"));
// Staff reach these screens from their own sidebar before choosing a merchant,
// which is a navigation state rather than an error.
if (!merchantId) return Astro.redirect("/betal/handlar");

const invoices = await db
  .prepare(
    `SELECT id, number, kind, state, currency, net_minor, vat_minor, gross_minor,
            issued_at, due_at, paid_at
       FROM invoice
      WHERE merchant_id = ?1 AND number IS NOT NULL
      ORDER BY issued_at DESC
      LIMIT 100`,
  )
  .bind(merchantId)
  .all<Record<string, any>>();

const outstanding = invoices.results
  .filter((i) => i.state === "issued" || i.state === "overdue")
  .reduce((sum, i) => sum + Number(i.gross_minor), 0);

const paid = invoices.results
  .filter((i) => i.state === "paid")
  .reduce((sum, i) => sum + Number(i.gross_minor), 0);

const COLUMNS = "0.6rem 9rem minmax(0, 1fr) 7rem 7rem 8rem 9rem";
const nav = navFor(actor, merchantId);
---

<AppLayout
  title={fo.invoices.title}
  crumbs={[{ label: fo.invoices.title }]}
  nav={nav}
  context={actor.kind === "staff" ? "Betal" : ""}
>
  <div class="page-header">
    <div>
      <div class="stat-label">Ógoldið</div>
      <div class="stat-value"><Amount minor={outstanding} currency="DKK" /></div>
      <div class="stat-sub">{invoices.results.length} rokningar</div>
    </div>
    <div>
      <div class="stat-label">Goldið</div>
      <div class="stat-value" style="font-size:1.125rem">
        <Amount minor={paid} />
      </div>
    </div>
  </div>

  {
    invoices.results.length === 0 ? (
      <div class="empty">
        <div class="empty-title">{fo.common.noResults}</div>
        Rokningar koma, tá fyrsta tíðarskeiðið er avstemt.
      </div>
    ) : (
      <div class="table" style={`--cols: ${COLUMNS}`}>
        <div class="group-header">
          <span />
          <span class="group-title">{fo.invoices.number}</span>
          <span class="group-count">{fo.common.status}</span>
          <span class="group-count">{fo.invoices.issued}</span>
          <span class="group-count">{fo.invoices.due}</span>
          <span class="group-count cell-num">{fo.invoices.net}</span>
          <span class="group-count cell-num">{fo.invoices.gross}</span>
        </div>

        {invoices.results.map((invoice) => (
          <a class="trow" href={`/rokningar/${invoice.id}`}>
            <StatusBadge status={invoiceStatus(invoice.state)} iconOnly />
            <span class="cell-primary tnum">{invoice.number}</span>
            <span class="cell-quiet">
              {invoice.kind === "credit_note"
                ? fo.invoices.creditNote
                : invoiceStatus(invoice.state).label}
            </span>
            <span class="cell-quiet">{formatDate(invoice.issued_at)}</span>
            <span class="cell-quiet">{formatDate(invoice.due_at)}</span>
            <span class="cell-num" style="color: var(--color-ink-secondary)">
              <Amount minor={invoice.net_minor} />
            </span>
            <span class="cell-amount">
              <Amount minor={invoice.gross_minor} currency={invoice.currency} />
            </span>
          </a>
        ))}
      </div>
    )
  }
</AppLayout>
