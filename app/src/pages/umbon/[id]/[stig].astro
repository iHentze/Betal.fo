---
import WizardLayout from "~/components/ui/WizardLayout.astro";
import Field from "~/components/ui/Field.astro";
import ChoiceCard from "~/components/ui/ChoiceCard.astro";
import Dropzone from "~/components/ui/Dropzone.astro";
import { env } from "~/lib/env";
import { fo } from "~/content/fo";
import { requirePack, wizardPath, handilQuery } from "~/lib/onboarding/access";
import { answerValue, getActivePriceList } from "~/lib/onboarding/application";
import { canFillAgreement, canSendToSkriva } from "~/lib/onboarding/pdf";
import { priceListKind, screenApplication } from "~/lib/onboarding/screening";
import { skrivaConfigured } from "~/lib/onboarding/skriva";
import {
  STEP_SLUGS,
  hasDocument,
  isStepComplete,
  isStepSlug,
  stepLabel,
  stepWhy,
  type StepSlug,
} from "~/lib/onboarding/steps";
import { VERTICALS } from "~/lib/onboarding/verticals";
import { formatDateTime } from "~/lib/nav";
import {
  getEygaCompany,
  parseEygaSnapshot,
  searchEygaCompanies,
  type EygaCompany,
  type EygaSearchResult,
} from "~/lib/onboarding/eyga";
import type { SalesRegions } from "~/lib/onboarding/questionnaire";

export const prerender = false;

const actor = Astro.locals.actor!;
const id = Astro.params.id!;
const stig = Astro.params.stig ?? "";

if (!isStepSlug(stig)) return Astro.redirect("/umbon");

let pack;
try {
  pack = await requirePack(env.DB, actor, id, Astro.url.searchParams.get("handil"));
} catch {
  return Astro.redirect("/umbon");
}

const merchantId = pack.application.merchant_id;
const q = handilQuery(actor, merchantId);
const href = (slug: string) => wizardPath(id, slug, actor, merchantId);

const currentIndex = STEP_SLUGS.indexOf(stig);
const steps = STEP_SLUGS.map((slug) => ({
  slug,
  label: stepLabel(slug),
  href: href(slug),
  state: (slug === stig
    ? "current"
    : isStepComplete(slug as StepSlug, pack)
      ? "done"
      : "todo") as "todo" | "current" | "done",
}));

const error = Astro.url.searchParams.get("feilur");
const bankEmailSent = Astro.url.searchParams.get("sent") === "banki";
const app = pack.application;
const formAction = `/api/umbon/${id}${q}`;
const autosaveAction = ["felag", "vinnugrein", "eigarar", "roknskapur", "banki", "skjol"]
  .includes(stig)
  ? `/api/umbon/${id}/autosave${q}`
  : undefined;
const uploadAction = `/api/umbon/${id}/skjol${q}`;
const backHref = currentIndex > 0 ? href(STEP_SLUGS[currentIndex - 1]!) : `/${q}`;
const savedLabel = fo.onboarding.saved;

const registrySnapshot = parseEygaSnapshot(app.registry_snapshot);
const eygaQuery = (Astro.url.searchParams.get("eyga_q") ?? "").trim();
const choosingCompany = Astro.url.searchParams.has("eyga_q");
const requestedEygaId = Astro.url.searchParams.get("eyga");
const manualCompany = Astro.url.searchParams.get("manual") === "1";
let selectedCompany: EygaCompany | null = choosingCompany || requestedEygaId || manualCompany
  ? null
  : registrySnapshot;
let eygaResults: EygaSearchResult[] = [];
let eygaError: string | null = null;

if (stig === "felag" && requestedEygaId) {
  try {
    selectedCompany = await getEygaCompany(env, requestedEygaId);
  } catch {
    eygaError = "Vit fingu ikki lisið felagið frá Eyga. Royn aftur ella skriva upplýsingarnar sjálv/ur.";
  }
} else if (stig === "felag" && choosingCompany && eygaQuery) {
  try {
    eygaResults = await searchEygaCompanies(env, eygaQuery);
  } catch {
    eygaError = "Eyga svarar ikki beint nú. Tú kanst royna aftur ella skriva upplýsingarnar sjálv/ur.";
  }
}

function felagUrl(params: Record<string, string>): string {
  const target = new URL(href("felag"), Astro.url);
  for (const [key, value] of Object.entries(params)) target.searchParams.set(key, value);
  return `${target.pathname}${target.search}`;
}

const screening = screenApplication({
  sector: app.vertical_sector,
  equity: app.equity as "positive" | "negative" | "unknown" | null,
  operations: app.operations as "positive" | "negative" | "unknown" | null,
});
const priceList = await getActivePriceList(env.DB, priceListKind(screening));
const fill = canFillAgreement(pack);
const send = canSendToSkriva(pack, priceList, skrivaConfigured(env));
const swedbank = app.recommended_acquirer === "swedbank" || !app.recommended_acquirer;
const latestSkrivaRequestId = pack.signings.find(
  (row) => row.provider === "skriva" && row.signing_request_id,
)?.signing_request_id;
const skrivaRows = pack.signings.filter(
  (row) =>
    row.provider === "skriva" &&
    row.signing_request_id === latestSkrivaRequestId,
);
const skrivaSigned = skrivaRows.length > 0 &&
  skrivaRows.every((row) => row.status === "signed");
const skrivaPending = skrivaRows.filter(
  (row) => row.status === "sent" || row.status === "viewed",
);
const actorSigning = skrivaPending.find(
  (row) => pack.owners.some(
    (owner) =>
      owner.is_signatory &&
      owner.email?.toLowerCase() === actor.email.toLowerCase(),
  ),
) ?? skrivaPending[0];
const skrivaMessage = Astro.url.searchParams.get("sent");
const registryOwnerSuggestions = registrySnapshot
  ? (registrySnapshot.beneficialOwners.length > 0
      ? registrySnapshot.beneficialOwners
      : registrySnapshot.owners.filter((owner) => owner.kind === "person"))
  : [];
const owners = pack.owners.length > 0 ? pack.owners : registryOwnerSuggestions.length > 0
  ? registryOwnerSuggestions.map((owner, index) => ({
      id: "",
      application_id: id,
      name: owner.name,
      email: "",
      p_tal: "",
      role: owner.role ?? owner.description ?? "Eigari",
      ownership_bps: owner.ownershipBps,
      is_signatory: index === 0 ? 1 : 0,
      sort_order: index,
    }))
  : [
  {
    id: "",
    application_id: id,
    name: "",
    email: "",
    p_tal: "",
    role: "",
    ownership_bps: null,
    is_signatory: 1,
    sort_order: 0,
  },
];

const docChip = (kind: string) => pack.documents.find((d) => d.kind === kind && d.byte_size);

const hideContinue = stig === "bida";
const applicationLocked = Boolean(
  app.locked_at_ms &&
  app.state !== "collecting" &&
  app.state !== "more_info" &&
  stig !== "undirskriva" &&
  stig !== "bida",
);
const companyFormReady = manualCompany || Boolean(selectedCompany);
const selectedCompanyActive = selectedCompany?.status === "active";
const selectedCompanyComplete = Boolean(
  selectedCompany?.companyType &&
  selectedCompany.address &&
  selectedCompany.postalCode &&
  selectedCompany.city,
);
const pageFormAction = hideContinue || applicationLocked || stig === "undirskriva"
  || (stig === "felag" && !companyFormReady)
  || (stig === "felag" && Boolean(selectedCompany) && !selectedCompanyActive)
  || (stig === "felag" && Boolean(selectedCompany) && !selectedCompanyComplete)
  ? undefined
  : formAction;
const continueLabel = stig === "banki" && !app.bank_account
  ? "Ger bankaskjalið"
  : fo.onboarding.continue;
const bankEmailReady = Boolean(env.RESEND_API_KEY);
const selectedWallets = answerValue<string[]>(pack, "wallets") ?? [];
const salesRegions = answerValue<SalesRegions>(pack, "sales_regions") ?? {
  denmark: 0,
  nordics: 100,
  eu: 0,
  usa: 0,
  other: 0,
};
const answerBoolean = (key: string) => answerValue<boolean>(pack, key);
const binaryBusinessQuestions = [
  { key: "subscriptions", label: "Bjóða tit haldsgjøld?" },
  { key: "gift_cards", label: "Selja tit gávukort ella forskotsgjaldskort?" },
  { key: "donations", label: "Taka tit ímóti gávum uttan mótveiting?" },
  { key: "save_card", label: "Kunnu kundar goyma kortupplýsingar?" },
  {
    key: "other_mit",
    label: "Bjóða tit onnur endurtakandi gjøld við skiftandi upphædd?",
  },
  { key: "website_terms", label: "Eru handilstreytir á heimasíðuni?" },
  { key: "made_to_order", label: "Selja tit bílagdar vørur?" },
] as const;
let latestBankEmail: {
  status: string;
  bank_email: string;
  sent_at_ms: number;
} | null = null;
if (stig === "banki") {
  latestBankEmail = await env.DB
    .prepare(
      `SELECT status, bank_email, sent_at_ms
       FROM onboarding_bank_email
       WHERE application_id = ?1
       ORDER BY sent_at_ms DESC LIMIT 1`,
    )
    .bind(id)
    .first();
}
let clientEmail = actor.email;
if (stig === "banki" && actor.kind === "staff") {
  const contact = await env.DB
    .prepare(
      `SELECT email FROM app_user
       WHERE kind = 'merchant' AND merchant_id = ?1
       ORDER BY CASE role WHEN 'owner' THEN 0 ELSE 1 END, created_at
       LIMIT 1`,
    )
    .bind(merchantId)
    .first<{ email: string }>();
  clientEmail = contact?.email ?? "";
}
---

<WizardLayout
  title={stepLabel(stig)}
  why={stepWhy(stig)}
  steps={steps}
  currentIndex={currentIndex}
  savedLabel={savedLabel}
  backHref={backHref}
  formAction={pageFormAction}
  autosaveAction={autosaveAction}
  continueLabel={continueLabel}
  hideContinue={hideContinue}
>
  {
    error && (
      <div class="wizard-alert is-error">{error}</div>
    )
  }
  {
    applicationLocked && (
      <div class="wizard-alert">
        Umsóknin er læst, meðan hon verður undirskrivað ella viðgjørd.
      </div>
    )
  }

  {
    stig === "felag" && (
      <>
        {eygaError && <div class="wizard-alert is-error">{eygaError}</div>}

        {!selectedCompany && !manualCompany && (
          <>
            <section class="wizard-panel">
              <div class="wizard-panel-heading">
                <div>
                  <h2>Finn felagið</h2>
                  <p>Vit fylla navn, felagsslag, adressu og eigarar úr almennu skránni.</p>
                </div>
                <span class="source-badge">eyga.fo</span>
              </div>
              <form
                class="registry-search"
                action={new URL(href("felag"), Astro.url).pathname}
                method="GET"
                role="search"
              >
                {actor.kind === "staff" && <input type="hidden" name="handil" value={merchantId} />}
                <label class="field-label" for="eyga-search">{fo.onboarding.eygaSearch}</label>
                <div class="registry-search-control">
                  <input
                    class="input field-input"
                    id="eyga-search"
                    name="eyga_q"
                    type="search"
                    value={eygaQuery}
                    placeholder="t.d. Føroya Banki ella 10"
                    autocomplete="off"
                    data-result-base={felagUrl({ eyga: "__ID__" })}
                  />
                  <button class="btn" type="submit">Leita</button>
                </div>
              </form>

              <div class="registry-results" id="eyga-results" aria-live="polite">
                {eygaResults.map((result) => (
                  <a class="registry-result" href={felagUrl({ eyga: result.id })}>
                    <span class="registry-avatar" aria-hidden="true">
                      {result.companyType}
                    </span>
                    <span class="registry-result-copy">
                      <strong>{result.name}</strong>
                      <span>{result.location} · skrásetingarnr. {result.registryNumber}</span>
                    </span>
                    <span class:list={["registry-status", result.status !== "virkid" && "is-warning"]}>
                      {result.statusLabel}
                    </span>
                    <span class="registry-chevron" aria-hidden="true">›</span>
                  </a>
                ))}
                {eygaQuery && eygaResults.length === 0 && !eygaError && (
                  <p class="registry-empty">Einki felag funnið. Kanna stavsetingina ella skrásetingarnummarið.</p>
                )}
              </div>
            </section>

            <p class="wizard-under-panel">
              Nýtt felag ella ikki í skránni? <a href={felagUrl({ manual: "1" })}>Skriva upplýsingarnar sjálv/ur</a>
            </p>
          </>
        )}

        {selectedCompany && !manualCompany && (
          <>
            <section class="wizard-panel registry-company">
              <div class="wizard-panel-heading">
                <div>
                  <span class="source-badge">eyga.fo</span>
                  <h2>{selectedCompany.name}</h2>
                </div>
                <span class:list={["registry-status", !selectedCompanyActive && "is-warning"]}>
                  {selectedCompany.statusLabel}
                </span>
              </div>

              <dl class="registry-facts">
                <div>
                  <dt>Felagsslag</dt>
                  <dd>{selectedCompany.companyType}</dd>
                </div>
                <div>
                  <dt>Skrásetingarnr.</dt>
                  <dd class="tnum">{selectedCompany.registryNumber}</dd>
                </div>
                <div>
                  <dt>Adressa</dt>
                  <dd>
                    {selectedCompany.address || "Eingin gøta skrásett"}<br />
                    <span class="tnum">{selectedCompany.postalCode}</span> {selectedCompany.city}
                  </dd>
                </div>
              </dl>

              {selectedCompany.purpose && (
                <div class="registry-signing-rules">
                  <strong>Endamál</strong>
                  <span>{selectedCompany.purpose}</span>
                </div>
              )}

              {selectedCompany.owners.length > 0 && (
                <div class="registry-people-preview">
                  <div class="registry-people-title">
                    <span>Eigarar á Eyga</span>
                    <span class="tnum">{selectedCompany.owners.length}</span>
                  </div>
                  {selectedCompany.owners.slice(0, 4).map((owner) => (
                    <div class="registry-person">
                      <span>
                        <strong>{owner.name}</strong>
                        {owner.description && <small>{owner.description}</small>}
                      </span>
                      {owner.ownershipBps != null && (
                        <span class="tnum">{(owner.ownershipBps / 100).toLocaleString("fo-FO")} %</span>
                      )}
                    </div>
                  ))}
                </div>
              )}

              <div class="registry-source-line">
                {selectedCompany.updatedAt ? `Dagført ${selectedCompany.updatedAt}` : fo.onboarding.eygaSource}
                <a href={selectedCompany.sourceUrl} target="_blank" rel="noreferrer">Síggj á Eyga ↗</a>
              </div>
            </section>

            {!selectedCompanyActive && (
              <div class="wizard-alert is-error">
                Felagið stendur ikki sum virkið. Vel eitt annað felag ella skriva til okkara.
              </div>
            )}

            {selectedCompanyActive && !selectedCompanyComplete && (
              <div class="wizard-alert">
                Eyga manglar eina fulla adressu fyri felagið. Kanna felagið ella
                <a href={felagUrl({ manual: "1" })}> skriva upplýsingarnar sjálv/ur</a>.
              </div>
            )}

            {selectedCompanyActive && selectedCompanyComplete && (
              <form id="wizard-form" method="POST" action={formAction} class="wizard-stack">
                <input type="hidden" name="step" value="felag" />
                <input type="hidden" name="registry_id" value={selectedCompany.id} />
                <section class="wizard-panel">
                  <Field
                    label="V-tal"
                    name="v_tal"
                    value={app.v_tal}
                    required
                    inputmode="numeric"
                    autocomplete="organization"
                    hint="V-talið hjá TAKS — ikki tað sama sum skrásetingarnummarið á Eyga."
                  />
                  <Field
                    label="Ja, hetta er rætta felagið"
                    name="company_confirmed"
                    type="checkbox"
                    value="1"
                    checked={Boolean(app.company_details_confirmed && app.registry_id === selectedCompany.id)}
                    required
                  />
                </section>
              </form>
            )}

            <p class="wizard-under-panel">
              Ikki rætta felagið? <a href={felagUrl({ eyga_q: "" })}>Leita av nýggjum</a>
            </p>
          </>
        )}

        {manualCompany && (
          <>
            <div class="wizard-alert">
              Brúka hetta bert, um felagið er nýtt ella ikki finst á Eyga enn.
            </div>
            <form id="wizard-form" method="POST" action={formAction} class="wizard-stack">
              <input type="hidden" name="step" value="felag" />
              <section class="wizard-panel">
                <Field label="Lógligt navn" name="legal_name" value={app.legal_name} required autocomplete="organization" />
                <div class="field-row">
                  <Field label="Felagsslag" name="company_type" value={app.company_type} required placeholder="t.d. Sp/f" />
                  <Field label="V-tal" name="v_tal" value={app.v_tal} required inputmode="numeric" />
                </div>
                <Field label="Adressa" name="address_line_one" value={app.address_line_one} required autocomplete="street-address" />
                <Field label="Adressa 2" name="address_line_two" value={app.address_line_two} />
                <div class="field-row">
                  <Field label="Postnr." name="postal_code" value={app.postal_code} required inputmode="numeric" autocomplete="postal-code" />
                  <Field label="Býur" name="city" value={app.city} required autocomplete="address-level2" />
                </div>
                <Field
                  label="Eg vátti, at upplýsingarnar eru rættar"
                  name="company_confirmed"
                  type="checkbox"
                  value="1"
                  checked={Boolean(app.company_details_confirmed && app.registry_source === "manual")}
                  required
                />
              </section>
            </form>
            <p class="wizard-under-panel">
              <a href={felagUrl({ eyga_q: "" })}>← Leita á Eyga í staðin</a>
            </p>
          </>
        )}
      </>
    )
  }

  {
    (stig === "vinnugrein" || stig === "eigarar" || stig === "roknskapur") && (
      <form id="wizard-form" method="POST" action={formAction}>
        <input type="hidden" name="step" value={stig} />

        {stig === "vinnugrein" && (
          <div class="wizard-stack">
            <section class="wizard-panel">
              <Field
                label="Hvat selja tit?"
                name="sells"
                type="textarea"
                value={app.sells}
                required
                rows={3}
                placeholder="T.d. kaffi, køkur og matur í kaffistovu"
                hint="Ein greiður setningur er nokk."
              />
              <Field
                label="Heimasíða"
                name="website"
                type="url"
                value={app.website}
                placeholder="https://"
                autocomplete="url"
                required
              />
              <Field
                label="Navn á sølustaðnum"
                name="market_name"
                value={answerValue<string>(pack, "market_name") ?? app.legal_name}
                required
              />
              <div class="field-row">
                <Field
                  label="Kontaktpersónur"
                  name="contact_name"
                  value={answerValue<string>(pack, "contact_name") ?? actor.name}
                  required
                  autocomplete="name"
                />
                <Field
                  label="Telefon"
                  name="contact_phone"
                  type="tel"
                  value={answerValue<string>(pack, "contact_phone")}
                  required
                  autocomplete="tel"
                />
              </div>
              <div class="field-row">
                <Field
                  label="Teldupostur"
                  name="contact_email"
                  type="email"
                  value={answerValue<string>(pack, "contact_email") ?? actor.email}
                  required
                  autocomplete="email"
                />
                <Field
                  label="Teldupostur til fakturar"
                  name="invoice_email"
                  type="email"
                  value={answerValue<string>(pack, "invoice_email") ?? actor.email}
                  required
                  autocomplete="email"
                />
              </div>
            </section>
            <section>
              <h2 class="wizard-section-title">Hvør lýsing passar best?</h2>
              <div class="choice-grid" data-cols="2">
                {VERTICALS.map((vertical) => (
                  <div class="choice-grid-item" data-sector={vertical.sector}>
                    <ChoiceCard
                      name="vertical_key"
                      value={vertical.key}
                      title={vertical.label}
                      hint={vertical.hint}
                      checked={app.vertical_key === vertical.key}
                    />
                  </div>
                ))}
              </div>
              <div class="vertical-guidance" id="vertical-guidance" aria-live="polite">
                <div class="wizard-alert" data-routing="1" hidden={app.vertical_sector !== 1}>
                  <strong>Vit senda ikki hetta til Swedbank.</strong>
                  <span>{fo.onboarding.sector1}</span>
                </div>
                <div class="wizard-alert" data-routing="2" hidden={app.vertical_sector !== 2}>
                  <strong>Swedbank kann taka ímóti hesum.</strong>
                  <span>{fo.onboarding.sector2}</span>
                </div>
              </div>
            </section>

            <section class="wizard-panel">
              <h2 class="wizard-section-title">Væntað kortsøla</h2>
              <p class="wizard-section-copy">
                Tølini skulu vera ein realistisk meting fyri Visa og Mastercard.
              </p>
              <div class="field-row">
                <Field
                  label="Væntað kortsøla um árið (DKK)"
                  name="annual_card_turnover_dkk"
                  type="number"
                  value={answerValue<number>(pack, "annual_card_turnover_dkk")}
                  required
                  inputmode="decimal"
                />
                <Field
                  label="Miðal keypsupphædd (DKK)"
                  name="average_transaction_dkk"
                  type="number"
                  value={answerValue<number>(pack, "average_transaction_dkk")}
                  required
                  inputmode="decimal"
                />
              </div>
            </section>

            <section class="wizard-panel">
              <h2 class="wizard-section-title">Vørur og veiting</h2>
              <p class="field-label">Hvat slag av vørum selja tit?</p>
              <div class="choice-grid" data-cols="3">
                <ChoiceCard name="product_type" value="physical" title="Fysiskar vørur" checked={answerValue<string>(pack, "product_type") === "physical"} required />
                <ChoiceCard name="product_type" value="digital" title="Talgildar vørur" checked={answerValue<string>(pack, "product_type") === "digital"} required />
                <ChoiceCard name="product_type" value="both" title="Bæði" checked={answerValue<string>(pack, "product_type") === "both"} required />
              </div>

              <p class="field-label wizard-question">Hava tit vørurnar á goymslu?</p>
              <div class="choice-grid" data-cols="3">
                <ChoiceCard name="inventory" value="yes" title="Ja" checked={answerValue<string>(pack, "inventory") === "yes"} required />
                <ChoiceCard name="inventory" value="partial" title="Partvíst" checked={answerValue<string>(pack, "inventory") === "partial"} required />
                <ChoiceCard name="inventory" value="no" title="Nei" checked={answerValue<string>(pack, "inventory") === "no"} required />
              </div>

              <div class="field-row wizard-question">
                <Field
                  label="Hvussu verða vørur ella tænastur latnar?"
                  name="delivery_method"
                  value={answerValue<string>(pack, "delivery_method")}
                  placeholder="T.d. talgilt, postur ella heintan"
                  required
                />
                <Field
                  label="Dagar frá gjaldi til levering"
                  name="delivery_days"
                  type="number"
                  value={answerValue<number>(pack, "delivery_days")}
                  required
                  inputmode="numeric"
                />
              </div>
            </section>

            <section class="wizard-panel">
              <h2 class="wizard-section-title">Gjaldshættir og kundar</h2>
              <p class="field-label">Bjóða tit gjaldsleinki?</p>
              <div class="choice-grid" data-cols="2">
                <ChoiceCard name="payment_link_mode" value="none" title="Nei, vanlig netverslun" checked={answerValue<string>(pack, "payment_link_mode") === "none"} required />
                <ChoiceCard name="payment_link_mode" value="html" title="Ja, HTML-leinki" checked={answerValue<string>(pack, "payment_link_mode") === "html"} required />
                <ChoiceCard name="payment_link_mode" value="digital" title="Ja, SMS ella teldupostur" checked={answerValue<string>(pack, "payment_link_mode") === "digital"} required />
                <ChoiceCard name="payment_link_mode" value="physical" title="Ja, á fysiskum sølustaði" checked={answerValue<string>(pack, "payment_link_mode") === "physical"} required />
              </div>

              <p class="field-label wizard-question">Hvørjir eru høvuðskundarnir?</p>
              <div class="choice-grid" data-cols="3">
                <ChoiceCard name="primary_customers" value="consumers" title="Einstaklingar" checked={answerValue<string>(pack, "primary_customers") === "consumers"} required />
                <ChoiceCard name="primary_customers" value="businesses" title="Fyritøkur" checked={answerValue<string>(pack, "primary_customers") === "businesses"} required />
                <ChoiceCard name="primary_customers" value="both" title="Bæði" checked={answerValue<string>(pack, "primary_customers") === "both"} required />
              </div>

              {binaryBusinessQuestions.map(({ key, label }) => (
                <div class="binary-question">
                  <span class="field-label">{label}</span>
                  <div class="choice-grid" data-cols="2">
                    <ChoiceCard name={key} value="no" title="Nei" checked={answerBoolean(key) === false} required />
                    <ChoiceCard name={key} value="yes" title="Ja" checked={answerBoolean(key) === true} required />
                  </div>
                </div>
              ))}

              <div id="save-card-details" hidden={!answerBoolean("save_card")}>
                <p class="field-label wizard-question">Verða kortupplýsingarnar goymdar í eini app?</p>
                <div class="choice-grid" data-cols="2">
                  <ChoiceCard name="save_card_in_app" value="no" title="Nei" checked={answerBoolean("save_card_in_app") === false} />
                  <ChoiceCard name="save_card_in_app" value="yes" title="Ja" checked={answerBoolean("save_card_in_app") === true} />
                </div>
              </div>

              <div id="donation-details" hidden={!answerBoolean("donations")}>
                <p class="field-label wizard-question">
                  Er innsavningin undir almennum ella góðkendum eftirliti?
                </p>
                <div class="choice-grid" data-cols="2">
                  <ChoiceCard name="donations_supervised" value="no" title="Nei" checked={answerBoolean("donations_supervised") === false} />
                  <ChoiceCard name="donations_supervised" value="yes" title="Ja" checked={answerBoolean("donations_supervised") === true} />
                </div>
              </div>

              <div id="made-to-order-details" hidden={!answerBoolean("made_to_order")}>
                <div class="field-row wizard-question">
                  <Field
                    label="Vanlig leveringartíð (dagar)"
                    name="made_to_order_days"
                    type="number"
                    value={answerValue<number>(pack, "made_to_order_days")}
                    inputmode="numeric"
                  />
                  <Field
                    label="Partur av kortsøluni (%)"
                    name="made_to_order_share_percent"
                    type="number"
                    value={answerValue<number>(pack, "made_to_order_share_percent")}
                    inputmode="decimal"
                  />
                </div>
                <p class="field-label wizard-question">Rinda kundar depositum?</p>
                <div class="choice-grid" data-cols="2">
                  <ChoiceCard name="deposit" value="no" title="Nei" checked={answerBoolean("deposit") === false} />
                  <ChoiceCard name="deposit" value="yes" title="Ja" checked={answerBoolean("deposit") === true} />
                </div>
                <div id="deposit-details" hidden={!answerBoolean("deposit")}>
                  <Field
                    label="Depositum (%)"
                    name="deposit_share_percent"
                    type="number"
                    value={answerValue<number>(pack, "deposit_share_percent")}
                    inputmode="decimal"
                  />
                </div>
                <div class="field-row wizard-question">
                  <Field
                    label="Nær verður restin goldin?"
                    name="final_payment_when"
                    value={answerValue<string>(pack, "final_payment_when")}
                  />
                  <Field
                    label="Hvussu verður restin goldin?"
                    name="final_payment_method"
                    value={answerValue<string>(pack, "final_payment_method")}
                  />
                </div>
              </div>

              <p class="field-label wizard-question">Talgildar pungar</p>
              <div class="choice-grid" data-cols="3">
                <ChoiceCard name="wallets" value="mobilepay" title="MobilePay" type="checkbox" checked={selectedWallets.includes("mobilepay")} />
                <ChoiceCard name="wallets" value="applepay" title="Apple Pay" type="checkbox" checked={selectedWallets.includes("applepay")} />
                <ChoiceCard name="wallets" value="googlepay" title="Google Pay" type="checkbox" checked={selectedWallets.includes("googlepay")} />
              </div>
              <Field
                label="Annar talgildur pungur"
                name="wallet_other"
                value={answerValue<string>(pack, "wallet_other")}
                placeholder="Valfrítt"
              />
            </section>

            <section class="wizard-panel">
              <h2 class="wizard-section-title">Hvar eru kundarnir?</h2>
              <p class="wizard-section-copy">Prosentini skulu vera 100 tilsamans.</p>
              <div class="sales-regions-grid">
                <Field label="Danmark %" name="sales_denmark" type="number" value={salesRegions.denmark} required inputmode="decimal" />
                <Field label="Onnur Norðurlond %" name="sales_nordics" type="number" value={salesRegions.nordics} required inputmode="decimal" />
                <Field label="Onnur ES-lond %" name="sales_eu" type="number" value={salesRegions.eu} required inputmode="decimal" />
                <Field label="USA %" name="sales_usa" type="number" value={salesRegions.usa} required inputmode="decimal" />
                <Field label="Onnur lond %" name="sales_other" type="number" value={salesRegions.other} required inputmode="decimal" />
              </div>
              <p class="sales-total tnum" id="sales-total">
                Tilsamans: {salesRegions.denmark + salesRegions.nordics + salesRegions.eu + salesRegions.usa + salesRegions.other}%
              </p>
            </section>
          </div>
        )}

        {stig === "eigarar" && (
          <div class="wizard-stack">
            {registrySnapshot && (
              <section class="wizard-panel registry-context">
                <div class="wizard-panel-heading">
                  <div>
                    <span class="source-badge">eyga.fo</span>
                    <h2>Hetta funnu vit í almennu skránni</h2>
                  </div>
                  <a href={registrySnapshot.sourceUrl} target="_blank" rel="noreferrer">Opna ↗</a>
                </div>
                <div class="registry-person-list">
                  {(registrySnapshot.beneficialOwners.length > 0
                    ? registrySnapshot.beneficialOwners
                    : registrySnapshot.owners).slice(0, 6).map((owner) => (
                    <div class="registry-person">
                      <span>
                        <strong>{owner.name}</strong>
                        {owner.description && <small>{owner.description}</small>}
                      </span>
                      {owner.ownershipBps != null && (
                        <span class="tnum">{(owner.ownershipBps / 100).toLocaleString("fo-FO")} %</span>
                      )}
                    </div>
                  ))}
                </div>
                {registrySnapshot.management.length > 0 && (
                  <div class="registry-people-preview">
                    <div class="registry-people-title">
                      <span>Leiðsla og nevnd</span>
                      <span class="tnum">{registrySnapshot.management.length}</span>
                    </div>
                    {registrySnapshot.management.slice(0, 6).map((person) => (
                      <div class="registry-person">
                        <span>
                          <strong>{person.name}</strong>
                          {person.description && <small>{person.description}</small>}
                        </span>
                      </div>
                    ))}
                  </div>
                )}
                {registrySnapshot.signingRules && (
                  <div class="registry-signing-rules">
                    <strong>Tekningarregla</strong>
                    <span>{registrySnapshot.signingRules}</span>
                  </div>
                )}
                <p class="field-hint">{fo.onboarding.eygaPrivate}</p>
              </section>
            )}

            <div id="owners" class="owner-list">
              {owners.map((owner, index) => (
                <section class="owner-card" data-owner-card>
                  <div class="owner-card-heading">
                    <h2>Persónur <span class="tnum">{index + 1}</span></h2>
                    <button class="owner-remove" type="button" aria-label="Tak persón burt">Tak burt</button>
                  </div>
                  <Field label="Navn" name="owner_name" value={owner.name} required={index === 0} autocomplete="name" />
                  <div class="field-row">
                    <Field
                      label="Teldupostur"
                      name="owner_email"
                      id={`owner-email-${index}`}
                      type="email"
                      value={owner.email}
                      autocomplete="email"
                      required={Boolean(owner.is_signatory)}
                      hint="Klintra sendir undirskriftarleinkjuna higar."
                    />
                    <Field label="Leiklutur" name="owner_role" value={owner.role} placeholder="t.d. stjóri" />
                  </div>
                  <Field label="Eigaralutur %" name="owner_bps" value={owner.ownership_bps == null ? "" : String(owner.ownership_bps / 100)} inputmode="decimal" />
                  <Field
                    label="Kann undirskriva fyri felagið"
                    name="owner_signatory"
                    type="checkbox"
                    value={String(index)}
                    checked={Boolean(owner.is_signatory)}
                  />
                  <p class="identity-note">
                    <span aria-hidden="true">◇</span>
                    P-talið verður knýtt at undirskrivaranum við Samleikanum.
                  </p>
                </section>
              ))}
            </div>
            <button class="btn owner-add" type="button" id="add-owner">
              + Legg persón afturat
            </button>
          </div>
        )}

        {stig === "roknskapur" && (
          <div class="wizard-stack">
            <section class="wizard-panel">
              <h2 class="wizard-section-title">Er eginognin positiv?</h2>
              <p class="wizard-section-copy">Hygg í seinasta ársroknskap, um tú ivast.</p>
              <div class="choice-grid" data-cols="3">
                <ChoiceCard name="equity" value="positive" title="Ja" checked={app.equity === "positive"} />
                <ChoiceCard name="equity" value="negative" title="Nei" hint="Vit finna aðra leið" checked={app.equity === "negative"} />
                <ChoiceCard name="equity" value="unknown" title="Veit ikki" checked={app.equity === "unknown"} />
              </div>
            </section>
            <section class="wizard-panel">
              <h2 class="wizard-section-title">Er raksturin positivur?</h2>
              <p class="wizard-section-copy">Svar eftir seinasta roknskaparári.</p>
              <div class="choice-grid" data-cols="3">
                <ChoiceCard name="operations" value="positive" title="Ja" checked={app.operations === "positive"} />
                <ChoiceCard name="operations" value="negative" title="Nei" hint="Vit finna aðra leið" checked={app.operations === "negative"} />
                <ChoiceCard name="operations" value="unknown" title="Veit ikki" checked={app.operations === "unknown"} />
              </div>
            </section>
          </div>
        )}
      </form>
    )
  }

  {
    stig === "banki" && (
      <div class="wizard-stack">
        {Astro.url.searchParams.get("klárt") === "bankaskjal" && (
          <div class="wizard-alert is-success">
            Kontan er goymd. Nú er bankaskjalið fylt og klárt at taka niður.
          </div>
        )}
        <form id="wizard-form" method="POST" action={formAction} class="wizard-panel">
          <input type="hidden" name="step" value="banki" />
          <div class="task-heading">
            <span class="task-number tnum">1</span>
            <div>
              <h2>Goym kontunummarið</h2>
              <p>Vit seta tað inn í bankaskjalið fyri teg.</p>
            </div>
          </div>
          <Field
            label="Kontunummar"
            name="bank_account"
            value={app.bank_account}
            required
            inputmode="numeric"
            autocomplete="off"
            hint="Føroyskt kontunummar. Tú kanst rætta tað, áðrenn tú heldur fram."
          />
        </form>

        {app.bank_account && (
          <section class="wizard-panel">
            <div class="task-heading">
              <span class="task-number tnum">2</span>
              <div>
                <h2>Bið bankan vátta kontuna</h2>
                <p>Betal sendir ein lidnan teldupost við bankaskjalinum viðheftum.</p>
              </div>
            </div>
            {bankEmailSent || (latestBankEmail && latestBankEmail.status !== "failed") ? (
              <>
                <p class="bank-email-success" role="status">
                  <span aria-hidden="true">✓</span>
                  {latestBankEmail?.status === "delivered"
                    ? "Telduposturin er komin fram til bankan."
                    : latestBankEmail?.status === "delayed"
                      ? "Telduposturin er seinkaður. Resend roynir aftur."
                      : "Telduposturin er sendur. Tú ert sett/ur í CC og fært svarið frá bankanum."}
                </p>
                {latestBankEmail && (
                  <p class="field-hint">
                    Til {latestBankEmail.bank_email} · {formatDateTime(latestBankEmail.sent_at_ms)}
                  </p>
                )}
                <a class="bank-email-again" href={href("banki")}>
                  Send til annan teldupost
                </a>
              </>
            ) : (
              <form
                class="bank-email-form"
                method="POST"
                action={`/api/umbon/${id}/bankateldupostur${q}`}
              >
                <Field
                  label="Teldupostur hjá bankanum"
                  name="bank_email"
                  type="email"
                  required
                  autocomplete="off"
                  placeholder="radgevi@banki.fo"
                  hint="Til ráðgevan ella deildina, sum kann stempla skjalið."
                />
                <Field
                  label={actor.kind === "merchant"
                    ? "Tín teldupostur (CC)"
                    : "Teldupostur hjá viðskiftafólkinum (CC)"}
                  name="cc_email"
                  type="email"
                  value={clientEmail}
                  required
                  readonly
                  autocomplete="email"
                  hint="Tú fært teldupostin og svarið frá bankanum beinleiðis."
                />
                <button class="btn task-action" type="submit" disabled={!bankEmailReady}>
                  Send til bankan
                </button>
                <p class="field-hint bank-email-note">
                  {bankEmailReady
                    ? "Svarið frá bankanum fer beinleiðis til tín."
                    : "Resend er ikki sett upp enn. Tak bankaskjalið niður niðanfyri."}
                </p>
              </form>
            )}
            <a class="bank-pdf-fallback" href={`/api/umbon/${id}/bankaskjal.pdf${q}`}>
              Ella tak bert bankaskjalið niður
            </a>
          </section>
        )}

        {app.bank_account && (
          <section class="wizard-panel">
            <div class="task-heading">
              <span class="task-number tnum">3</span>
              <div>
                <h2>Legg stemplaða skjalið upp</h2>
                <p>Ein PDF ella greið mynd er nóg mikið.</p>
              </div>
            </div>

            {docChip("bank_confirmation") ? (
              <div class="file-chip is-complete">
                <span class="file-chip-check" aria-hidden="true">✓</span>
                <span class="file-chip-name">{docChip("bank_confirmation")?.file_name}</span>
                <span class="file-chip-meta tnum">{docChip("bank_confirmation")?.byte_size} B</span>
              </div>
            ) : (
              <form method="POST" action={uploadAction} enctype="multipart/form-data">
                <input type="hidden" name="kind" value="bank_confirmation" />
                <input type="hidden" name="step" value="banki" />
                <Dropzone title="Vel stemplað bankaskjal" />
                <button class="btn upload-submit" type="submit">Legg upp</button>
              </form>
            )}
          </section>
        )}
      </div>
    )
  }

  {
    stig === "skjol" && (
      <div class="wizard-stack">
        <form id="wizard-form" method="POST" action={formAction} class="wizard-panel">
          <input type="hidden" name="step" value="skjol" />
          <Field
            label="Aðrar viðmerkingar"
            name="additional_comments"
            type="textarea"
            value={answerValue<string>(pack, "additional_comments")}
            hint="Valfrítt"
          />
        </form>

        <section class="wizard-panel upload-panel">
          <div class="upload-panel-heading">
            <div>
              <h2>Skásetingarprógv</h2>
              <p>Útskrift frá TAKS ella Vinnuskránni, í mesta lagi tríggjar mánaðir gomul.</p>
            </div>
            {docChip("company_registration") && <span class="upload-done">Klárt</span>}
          </div>
          {docChip("company_registration") ? (
            <div class="file-chip is-complete">
              <span class="file-chip-check" aria-hidden="true">✓</span>
              <span class="file-chip-name">{docChip("company_registration")?.file_name}</span>
              <span class="file-chip-meta tnum">{docChip("company_registration")?.byte_size} B</span>
            </div>
          ) : (
            <form method="POST" action={uploadAction} enctype="multipart/form-data">
              <input type="hidden" name="kind" value="company_registration" />
              <input type="hidden" name="step" value="skjol" />
              <Dropzone title="Vel skásetingarprógv" />
              <button class="btn upload-submit" type="submit">Legg upp</button>
            </form>
          )}
        </section>

        <section class="wizard-panel upload-panel">
          <div class="upload-panel-heading">
            <div>
              <h2>Eigarabók</h2>
              <p>Seinasta eigarabók ella samsvarandi yvirlit yvir eigarar.</p>
            </div>
            {docChip("owners_book") && <span class="upload-done">Klárt</span>}
          </div>
          {docChip("owners_book") ? (
            <div class="file-chip is-complete">
              <span class="file-chip-check" aria-hidden="true">✓</span>
              <span class="file-chip-name">{docChip("owners_book")?.file_name}</span>
              <span class="file-chip-meta tnum">{docChip("owners_book")?.byte_size} B</span>
            </div>
          ) : (
            <form method="POST" action={uploadAction} enctype="multipart/form-data">
              <input type="hidden" name="kind" value="owners_book" />
              <input type="hidden" name="step" value="skjol" />
              <Dropzone title="Vel eigarabók" />
              <button class="btn upload-submit" type="submit">Legg upp</button>
            </form>
          )}
        </section>

        {app.extra_docs_required === 1 && (
          <section class="wizard-panel upload-panel">
            <div class="upload-panel-heading">
              <div>
                <h2>Ársroknskapur</h2>
                <p>Seinasti ársroknskapur ella YTD, tí vinnugreinin krevur eyka skjalprógv.</p>
              </div>
              {docChip("annual_accounts") && <span class="upload-done">Klárt</span>}
            </div>
            {docChip("annual_accounts") ? (
              <div class="file-chip is-complete">
                <span class="file-chip-check" aria-hidden="true">✓</span>
                <span class="file-chip-name">{docChip("annual_accounts")?.file_name}</span>
              </div>
            ) : (
              <form method="POST" action={uploadAction} enctype="multipart/form-data">
                <input type="hidden" name="kind" value="annual_accounts" />
                <input type="hidden" name="step" value="skjol" />
                <Dropzone title="Vel ársroknskap" />
                <button class="btn upload-submit" type="submit">Legg upp</button>
              </form>
            )}
          </section>
        )}

        {app.vertical_sector === 2 && (
          <section class="wizard-panel upload-panel">
            <div class="upload-panel-heading">
              <div>
                <h2>Eyka vinnuspurningar</h2>
                <p>Spurningar og skjalprógv, sum hoyra til vinnugreinina.</p>
              </div>
              {docChip("industry_answers") && <span class="upload-done">Klárt</span>}
            </div>
            {docChip("industry_answers") ? (
              <div class="file-chip is-complete">
                <span class="file-chip-check" aria-hidden="true">✓</span>
                <span class="file-chip-name">{docChip("industry_answers")?.file_name}</span>
              </div>
            ) : (
              <form method="POST" action={uploadAction} enctype="multipart/form-data">
                <input type="hidden" name="kind" value="industry_answers" />
                <input type="hidden" name="step" value="skjol" />
                <Dropzone title="Vel vinnuskjal" />
                <button class="btn upload-submit" type="submit">Legg upp</button>
              </form>
            )}
          </section>
        )}

        <section class="wizard-panel upload-panel">
          <div class="upload-panel-heading">
            <div>
              <h2>Onnur skjøl</h2>
              <p>Valfrí skjøl, sum hjálpa Betal ella innloysaranum at skilja umsóknina.</p>
            </div>
            {docChip("additional") && <span class="upload-done">Lagt upp</span>}
          </div>
          {docChip("additional") ? (
            <div class="file-chip is-complete">
              <span class="file-chip-check" aria-hidden="true">✓</span>
              <span class="file-chip-name">{docChip("additional")?.file_name}</span>
            </div>
          ) : (
            <form method="POST" action={uploadAction} enctype="multipart/form-data">
              <input type="hidden" name="kind" value="additional" />
              <input type="hidden" name="step" value="skjol" />
              <Dropzone title="Vel annað skjal" />
              <button class="btn upload-submit" type="submit">Legg upp</button>
            </form>
          )}
        </section>
      </div>
    )
  }

  {
    stig === "undirskriva" && (
      <div class="wizard-stack">
        {!swedbank && app.recommended_acquirer && (
          <form method="POST" action={formAction} class="wizard-panel">
            <input type="hidden" name="step" value="undirskriva" />
            <input type="hidden" name="mode" value="acknowledge" />
            <h2>Vit finna eina aðra leið</h2>
            <p class="wizard-section-copy">{fo.onboarding.noSwedbankPdf}</p>
            <p class="field-hint">{app.screening_reason}</p>
            <button class="btn btn-primary signing-action" type="submit">
              Eg skilji — halt áfram
            </button>
          </form>
        )}

        {swedbank && (
          <>
            <section class="wizard-panel agreement-panel">
              <div class="wizard-panel-heading">
                <div>
                  <h2>Avtalan hjá tykkum</h2>
                  <p>Navn, eigarar, FO og rætti príslistin eru fylt frammanundan.</p>
                </div>
              </div>
              {!fill.ok && <div class="wizard-alert is-error">{fill.reason}</div>}
              {fill.ok && (
                <iframe
                  class="agreement-preview"
                  title="FO-avtalan"
                  src={`/api/umbon/${id}/avtalan.pdf${q}`}
                />
              )}
            </section>

            <section class="wizard-panel signing-panel">
              <div class="task-heading">
                <span class="task-number" aria-hidden="true">◇</span>
                <div>
                  <h2>Undirskriva við Samleikanum</h2>
                  <p>Samleikin váttar bæði undirskriftina og P-talið hjá undirskrivaranum.</p>
                </div>
              </div>

              {skrivaSigned || skrivaMessage === "skriva_signed" ? (
                <>
                  <div class="bank-email-success">
                    <span aria-hidden="true">✓</span>
                    Avtalan er undirskrivað við Samleikanum og goymd í pakkanum.
                  </div>
                  <a class="btn signing-action" href={`/api/umbon/${id}/avtalan.pdf${q}`}>
                    Opna undirskrivaðu avtaluna
                  </a>
                </>
              ) : skrivaPending.length > 0 ? (
                <>
                  <div class="wizard-alert is-success">
                    {skrivaMessage === "skriva"
                      ? "Undirskriftin er stovnað, og Klintra hevur sent leinkjurnar."
                      : skrivaPending.length === 1
                        ? "Ein undirskrift bíðar."
                        : `${skrivaPending.length} undirskriftir bíða.`}
                  </div>
                  {actor.kind === "merchant" && actorSigning?.signing_url && (
                    <a class="btn btn-primary signing-action" href={actorSigning.signing_url}>
                      Far til Samleikan
                    </a>
                  )}
                  <form method="POST" action={`/api/umbon/${id}/skriva/status${q}`}>
                    <button class="btn signing-action" type="submit">
                      Dagfør støðuna
                    </button>
                  </form>
                </>
              ) : (
                <>
                  {!send.ok && <p class="field-hint signing-note">{send.reason}</p>}
                  <form method="POST" action={`/api/umbon/${id}/skriva${q}`}>
                    <button class="btn btn-primary signing-action" type="submit" disabled={!send.ok}>
                      Stovna undirskrift
                    </button>
                  </form>
                </>
              )}
            </section>

            {!skrivaSigned && (
              <details class="wizard-panel wet-ink">
              <summary>Eg vil heldur undirskriva á pappíri</summary>
              <p class="field-hint">{fo.onboarding.wetInk}</p>

              {docChip("agreement") ? (
                <div class="file-chip is-complete">
                  <span class="file-chip-check" aria-hidden="true">✓</span>
                  <span class="file-chip-name">{docChip("agreement")?.file_name}</span>
                </div>
              ) : (
                <form method="POST" action={uploadAction} enctype="multipart/form-data">
                  <input type="hidden" name="kind" value="agreement" />
                  <input type="hidden" name="step" value="undirskriva" />
                  <Dropzone title="Vel undirskrivaðu avtaluna" />
                  <button class="btn upload-submit" type="submit">Legg avtalu upp</button>
                </form>
              )}

              {docChip("photo_id") ? (
                <div class="file-chip is-complete">
                  <span class="file-chip-check" aria-hidden="true">✓</span>
                  <span class="file-chip-name">{docChip("photo_id")?.file_name}</span>
                </div>
              ) : (
                <form method="POST" action={uploadAction} enctype="multipart/form-data">
                  <input type="hidden" name="kind" value="photo_id" />
                  <input type="hidden" name="step" value="undirskriva" />
                  <Dropzone title="Vel persónsprógv" accept="image/jpeg,image/png,application/pdf" />
                  <button class="btn upload-submit" type="submit">Legg persónsprógv upp</button>
                </form>
              )}

              {docChip("agreement") && docChip("photo_id") && (
                <form method="POST" action={formAction}>
                  <input type="hidden" name="step" value="undirskriva" />
                  <input type="hidden" name="mode" value="wet_ink" />
                  <button class="btn signing-action" type="submit">Send pappírsavtaluna</button>
                </form>
              )}
              </details>
            )}
          </>
        )}
      </div>
    )
  }

  {
    stig === "bida" && (
      <>
        <p class="wizard-why">
          {app.recommended_acquirer === "clearhaus" || app.recommended_acquirer === "shift4"
            ? fo.onboarding.waitClearhaus
            : app.state === "submitted"
              ? fo.onboarding.waitSwedbank
              : fo.onboarding.waitStaff}
        </p>
        {app.screening_reason && <p class="field-hint">{app.screening_reason}</p>}
        <div class="timeline" style="margin-top:1.5rem">
          {pack.events.map((event) => (
            <div class="timeline-item">
              <span class="timeline-label">
                {fo.onboarding.events[event.kind as keyof typeof fo.onboarding.events] ?? event.kind}
              </span>
              <span class="timeline-meta tnum">{formatDateTime(event.at_ms)}</span>
            </div>
          ))}
        </div>
        <p style="margin-top:1.5rem">
          <a class="btn" href={`/${q}`}>Til yvirlitið</a>
        </p>
      </>
    )
  }
</WizardLayout>

{
  applicationLocked && (
    <script is:inline>
      document.querySelectorAll("#wizard-form input, #wizard-form textarea, #wizard-form select, #wizard-form button")
        .forEach((control) => control.disabled = true);
    </script>
  )
}

{
  stig === "vinnugrein" && (
    <script is:inline>
      const verticalForm = document.getElementById("wizard-form");
      const guidance = document.getElementById("vertical-guidance");

      function showRouting() {
        const selected = verticalForm?.querySelector('input[name="vertical_key"]:checked');
        let sector = Number(selected?.closest("[data-sector]")?.dataset.sector ?? "0");
        const donations = verticalForm?.querySelector('input[name="donations"]:checked')?.value;
        const giftCards = verticalForm?.querySelector('input[name="gift_cards"]:checked')?.value;
        const productType = verticalForm?.querySelector('input[name="product_type"]:checked')?.value;
        if (donations === "yes") sector = 1;
        else if (giftCards === "yes" || productType === "digital" || productType === "both") {
          sector = Math.max(sector, 2);
        }
        guidance?.querySelectorAll("[data-routing]").forEach((message) => {
          message.hidden = Number(message.dataset.routing) !== sector;
        });
      }

      function updateBusinessFields() {
        const madeToOrder = verticalForm?.querySelector(
          'input[name="made_to_order"]:checked',
        )?.value === "yes";
        const details = document.getElementById("made-to-order-details");
        if (details) details.hidden = !madeToOrder;
        details?.querySelectorAll("input").forEach((input) => {
          if (input.name !== "deposit_share_percent") input.required = madeToOrder;
        });

        const deposit = madeToOrder && verticalForm?.querySelector(
          'input[name="deposit"]:checked',
        )?.value === "yes";
        const depositDetails = document.getElementById("deposit-details");
        if (depositDetails) depositDetails.hidden = !deposit;
        const depositShare = verticalForm?.querySelector('input[name="deposit_share_percent"]');
        if (depositShare) depositShare.required = deposit;

        const saveCard = verticalForm?.querySelector(
          'input[name="save_card"]:checked',
        )?.value === "yes";
        const saveCardDetails = document.getElementById("save-card-details");
        if (saveCardDetails) saveCardDetails.hidden = !saveCard;
        saveCardDetails?.querySelectorAll("input").forEach((input) => {
          input.required = saveCard;
        });

        const donations = verticalForm?.querySelector(
          'input[name="donations"]:checked',
        )?.value === "yes";
        const donationDetails = document.getElementById("donation-details");
        if (donationDetails) donationDetails.hidden = !donations;
        donationDetails?.querySelectorAll("input").forEach((input) => {
          input.required = donations;
        });

        const total = ["sales_denmark", "sales_nordics", "sales_eu", "sales_usa", "sales_other"]
          .reduce((sum, name) => {
            const input = verticalForm?.querySelector(`input[name="${name}"]`);
            return sum + (Number(input?.value) || 0);
          }, 0);
        const totalLabel = document.getElementById("sales-total");
        if (totalLabel) {
          totalLabel.textContent = `Tilsamans: ${total}%`;
          totalLabel.classList.toggle("is-valid", total === 100);
          totalLabel.classList.toggle("is-error", total !== 100);
        }
      }

      verticalForm?.addEventListener("change", () => {
        showRouting();
        updateBusinessFields();
      });
      verticalForm?.addEventListener("input", updateBusinessFields);
      showRouting();
      updateBusinessFields();
    </script>
  )
}

{
  stig === "eigarar" && (
    <script is:inline>
      const ownerList = document.getElementById("owners");

      function renumberOwners() {
        const cards = ownerList?.querySelectorAll("[data-owner-card]") ?? [];
        cards.forEach((card, index) => {
          const number = card.querySelector(".owner-card-heading .tnum");
          const checkbox = card.querySelector('input[name="owner_signatory"]');
          const email = card.querySelector('input[name="owner_email"]');
          const emailLabel = email?.closest(".field")?.querySelector("label");
          if (number) number.textContent = String(index + 1);
          if (checkbox) {
            checkbox.value = String(index);
            if (email) email.required = checkbox.checked;
          }
          if (email) email.id = `owner-email-${index}`;
          if (emailLabel) emailLabel.htmlFor = `owner-email-${index}`;
          card.querySelector(".owner-remove")?.toggleAttribute("hidden", cards.length === 1);
        });
      }

      document.getElementById("add-owner")?.addEventListener("click", () => {
        const list = document.getElementById("owners");
        const cards = list?.querySelectorAll("[data-owner-card]");
        const first = cards?.[0];
        if (!list || !first) return;
        const clone = first.cloneNode(true);
        clone.querySelectorAll("input").forEach((input) => {
          if (input.type === "checkbox") {
            input.checked = false;
          } else {
            input.value = "";
          }
        });
        list.appendChild(clone);
        renumberOwners();
        clone.querySelector('input[name="owner_name"]')?.focus();
      });

      ownerList?.addEventListener("click", (event) => {
        const button = event.target.closest(".owner-remove");
        if (!button || ownerList.querySelectorAll("[data-owner-card]").length === 1) return;
        button.closest("[data-owner-card]")?.remove();
        renumberOwners();
      });

      ownerList?.addEventListener("change", (event) => {
        if (event.target.matches('input[name="owner_signatory"]')) renumberOwners();
      });

      renumberOwners();
    </script>
  )
}

{
  stig === "felag" && !selectedCompany && !manualCompany && (
    <script is:inline>
      const search = document.getElementById("eyga-search");
      const resultList = document.getElementById("eyga-results");
      let searchTimer;
      let searchSequence = 0;

      function resultRow(result) {
        const link = document.createElement("a");
        link.className = "registry-result";
        link.href = search.dataset.resultBase.replace("__ID__", encodeURIComponent(result.id));

        const avatar = document.createElement("span");
        avatar.className = "registry-avatar";
        avatar.setAttribute("aria-hidden", "true");
        avatar.textContent = result.companyType;

        const copy = document.createElement("span");
        copy.className = "registry-result-copy";
        const name = document.createElement("strong");
        name.textContent = result.name;
        const meta = document.createElement("span");
        meta.textContent = `${result.location} · skrásetingarnr. ${result.registryNumber}`;
        copy.append(name, meta);

        const status = document.createElement("span");
        status.className = `registry-status${result.status === "virkid" ? "" : " is-warning"}`;
        status.textContent = result.statusLabel;

        const chevron = document.createElement("span");
        chevron.className = "registry-chevron";
        chevron.setAttribute("aria-hidden", "true");
        chevron.textContent = "›";

        link.append(avatar, copy, status, chevron);
        return link;
      }

      search?.addEventListener("input", () => {
        clearTimeout(searchTimer);
        const query = search.value.trim();
        if (query.length < 2) {
          resultList?.replaceChildren();
          return;
        }
        searchTimer = setTimeout(async () => {
          const sequence = ++searchSequence;
          resultList?.setAttribute("aria-busy", "true");
          try {
            const response = await fetch(`/api/eyga/leita?q=${encodeURIComponent(query)}`);
            const payload = await response.json();
            if (sequence !== searchSequence || !resultList) return;
            if (payload.results?.length) {
              resultList.replaceChildren(...payload.results.map(resultRow));
            } else {
              const empty = document.createElement("p");
              empty.className = "registry-empty";
              empty.textContent = payload.error ?? "Einki felag funnið.";
              resultList.replaceChildren(empty);
            }
          } catch {
            if (sequence !== searchSequence || !resultList) return;
            const empty = document.createElement("p");
            empty.className = "registry-empty";
            empty.textContent = "Eyga svarar ikki beint nú.";
            resultList.replaceChildren(empty);
          } finally {
            resultList?.removeAttribute("aria-busy");
          }
        }, 180);
      });
    </script>
  )
}
