---
import WizardLayout from "~/components/ui/WizardLayout.astro";
import { env } from "~/lib/env";
import { fo } from "~/content/fo";
import { requirePack, wizardPath } from "~/lib/onboarding/access";
import {
  STEP_SLUGS,
  firstIncompleteStep,
  isStepComplete,
  stepLabel,
  type StepSlug,
} from "~/lib/onboarding/steps";
import { applicationProgress } from "~/lib/onboarding/progress";
import { formatDateTime } from "~/lib/nav";

export const prerender = false;

const actor = Astro.locals.actor!;
const id = Astro.params.id!;

let pack;
try {
  pack = await requirePack(env.DB, actor, id, Astro.url.searchParams.get("handil"));
} catch {
  return Astro.redirect("/umbon");
}

const merchantId = pack.application.merchant_id;
const first = firstIncompleteStep(pack);
const currentIndex = STEP_SLUGS.indexOf(first);
const progress = applicationProgress(pack);
const href = (slug: string) => wizardPath(id, slug, actor, merchantId);
const steps = STEP_SLUGS.map((slug) => ({
  slug,
  label: stepLabel(slug),
  href: href(slug),
  state: (slug === first
    ? "current"
    : isStepComplete(slug as StepSlug, pack)
      ? "done"
      : "todo") as "todo" | "current" | "done",
}));
---

<WizardLayout
  title="Umsóknin"
  why="Tú kanst arbeiða í fleiri pørtum og koma aftur seinni. Alt verður goymt."
  steps={steps}
  currentIndex={currentIndex}
  savedLabel={`${fo.onboarding.saved} · ${formatDateTime(pack.application.updated_at_ms)}`}
  backHref="/"
  hideContinue
>
  <section class="wizard-panel application-progress-card">
    <div class="application-progress-heading">
      <div>
        <span class="tnum application-progress-number">{progress.percentage}%</span>
        <p>{progress.complete} av {progress.total} upplýsingum eru klárar</p>
      </div>
      <a class="btn btn-primary" href={href(first)}>{fo.onboarding.resume}</a>
    </div>
    <div class="application-progress-track" aria-label={`${progress.percentage}% liðugt`}>
      <span style={`width:${progress.percentage}%`} />
    </div>
  </section>

  <nav class="application-sections" aria-label="Partar í umsóknini">
    {progress.steps.map((section) => (
      <a class="application-section" href={href(section.slug)}>
        <span class:list={["application-section-mark", section.complete === section.total && "is-done"]}>
          {section.complete === section.total ? "✓" : STEP_SLUGS.indexOf(section.slug) + 1}
        </span>
        <span>
          <strong>{stepLabel(section.slug)}</strong>
          <small class="tnum">{section.complete}/{section.total}</small>
        </span>
        <span aria-hidden="true">›</span>
      </a>
    ))}
  </nav>

  <details class="wizard-panel missing-panel">
    <summary>
      <span>Sí tað, ið manglar</span>
      <span class="tnum">{progress.missing}</span>
    </summary>
    <div class="missing-groups">
      {progress.steps.filter((section) => section.missing.length > 0).map((section) => (
        <a href={href(section.slug)} class="missing-group">
          <span>
            <strong>{stepLabel(section.slug)}</strong>
            <small>{section.missing.length} mangla</small>
          </span>
          <span aria-hidden="true">Opna →</span>
        </a>
      ))}
    </div>
  </details>
</WizardLayout>
