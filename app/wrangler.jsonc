{
  "name": "betal-app",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "betal",
      "database_id": "b7f1450c-c93b-4eea-ad53-0f694a8cf2de",
      "migrations_dir": "migrations"
    },
    {
      // Same register as eyga.fo. Read-only — never point Betal migrations here.
      "binding": "EYGA_CORE",
      "database_name": "eyga-core",
      "database_id": "477f6899-52a1-4bd1-9e9b-6351be9ddb76"
    },
    {
      "binding": "EYGA_SEARCH",
      "database_name": "eyga-search",
      "database_id": "74076e4d-946b-4195-a9da-092436ac66f8"
    }
  ],
  "kv_namespaces": [
    {
      // Merchant access tokens. Never leaves the worker.
      "binding": "TOKENS",
      "id": "2107b17ae3904d09812fc0368463b7ea"
    }
  ],
  "r2_buckets": [
    {
      // Private onboarding uploads, generated templates and signed agreements.
      "binding": "DOCUMENTS",
      "bucket_name": "betal-documents"
    }
  ],
  // Producer only. The consumer lives in workers/ingest so webhook projection is not
  // affected by app deploys or app traffic.
  "queues": {
    "producers": [{ "binding": "INGEST_QUEUE", "queue": "betal-ingest" }]
  },
  // Optional HTTP fallback to api.eyga.fo. The live register bindings above are
  // the default. A Bearer token is still required for the HTTP API.
  "services": [
    {
      "binding": "EYGA_API",
      "service": "eyga-api"
    }
  ],
  "vars": {
    "APP_URL": "https://app.betal.fo",
    "BANK_EMAIL_FROM": "Betal <banki@send.betal.fo>",
    "SKRIVA_BASE_URL": "https://klintraelectronicsigningapi.azurewebsites.net"
  }
}
