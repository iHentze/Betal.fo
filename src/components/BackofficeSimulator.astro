---
/**
 * ePay Backoffice preview: a live transaction feed with a small sparkline.
 * Rows stream in on a timer once the panel scrolls into view.
 */
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const rows = [
  { tag: "AP", kind: "Apple Pay", ch: "Nethandil", amt: "349,00", time: "14:22", ref: "28194" },
  { tag: "SP", kind: "Softpay", ch: "Á staðnum", amt: "120,00", time: "14:18", ref: "28193" },
  { tag: "GL", kind: "Gjaldsleinki", ch: "Fakturi", amt: "2.450,00", time: "13:45", ref: "28192" },
  { tag: "GP", kind: "Google Pay", ch: "Nethandil", amt: "89,50", time: "13:31", ref: "28191" },
];

// Sparkline: a week of relative volume.
const series = [38, 52, 44, 66, 58, 81, 74];
const w = 220;
const h = 46;
const max = Math.max(...series);
const pts = series.map((v, i) => `${(i / (series.length - 1)) * w},${h - (v / max) * (h - 6) - 3}`);
const line = `M${pts.join(" L")}`;
const area = `${line} L${w},${h} L0,${h} Z`;
---

<div class:list={["relative w-full max-w-[24rem]", className]} data-backoffice>
  <div class="pointer-events-none absolute -inset-6 rounded-[2.5rem] bg-green/8 blur-3xl"></div>

  <div
    class="relative overflow-hidden rounded-[1.75rem] border border-white/12 bg-navy/95 shadow-[0_30px_70px_-20px_rgba(0,0,0,0.8)] backdrop-blur-2xl"
  >
    <!-- Chrome -->
    <div class="flex items-center justify-between border-b border-white/8 bg-white/[0.02] px-5 py-3">
      <div class="flex items-center gap-2.5">
        <span class="flex gap-1.5">
          <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-green/60"></span>
        </span>
        <span class="font-mono text-[11px] text-white/40">backoffice</span>
      </div>
      <span class="flex items-center gap-1.5 rounded-full border border-green/25 bg-green/8 px-2.5 py-0.5">
        <span class="relative flex h-1.5 w-1.5">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green opacity-70"></span>
          <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-green"></span>
        </span>
        <span class="font-mono text-[9px] font-semibold tracking-wider text-green">LIVE</span>
      </span>
    </div>

    <div class="space-y-4 p-5">
      <!-- Headline figure + sparkline -->
      <div class="rounded-2xl border border-white/8 bg-white/[0.025] p-4">
        <div class="flex items-start justify-between">
          <div>
            <p class="text-[10px] text-white/45">Søla í dag</p>
            <p class="tnum mt-0.5 text-2xl font-bold tracking-tight text-white">
              <span data-count-to="14850">0</span> kr.
            </p>
          </div>
          <span class="rounded-full bg-green/12 px-2 py-0.5 text-[10px] font-semibold text-green">+18,4 %</span>
        </div>
        <svg viewBox={`0 0 ${w} ${h}`} class="mt-3 h-11 w-full" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="spark" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#7bd865" stop-opacity="0.35"></stop>
              <stop offset="100%" stop-color="#7bd865" stop-opacity="0"></stop>
            </linearGradient>
          </defs>
          <path d={area} fill="url(#spark)"></path>
          <path
            d={line}
            fill="none"
            stroke="#7bd865"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            pathLength="1"
            stroke-dasharray="1"
            stroke-dashoffset="1"
            data-spark
          ></path>
        </svg>
      </div>

      <!-- Feed -->
      <div>
        <p class="mb-2 text-[10px] font-semibold uppercase tracking-[0.16em] text-white/35">Seinastu flytingar</p>
        <ul class="space-y-1.5">
          {
            rows.map((r, i) => (
              <li
                class="flex items-center justify-between rounded-xl border border-white/5 bg-white/[0.02] p-2.5 opacity-0 transition-colors hover:bg-white/[0.05]"
                data-row
                style={`--row-delay:${i * 220}ms`}
              >
                <span class="flex items-center gap-2.5">
                  <span class="grid h-7 w-7 place-items-center rounded-lg bg-green/12 font-mono text-[9px] font-bold text-green">
                    {r.tag}
                  </span>
                  <span class="leading-tight">
                    <span class="block text-[11px] font-medium text-white">{r.kind}</span>
                    <span class="block text-[9px] text-white/40">
                      {r.ch} · {r.time} · #{r.ref}
                    </span>
                  </span>
                </span>
                <span class="text-right leading-tight">
                  <span class="tnum block text-[11px] font-semibold text-white">+{r.amt}</span>
                  <span class="block text-[9px] font-medium text-green">Goldið</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</div>

<style>
  [data-row] {
    animation: row-in 0.55s var(--ease-out-expo) forwards;
    animation-play-state: paused;
    animation-delay: var(--row-delay);
  }

  [data-backoffice].is-live [data-row] {
    animation-play-state: running;
  }

  @keyframes row-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  [data-spark] {
    transition: stroke-dashoffset 1.6s var(--ease-out-expo) 0.2s;
  }

  [data-backoffice].is-live [data-spark] {
    stroke-dashoffset: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-row] {
      opacity: 1;
      animation: none;
    }

    [data-spark] {
      stroke-dashoffset: 0;
      transition: none;
    }
  }
</style>

<script>
  function boot() {
    const panels = document.querySelectorAll<HTMLElement>("[data-backoffice]");
    if (panels.length === 0) return;

    if (!("IntersectionObserver" in window)) {
      panels.forEach((p) => p.classList.add("is-live"));
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add("is-live");
          io.unobserve(e.target);
        }
      },
      { threshold: 0.35 },
    );

    panels.forEach((p) => io.observe(p));
  }

  document.addEventListener("astro:page-load", boot);
</script>
