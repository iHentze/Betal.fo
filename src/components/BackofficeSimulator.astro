---
// Interactive Backoffice & Softpay metrics preview component
---

<div class="relative w-full max-w-sm sm:max-w-md mx-auto rounded-3xl border border-white/15 bg-navy/95 shadow-2xl backdrop-blur-2xl overflow-hidden text-white font-sans transition-all duration-300 hover:border-green/50">
  <!-- Window Header -->
  <div class="px-5 py-4 border-b border-white/10 flex items-center justify-between bg-white/[0.02]">
    <div class="flex items-center gap-2.5">
      <div class="flex gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-green/80"></span>
      </div>
      <span class="text-xs font-mono text-white/50 pl-2">backoffice.betal.fo</span>
    </div>
    <span class="text-[11px] px-2 py-0.5 rounded-full bg-green/10 text-green border border-green/30 font-mono">Í BEINLEIÐIS</span>
  </div>

  <!-- Content stats -->
  <div class="p-5 space-y-4">
    <!-- Stat grid -->
    <div class="grid grid-cols-2 gap-3">
      <div class="p-3.5 rounded-2xl bg-white/[0.03] border border-white/10">
        <span class="text-[11px] text-white/50 block">Søla í dag</span>
        <span class="text-lg font-bold text-white tracking-tight mt-0.5 block">14.850 DKK</span>
        <span class="text-[10px] text-green flex items-center gap-0.5 mt-1">
          ↑ +18.4% í mun til í gjár
        </span>
      </div>
      <div class="p-3.5 rounded-2xl bg-white/[0.03] border border-white/10">
        <span class="text-[11px] text-white/50 block">Gjøgnumførd gjøld</span>
        <span class="text-lg font-bold text-white tracking-tight mt-0.5 block">99.4%</span>
        <span class="text-[10px] text-green flex items-center gap-0.5 mt-1">
          ✓ 0 avvísingar
        </span>
      </div>
    </div>

    <!-- Mini Transactions List -->
    <div class="space-y-2">
      <span class="text-[11px] font-semibold text-white/40 uppercase tracking-wider block">Seinastu flytingar</span>
      
      <div class="space-y-1.5">
        <div class="flex items-center justify-between p-2.5 rounded-xl bg-white/[0.02] border border-white/5 hover:bg-white/[0.05] transition text-xs">
          <div class="flex items-center gap-2.5">
            <span class="w-7 h-7 rounded-lg bg-green/15 text-green flex items-center justify-center font-bold text-[10px]">AP</span>
            <div>
              <p class="font-medium text-white text-xs">Apple Pay • Nethandil</p>
              <p class="text-[10px] text-white/40">Kl. 14:22 • #28194</p>
            </div>
          </div>
          <div class="text-right">
            <p class="font-semibold text-white text-xs">+349,00 DKK</p>
            <span class="text-[9px] text-green font-medium">Goldið</span>
          </div>
        </div>

        <div class="flex items-center justify-between p-2.5 rounded-xl bg-white/[0.02] border border-white/5 hover:bg-white/[0.05] transition text-xs">
          <div class="flex items-center gap-2.5">
            <span class="w-7 h-7 rounded-lg bg-white/10 text-white flex items-center justify-center font-bold text-[10px]">SP</span>
            <div>
              <p class="font-medium text-white text-xs">Softpay • Telefon</p>
              <p class="text-[10px] text-white/40">Kl. 14:18 • #28193</p>
            </div>
          </div>
          <div class="text-right">
            <p class="font-semibold text-white text-xs">+120,00 DKK</p>
            <span class="text-[9px] text-green font-medium">Goldið</span>
          </div>
        </div>

        <div class="flex items-center justify-between p-2.5 rounded-xl bg-white/[0.02] border border-white/5 hover:bg-white/[0.05] transition text-xs">
          <div class="flex items-center gap-2.5">
            <span class="w-7 h-7 rounded-lg bg-green/15 text-green flex items-center justify-center font-bold text-[10px]">GL</span>
            <div>
              <p class="font-medium text-white text-xs">Gjaldsleinki • Fakturi</p>
              <p class="text-[10px] text-white/40">Kl. 13:45 • #28192</p>
            </div>
          </div>
          <div class="text-right">
            <p class="font-semibold text-white text-xs">+2.450,00 DKK</p>
            <span class="text-[9px] text-green font-medium">Goldið</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
