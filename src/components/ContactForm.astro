---
import { fo, products } from "../content/fo";
import { site } from "../content/site";
---

<form class="grid gap-5" data-contact-form>
  <div class="grid gap-5 sm:grid-cols-2">
    <label class="grid gap-2 text-sm font-medium text-white">
      {fo.contact.name}
      <input
        name="name"
        type="text"
        autocomplete="name"
        required
        class="rounded-xl border border-white/15 bg-white/5 px-4 py-3 text-base font-normal text-white outline-none ring-green placeholder:text-white/30 focus:border-green focus:ring-2"
      />
    </label>
    <label class="grid gap-2 text-sm font-medium text-white">
      {fo.contact.company}
      <input
        name="company"
        type="text"
        autocomplete="organization"
        class="rounded-xl border border-white/15 bg-white/5 px-4 py-3 text-base font-normal text-white outline-none ring-green placeholder:text-white/30 focus:border-green focus:ring-2"
      />
    </label>
    <label class="grid gap-2 text-sm font-medium text-white">
      {fo.contact.phone}
      <input
        name="phone"
        type="tel"
        autocomplete="tel"
        class="rounded-xl border border-white/15 bg-white/5 px-4 py-3 text-base font-normal text-white outline-none ring-green placeholder:text-white/30 focus:border-green focus:ring-2"
      />
    </label>
    <label class="grid gap-2 text-sm font-medium text-white">
      {fo.contact.email}
      <input
        name="email"
        type="email"
        autocomplete="email"
        required
        class="rounded-xl border border-white/15 bg-white/5 px-4 py-3 text-base font-normal text-white outline-none ring-green placeholder:text-white/30 focus:border-green focus:ring-2"
      />
    </label>
  </div>

  <label class="grid gap-2 text-sm font-medium text-white">
    {fo.contact.product}
    <select
      name="product"
      class="rounded-xl border border-white/15 bg-navy px-4 py-3 text-base font-normal text-white outline-none ring-green focus:border-green focus:ring-2"
    >
      <option value="">{fo.contact.productAny}</option>
      {
        products.map((product) => (
          <option value={product.eyebrow} data-id={product.id}>
            {product.eyebrow}
          </option>
        ))
      }
    </select>
  </label>

  <label class="grid gap-2 text-sm font-medium text-white">
    {fo.contact.message}
    <textarea
      name="message"
      rows="6"
      required
      class="resize-y rounded-xl border border-white/15 bg-white/5 px-4 py-3 text-base font-normal text-white outline-none ring-green placeholder:text-white/30 focus:border-green focus:ring-2"
    ></textarea>
  </label>

  <p data-form-error class="hidden text-sm text-white" role="alert"></p>

  <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
    <button
      type="submit"
      class="rounded-full bg-green px-6 py-3 text-sm font-semibold text-navy transition hover:brightness-110"
    >
      {fo.contact.submit}
    </button>
    <p class="text-sm text-mist">{fo.contact.mailtoHint}</p>
  </div>
</form>

<script
  define:vars={{
    emailTo: site.email,
    requiredText: fo.contact.required,
    intakeUrl: `${site.appUrl}/api/ahugadir`,
    sentText: fo.contact.sent,
  }}
>
  const form = document.querySelector("[data-contact-form]");
  const error = document.querySelector("[data-form-error]");

  function showMessage(text) {
    if (error instanceof HTMLElement) {
      error.textContent = text;
      error.classList.remove("hidden");
    }
  }

  if (form instanceof HTMLFormElement) {
    const select = form.querySelector("select[name=product]");
    const requested = new URLSearchParams(window.location.search).get("t");
    if (requested && select instanceof HTMLSelectElement) {
      const option = select.querySelector(`[data-id="${requested}"]`);
      if (option instanceof HTMLOptionElement) option.selected = true;
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const name = String(data.get("name") ?? "").trim();
      const company = String(data.get("company") ?? "").trim();
      const phone = String(data.get("phone") ?? "").trim();
      const email = String(data.get("email") ?? "").trim();
      const product = String(data.get("product") ?? "").trim();
      const message = String(data.get("message") ?? "").trim();

      if (!name || !email || !message) {
        showMessage(requiredText);
        return;
      }

      // The product id, not its display label, so the pipeline can group by service.
      const selected =
        select instanceof HTMLSelectElement ? select.selectedOptions[0] : null;
      const productId = selected?.dataset.id ?? "";

      const submit = form.querySelector("button[type=submit]");
      if (submit instanceof HTMLButtonElement) submit.disabled = true;

      try {
        const response = await fetch(intakeUrl, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            name,
            company,
            phone,
            email,
            product: productId,
            message,
          }),
        });
        if (!response.ok) throw new Error("intake rejected");

        form.reset();
        showMessage(sentText);
        return;
      } catch {
        // The platform being unreachable must not lose an enquiry, so fall back to
        // the mail client exactly as before.
        const subject = product ? `Betal: ${product}` : "Betal: samband";
        const body = [
          `Navn: ${name}`,
          company && `Fyritøka: ${company}`,
          phone && `Telefon: ${phone}`,
          `Teldupostur: ${email}`,
          product && `Tænasta: ${product}`,
          "",
          message,
        ]
          .filter((line) => line !== false)
          .join("\n");

        window.location.href = `mailto:${emailTo}?subject=${encodeURIComponent(
          subject,
        )}&body=${encodeURIComponent(body)}`;
      } finally {
        if (submit instanceof HTMLButtonElement) submit.disabled = false;
      }
    });
  }
</script>
