---
import { fo, products } from "../content/fo";
import { site } from "../content/site";
---

<!--
  novalidate suppresses the browser's built-in validation bubbles, which appear
  in the browser's own language rather than Faroese. The fields keep `required`
  so assistive technology still announces them, and the script below reports
  problems using the Faroese copy.
-->
<form class="grid gap-6" novalidate data-contact-form>
  <div class="grid gap-5 sm:grid-cols-2">
    <label class="grid gap-2 text-sm font-medium text-white">
      {fo.contact.name}
      <input
        name="name"
        type="text"
        placeholder={fo.contact.namePlaceholder}
        autocomplete="name"
        required
        class="w-full min-w-0 rounded-2xl border border-white/15 bg-white/[0.04] px-4 py-3.5 text-base font-normal text-white outline-none ring-green/50 placeholder:text-white/30 focus:border-green focus:ring-2 transition"
      />
    </label>
    <label class="grid gap-2 text-sm font-medium text-white">
      {fo.contact.company}
      <input
        name="company"
        type="text"
        placeholder={fo.contact.companyPlaceholder}
        autocomplete="organization"
        class="w-full min-w-0 rounded-2xl border border-white/15 bg-white/[0.04] px-4 py-3.5 text-base font-normal text-white outline-none ring-green/50 placeholder:text-white/30 focus:border-green focus:ring-2 transition"
      />
    </label>
    <label class="grid gap-2 text-sm font-medium text-white">
      {fo.contact.phone}
      <input
        name="phone"
        type="tel"
        placeholder={fo.contact.phonePlaceholder}
        autocomplete="tel"
        class="w-full min-w-0 rounded-2xl border border-white/15 bg-white/[0.04] px-4 py-3.5 text-base font-normal text-white outline-none ring-green/50 placeholder:text-white/30 focus:border-green focus:ring-2 transition"
      />
    </label>
    <label class="grid gap-2 text-sm font-medium text-white">
      {fo.contact.email}
      <input
        name="email"
        type="email"
        placeholder={fo.contact.emailPlaceholder}
        autocomplete="email"
        required
        class="w-full min-w-0 rounded-2xl border border-white/15 bg-white/[0.04] px-4 py-3.5 text-base font-normal text-white outline-none ring-green/50 placeholder:text-white/30 focus:border-green focus:ring-2 transition"
      />
    </label>
  </div>

  <label class="grid gap-2 text-sm font-medium text-white">
    {fo.contact.product}
    <div class="relative">
      <select
        name="product"
        class="w-full min-w-0 appearance-none rounded-2xl border border-white/15 bg-navy px-4 py-3.5 text-base font-normal text-white outline-none ring-green/50 focus:border-green focus:ring-2 transition cursor-pointer"
      >
        <option value="">{fo.contact.productAny}</option>
        {
          products.map((product) => (
            <option value={product.eyebrow} data-id={product.id}>
              {product.eyebrow}
            </option>
          ))
        }
      </select>
      <div class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-white/50">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
      </div>
    </div>
  </label>

  <label class="grid gap-2 text-sm font-medium text-white">
    {fo.contact.message}
    <textarea
      name="message"
      rows="5"
      placeholder={fo.contact.messagePlaceholder}
      required
      class="w-full min-w-0 resize-y rounded-2xl border border-white/15 bg-white/[0.04] px-4 py-3.5 text-base font-normal text-white outline-none ring-green/50 placeholder:text-white/30 focus:border-green focus:ring-2 transition"
    ></textarea>
  </label>

  {/* Bots fill every field they find. Hidden from people and from assistive
      technology, and never reachable by keyboard. */}
  <input
    type="text"
    name="website"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
    class="pointer-events-none absolute h-px w-px opacity-0"
  />

  <p data-form-error class="hidden text-sm text-red-300 bg-red-900/30 border border-red-500/30 rounded-xl p-3" role="alert"></p>

  <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
    <button
      type="submit"
      class="rounded-full bg-green px-8 py-3.5 text-sm font-semibold text-navy transition-all duration-200 hover:brightness-110 hover:shadow-[0_0_20px_rgba(122,217,102,0.4)] active:scale-[0.99] cursor-pointer"
    >
      {fo.contact.submit}
    </button>
    <p class="text-xs text-mist" data-form-hint>{fo.contact.mailtoHint}</p>
  </div>
</form>

<script
  is:inline
  define:vars={{
    emailTo: site.email,
    requiredText: fo.contact.required,
    invalidEmailText: fo.contact.invalidEmail,
    sendingText: fo.contact.sending,
    sentText: fo.contact.sent,
    failedText: fo.contact.sendFailed,
    submitText: fo.contact.submit,
  }}
>
  const form = document.querySelector("[data-contact-form]");
  const error = document.querySelector("[data-form-error]");
  if (form instanceof HTMLFormElement) {
    const select = form.querySelector("select[name=product]");
    const requested = new URLSearchParams(window.location.search).get("t");
    if (requested && select instanceof HTMLSelectElement) {
      const option = select.querySelector(`[data-id="${requested}"]`);
      if (option instanceof HTMLOptionElement) option.selected = true;
    }
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const name = String(data.get("name") ?? "").trim();
      const company = String(data.get("company") ?? "").trim();
      const phone = String(data.get("phone") ?? "").trim();
      const email = String(data.get("email") ?? "").trim();
      const product = String(data.get("product") ?? "").trim();
      const message = String(data.get("message") ?? "").trim();

      const fail = (text, field) => {
        if (error instanceof HTMLElement) {
          error.textContent = text;
          error.classList.remove("hidden");
        }
        const invalid = form.querySelector(`[name=${field}]`);
        if (invalid instanceof HTMLElement) invalid.focus();
      };

      if (!name || !email || !message) {
        fail(requiredText, !name ? "name" : !email ? "email" : "message");
        return;
      }

      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        fail(invalidEmailText, "email");
        return;
      }

      if (error instanceof HTMLElement) error.classList.add("hidden");

      const subject = product ? `Betal: ${product}` : "Betal: samband";
      const bodyLines = [
        `Navn: ${name}`,
        company && `Fyritøka: ${company}`,
        phone && `Telefon: ${phone}`,
        `Teldupostur: ${email}`,
        product && `Tænasta: ${product}`,
        "",
        message,
      ].filter(Boolean);
      const mailto = `mailto:${emailTo}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(bodyLines.join("\n"))}`;

      const submit = form.querySelector("[type=submit]");
      const hint = form.querySelector("[data-form-hint]");
      const say = (text) => {
        if (error instanceof HTMLElement) {
          error.textContent = text;
          error.classList.remove("hidden");
        }
      };

      // Post to our own origin. A mailto: only works for people with a desktop
      // mail client configured, so it is the fallback, never the whole plan.
      if (submit instanceof HTMLButtonElement) {
        submit.disabled = true;
        submit.textContent = sendingText;
      }

      fetch("/api/samband", { method: "POST", body: data })
        .then((response) => {
          if (!response.ok) throw new Error(String(response.status));
          form.reset();
          if (hint instanceof HTMLElement) hint.remove();
          say(sentText);
          if (error instanceof HTMLElement) {
            error.classList.remove("text-red-300");
            error.classList.add("text-green");
          }
          if (submit instanceof HTMLButtonElement) submit.remove();
        })
        .catch(() => {
          // Never leave the sender with nothing: open their mail client if they
          // have one, and show the address either way.
          say(failedText + " " + emailTo);
          window.location.href = mailto;
          if (submit instanceof HTMLButtonElement) {
            submit.disabled = false;
            submit.textContent = submitText;
          }
        });
    });
  }
</script>
