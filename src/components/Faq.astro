---
interface Item {
  q: string;
  a: string;
}

interface Props {
  items: readonly Item[];
}

const { items } = Astro.props;
---

<div class="divide-y divide-white/10 border-y border-white/10" data-reveal-group="60">
  {
    items.map((item, i) => (
      <details class="faq-item group" open={i === 0} data-reveal>
        <summary class="flex items-start justify-between gap-6 py-6 outline-none transition-colors hover:text-green focus-visible:text-green">
          <span class="text-base font-semibold text-white sm:text-lg group-open:text-green">{item.q}</span>
          <span class="mt-0.5 grid h-7 w-7 shrink-0 place-items-center rounded-full border border-white/15 bg-white/[0.04] text-white/70 transition-transform duration-300 faq-icon">
            <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M8 3v10M3 8h10" stroke-linecap="round" />
            </svg>
          </span>
        </summary>
        <p class="max-w-3xl pb-6 text-sm leading-relaxed text-white/65 sm:text-base">{item.a}</p>
      </details>
    ))
  }
</div>
