---
import { fo } from "../content/fo";
import { site } from "../content/site";

interface Item {
  q: string;
  a: string;
}

interface Props {
  items: readonly Item[];
}

const { items } = Astro.props;
---

<div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
  <div class="lg:sticky lg:top-28 lg:self-start" data-reveal>
    <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-green">{fo.faq.eyebrow}</p>
    <h2 class="mt-3 text-3xl font-bold leading-[1.05] tracking-[-0.03em] text-white sm:text-[2.75rem]">
      {fo.faq.title}
    </h2>
    <p class="mt-5 text-sm leading-relaxed text-white/55">
      Finnur tú ikki svarið?
      <a href={`mailto:${site.email}`} class="font-semibold text-green underline-offset-4 hover:underline">
        Skriva til okkara
      </a>
      — vit svara á føroyskum.
    </p>
  </div>

  <div class="divide-y divide-white/10 border-t border-white/10" data-reveal-group="60">
    {
      items.map((item, i) => (
        <details class="faq-item group" open={i === 0} data-reveal>
          <summary class="flex items-start justify-between gap-6 py-5 outline-none">
            <span class="text-base font-semibold text-white transition-colors duration-200 group-hover:text-green group-open:text-green sm:text-lg">
              {item.q}
            </span>
            <span class="faq-icon mt-0.5 grid h-7 w-7 shrink-0 place-items-center rounded-full border border-white/15 bg-white/[0.04] text-white/70 transition-transform duration-300 group-hover:border-green/40 group-hover:text-green">
              <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M8 3v10M3 8h10" stroke-linecap="round" />
              </svg>
            </span>
          </summary>
          <p class="max-w-2xl pb-6 text-sm leading-relaxed text-white/60 sm:text-[0.95rem]">{item.a}</p>
        </details>
      ))
    }
  </div>
</div>
