---
import Logo from "./Logo.astro";
import { fo, products } from "../content/fo";
import { site } from "../content/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-gradient-to-b from-transparent to-[#080020]">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:px-8 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <Logo />
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-mist">{fo.footer.tagline}</p>
      
      <div class="mt-6 flex flex-col gap-1 text-xs">
        <span class="text-white/40">Føroyskt samband</span>
        <a href={`mailto:${site.email}`} class="inline-block text-sm font-semibold text-green hover:underline">
          {site.email}
        </a>
      </div>
    </div>

    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-mist">{fo.footer.products}</p>
      <ul class="mt-4 space-y-2.5">
        {
          products.map((product) => (
            <li>
              <a href={product.href} class="text-sm text-white/80 transition hover:text-green hover:translate-x-0.5 inline-block">
                {product.eyebrow}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-mist">{fo.footer.legal}</p>
      <ul class="mt-4 space-y-2.5">
        <li>
          <a href="/samband/" class="text-sm text-white/80 transition hover:text-green hover:translate-x-0.5 inline-block">{fo.footer.contact}</a>
        </li>
        <li>
          <a href="/privativ/" class="text-sm text-white/80 transition hover:text-green hover:translate-x-0.5 inline-block">{fo.footer.privacy}</a>
        </li>
      </ul>
    </div>
  </div>
  
  <div class="mx-auto max-w-6xl border-t border-white/10 px-5 py-6 text-xs text-mist sm:px-8 flex flex-col sm:flex-row items-center justify-between gap-3">
    <span>© {year} {site.name} • Allar rættindi tilskilað</span>
    <span class="text-white/40 font-mono text-[11px]">Bygt á ePay & Softpay tøkni</span>
  </div>
</footer>
