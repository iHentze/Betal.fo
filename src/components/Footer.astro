---
import Logo from "./Logo.astro";
import { fo, products } from "../content/fo";
import { site } from "../content/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-white/10">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:px-8 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <Logo />
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-mist">{fo.footer.tagline}</p>
      <a href={`mailto:${site.email}`} class="mt-4 inline-block text-sm text-white hover:text-green">
        {site.email}
      </a>
    </div>

    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-mist">{fo.footer.products}</p>
      <ul class="mt-4 space-y-2">
        {
          products.map((product) => (
            <li>
              <a href={product.href} class="text-sm text-white/85 hover:text-white">
                {product.eyebrow}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-mist">{fo.footer.legal}</p>
      <ul class="mt-4 space-y-2">
        <li>
          <a href="/samband/" class="text-sm text-white/85 hover:text-white">{fo.footer.contact}</a>
        </li>
        <li>
          <a href="/privativ/" class="text-sm text-white/85 hover:text-white">{fo.footer.privacy}</a>
        </li>
      </ul>
    </div>
  </div>
  <div class="mx-auto max-w-6xl border-t border-white/10 px-5 py-5 text-xs text-mist sm:px-8">
    © {year} {site.name}
  </div>
</footer>
