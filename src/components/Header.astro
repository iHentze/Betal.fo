---
import Logo from "./Logo.astro";
import { fo, products } from "../content/fo";

const path = Astro.url.pathname;
---

<header
  class="sticky top-0 z-50 border-b border-white/8 bg-navy/70 backdrop-blur-xl transition-colors duration-300 data-[stuck]:border-white/12 data-[stuck]:bg-navy/95 data-[stuck]:shadow-[0_10px_40px_-20px_rgba(0,0,0,0.9)]"
  data-header
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:h-[4.5rem] sm:px-8">
    <Logo />

    <nav class="hidden items-center gap-3 lg:flex" aria-label="Valmynd">
      {/* The links sit in one capsule so the nav reads as a single object
          rather than three loose words; the current page is a filled pill
          inside it rather than a hairline underneath. */}
      <div class="flex items-center rounded-full border border-white/[0.07] bg-white/[0.055] p-1">
        {
          products.map((product) => {
            const active = path.startsWith(product.href);
            return (
              <a
                href={product.href}
                aria-current={active ? "page" : undefined}
                class:list={[
                  "relative rounded-full px-3.5 py-1.5 text-sm font-medium transition-colors duration-200",
                  active ? "text-white" : "text-white/65 hover:text-white",
                ]}
              >
                {/* The pill is its own element, carrying a view-transition-name.
                    Only one link is ever active, so the name is unique per page
                    and the browser interpolates it from its old position to its
                    new one on navigation — it slides across the capsule. Keeping
                    it separate from the label means only the background moves;
                    the text is not stretched between two different words. */}
                {active && (
                  <span
                    style="view-transition-name: nav-pill"
                    class="absolute inset-0 rounded-full bg-white/[0.1] shadow-[inset_0_1px_0_rgb(255_255_255/0.09)]"
                    aria-hidden="true"
                  />
                )}
                <span class="relative">{product.nav}</span>
              </a>
            );
          })
        }
      </div>
      <a
        href="/samband/"
        class="rounded-full bg-green px-5 py-2.5 text-sm font-semibold text-navy transition-all duration-300 active:scale-[0.98] hover:brightness-[1.08] hover:shadow-[0_0_25px_-6px_rgba(123,216,101,0.7)]"
      >
        {fo.nav.contact}
      </a>
    </nav>

    <button
      type="button"
      class="group inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/15 bg-white/[0.04] text-white transition hover:bg-white/[0.09] aria-expanded:border-white/25 aria-expanded:bg-white/[0.09] lg:hidden"
      data-menu-button
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="sr-only">{fo.nav.menu}</span>
      {/* The button is a toggle, so the icon has to say which way it goes.
          Both glyphs are in the DOM and the expanded state picks one. */}
      <svg class="h-5 w-5 group-aria-expanded:hidden" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
      <svg class="hidden h-5 w-5 group-aria-expanded:block" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

</header>

{/* The sheet lives outside <header> on purpose: the header's backdrop-filter
    makes it a containing block for fixed descendants, so a fixed sheet inside
    it would be positioned against the header rather than the viewport. */}
<div data-menu-root class="lg:hidden">
  <button
    type="button"
    data-menu-close
    tabindex="-1"
    aria-hidden="true"
    class="fixed inset-0 z-40 cursor-default bg-navy-deep/65 backdrop-blur-[2px]"
  ></button>

  <div
    id="mobile-menu"
    role="dialog"
    aria-modal="true"
    aria-label={fo.nav.menu}
    class="fixed inset-x-0 bottom-0 z-50 rounded-t-[1.75rem] border-t border-white/12 bg-navy-soft px-5 pb-[max(1.5rem,env(safe-area-inset-bottom))] pt-3 shadow-[0_-24px_60px_-24px_rgba(0,0,0,0.95)]"
  >
    <span class="mx-auto mb-4 block h-1 w-10 rounded-full bg-white/20" aria-hidden="true"></span>

    <nav class="flex flex-col" aria-label={fo.nav.menu}>
      {
        products.map((product) => {
          const active = path.startsWith(product.href);
          return (
            <a
              href={product.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "flex items-center justify-between border-b border-white/8 py-4 text-base transition-colors",
                active ? "font-semibold text-green" : "font-medium text-white",
              ]}
            >
              {product.nav}
              <span class="text-white/30" aria-hidden="true">→</span>
            </a>
          );
        })
      }
      <a
        href="/samband/"
        class="mt-5 rounded-2xl bg-green px-4 py-4 text-center text-base font-semibold text-navy"
      >
        {fo.nav.contact}
      </a>
    </nav>
  </div>
</div>

<script>
  /*
   * Re-run on every client-side navigation, not just the first load: the header
   * is re-rendered each time, so its buttons are new elements.
   */
  function initHeader() {
    const button = document.querySelector<HTMLButtonElement>("[data-menu-button]");
    const root = document.querySelector<HTMLElement>("[data-menu-root]");
    const sheet = document.getElementById("mobile-menu");

    if (button && root && sheet) {
      const setOpen = (open: boolean) => {
        root.toggleAttribute("data-open", open);
        button.setAttribute("aria-expanded", String(open));
        // Holds the page still behind the sheet rather than letting both scroll.
        document.documentElement.toggleAttribute("data-menu-locked", open);
        // Closed, the sheet is off screen but still in the document, so its
        // links would otherwise stay tabbable behind the page.
        sheet.inert = !open;
      };

      setOpen(false);

      button.addEventListener("click", () => setOpen(!root.hasAttribute("data-open")));

      // Tapping the dimmed page, or any link in the sheet, closes it.
      root.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        if (target.closest("[data-menu-close]") || target.closest("a")) setOpen(false);
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && root.hasAttribute("data-open")) {
          setOpen(false);
          button.focus();
        }
      });
    }

    const header = document.querySelector<HTMLElement>("[data-header]");
    if (!header) return;

    const onScroll = () => {
      if (window.scrollY > 8) header.setAttribute("data-stuck", "");
      else header.removeAttribute("data-stuck");
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });

    // The listener is on window, which survives the swap, so it has to be
    // removed before the next page adds its own — otherwise they stack up.
    document.addEventListener(
      "astro:before-swap",
      () => {
        window.removeEventListener("scroll", onScroll);
        // Never leave the page locked if a link was followed from the sheet.
        document.documentElement.removeAttribute("data-menu-locked");
      },
      { once: true },
    );
  }

  document.addEventListener("astro:page-load", initHeader);
</script>
