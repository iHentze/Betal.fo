---
import Logo from "./Logo.astro";
import { fo, products } from "../content/fo";

const path = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-[#0D0033]/85 backdrop-blur-xl transition-all">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:h-[4.5rem] sm:px-8">
    <Logo />

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Høvuðsvalmynd">
      {
        products.map((product) => (
          <a
            href={product.href}
            class:list={[
              "text-sm font-medium tracking-wide transition-all duration-200 hover:text-green relative py-1",
              path.startsWith(product.href) ? "text-green font-semibold" : "text-white/80",
            ]}
          >
            {product.nav}
            {path.startsWith(product.href) && (
              <span class="absolute bottom-0 left-0 right-0 h-0.5 bg-green rounded-full"></span>
            )}
          </a>
        ))
      }
      <a
        href="/samband/"
        class="rounded-full bg-green px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-navy transition-all duration-200 hover:brightness-110 hover:shadow-[0_0_20px_rgba(122,217,102,0.35)]"
      >
        {fo.nav.contact}
      </a>
    </nav>

    <button
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/20 bg-white/5 text-white lg:hidden transition hover:bg-white/10"
      data-menu-button
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="sr-only">{fo.nav.menu}</span>
      <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-white/10 bg-[#0D0033]/95 backdrop-blur-2xl lg:hidden" hidden>
    <nav class="mx-auto flex max-w-6xl flex-col gap-1.5 px-5 py-5" aria-label="Fartelefonvalmynd">
      {
        products.map((product) => (
          <a
            href={product.href}
            class:list={[
              "rounded-xl px-3 py-3 text-base font-medium transition",
              path.startsWith(product.href) ? "bg-green/10 text-green font-semibold" : "text-white/90 hover:bg-white/5",
            ]}
          >
            {product.nav}
          </a>
        ))
      }
      <a
        href="/samband/"
        class="mt-3 rounded-xl bg-green px-4 py-3.5 text-center text-sm font-bold uppercase tracking-wider text-navy shadow-lg shadow-green/20"
      >
        {fo.nav.contact}
      </a>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector("[data-menu-button]");
  const menu = document.getElementById("mobile-menu");
  if (button instanceof HTMLButtonElement && menu) {
    button.addEventListener("click", () => {
      const open = menu.hasAttribute("hidden") === false;
      if (open) {
        menu.hidden = true;
        menu.classList.add("hidden");
        button.setAttribute("aria-expanded", "false");
      } else {
        menu.hidden = false;
        menu.classList.remove("hidden");
        button.setAttribute("aria-expanded", "true");
      }
    });
  }
</script>
