---
import Logo from "./Logo.astro";
import { fo, products } from "../content/fo";

const path = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-navy/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:h-[4.25rem] sm:px-8">
    <Logo />

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Høvuðsvalmynd">
      {
        products.map((product) => (
          <a
            href={product.href}
            class:list={[
              "text-sm font-medium tracking-wide text-white/80 transition-colors hover:text-white",
              path.startsWith(product.href) && "text-white",
            ]}
          >
            {product.nav}
          </a>
        ))
      }
      <a
        href="/samband/"
        class="rounded-full bg-green px-4 py-2 text-sm font-semibold text-navy transition hover:brightness-110"
      >
        {fo.nav.contact}
      </a>
    </nav>

    <button
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/20 text-white lg:hidden"
      data-menu-button
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="sr-only">{fo.nav.menu}</span>
      <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-white/10 bg-navy lg:hidden" hidden>
    <nav class="mx-auto flex max-w-6xl flex-col gap-1 px-5 py-4" aria-label="Fartelefonvalmynd">
      {
        products.map((product) => (
          <a href={product.href} class="rounded-lg px-2 py-3 text-lg font-medium text-white hover:bg-white/5">
            {product.nav}
          </a>
        ))
      }
      <a
        href="/samband/"
        class="mt-2 rounded-full bg-green px-4 py-3 text-center text-base font-semibold text-navy"
      >
        {fo.nav.contact}
      </a>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector("[data-menu-button]");
  const menu = document.getElementById("mobile-menu");
  if (button instanceof HTMLButtonElement && menu) {
    button.addEventListener("click", () => {
      const open = menu.hasAttribute("hidden") === false;
      if (open) {
        menu.hidden = true;
        menu.classList.add("hidden");
        button.setAttribute("aria-expanded", "false");
      } else {
        menu.hidden = false;
        menu.classList.remove("hidden");
        button.setAttribute("aria-expanded", "true");
      }
    });
  }
</script>
