---
import Logo from "./Logo.astro";
import { fo, products } from "../content/fo";

const path = Astro.url.pathname;
---

<header
  class="sticky top-0 z-50 border-b border-white/8 bg-navy/70 backdrop-blur-xl transition-colors duration-300 data-[stuck]:border-white/12 data-[stuck]:bg-navy/95 data-[stuck]:shadow-[0_10px_40px_-20px_rgba(0,0,0,0.9)]"
  data-header
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:h-[4.5rem] sm:px-8">
    <Logo />

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Høvuðsvalmynd">
      {
        products.map((product) => {
          const active = path.startsWith(product.href);
          return (
            <a
              href={product.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "relative rounded-full px-3.5 py-2 text-sm font-medium transition-colors duration-200",
                active ? "text-green" : "text-white/70 hover:text-white",
              ]}
            >
              {product.nav}
              {active && (
                <span class="absolute inset-x-3.5 -bottom-0.5 h-px rounded-full bg-green" aria-hidden="true" />
              )}
            </a>
          );
        })
      }
      <a
        href="/samband/"
        class="ml-3 rounded-full bg-green btn-green px-5 py-2.5 text-xs font-bold uppercase tracking-[0.12em] text-navy transition-all duration-300 active:scale-[0.98] hover:brightness-[1.08] hover:shadow-[0_0_25px_-6px_rgba(123,216,101,0.7)]"
      >
        {fo.nav.contact}
      </a>
    </nav>

    <button
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/15 bg-white/[0.04] text-white transition hover:bg-white/[0.09] lg:hidden"
      data-menu-button
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="sr-only">{fo.nav.menu}</span>
      <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-white/8 bg-navy/95 backdrop-blur-2xl lg:hidden" hidden>
    <nav class="mx-auto flex max-w-6xl flex-col gap-1 px-5 py-5" aria-label="Valmynd á fartelefon">
      {
        products.map((product) => {
          const active = path.startsWith(product.href);
          return (
            <a
              href={product.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "rounded-xl px-3.5 py-3 text-base font-medium transition-colors",
                active ? "bg-green/10 font-semibold text-green" : "text-white/85 hover:bg-white/5",
              ]}
            >
              {product.nav}
            </a>
          );
        })
      }
      <a
        href="/samband/"
        class="mt-3 rounded-xl bg-green btn-green px-4 py-3.5 text-center text-sm font-bold uppercase tracking-[0.12em] text-navy"
      >
        {fo.nav.contact}
      </a>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-menu-button]");
  const menu = document.getElementById("mobile-menu");

  if (button && menu) {
    button.addEventListener("click", () => {
      const open = !menu.hasAttribute("hidden");
      menu.hidden = open;
      menu.classList.toggle("hidden", open);
      button.setAttribute("aria-expanded", String(!open));
    });

    // Close the menu when a link is followed or the viewport grows to desktop.
    menu.addEventListener("click", (event) => {
      if (!(event.target instanceof HTMLAnchorElement)) return;
      menu.hidden = true;
      menu.classList.add("hidden");
      button.setAttribute("aria-expanded", "false");
    });
  }

  const header = document.querySelector<HTMLElement>("[data-header]");
  if (header) {
    const onScroll = () => {
      if (window.scrollY > 8) header.setAttribute("data-stuck", "");
      else header.removeAttribute("data-stuck");
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
