---
/**
 * Hero showcase: the animated payment window with live "payment received"
 * notifications above and below it. They deliberately clear the window's own
 * bounds so nothing covers the payment UI.
 */
import AnimatedCheckout from "./AnimatedCheckout.astro";
import { methods } from "../content/methods";

const applePay = methods.find((m) => m.name === "Apple Pay")!;
const googlePay = methods.find((m) => m.name === "Google Pay")!;

const notes = [
  {
    mark: applePay,
    markClass: "h-6",
    channel: "Nethandil",
    amount: "+349,00",
    place: "bottom-full mb-4 left-0 sm:-left-10",
    drift: "note-a",
  },
  {
    mark: googlePay,
    markClass: "h-5",
    channel: "Á staðnum",
    amount: "+120,00",
    place: "top-full mt-4 right-0 sm:-right-8",
    drift: "note-b",
  },
];
---

<div class="relative w-full max-w-[23rem]">
  <AnimatedCheckout />

  {
    notes.map((note) => (
      <div class:list={["pointer-events-none absolute z-20", note.place, note.drift]} aria-hidden="true">
        <div class="flex items-center gap-3 rounded-2xl border border-white/12 bg-navy/85 px-3.5 py-2.5 shadow-[0_18px_40px_-18px_rgba(0,0,0,0.9)] backdrop-blur-xl">
          <svg
            viewBox={note.mark.viewBox}
            class:list={[note.markClass, "w-auto shrink-0 text-white/85"]}
            fill="currentColor"
            aria-hidden="true"
          >
            <path d={note.mark.path} />
          </svg>
          <span class="text-[10px] whitespace-nowrap text-white/45">{note.channel}</span>
          <span class="tnum text-[11px] font-bold whitespace-nowrap text-green">{note.amount}</span>
        </div>
      </div>
    ))
  }
</div>

<style>
  /* No entrance animation — the notifications are simply present. They only
     drift, gently and out of phase with each other. */
  .note-a > div {
    animation: drift 7s ease-in-out infinite;
  }

  .note-b > div {
    animation: drift 8.5s ease-in-out 1.4s infinite reverse;
  }

  @keyframes drift {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-7px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .note-a > div,
    .note-b > div {
      animation: none;
    }
  }
</style>
