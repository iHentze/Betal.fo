---
/**
 * Hero showcase: the animated payment window with live "payment received"
 * notifications sitting above and below it. They deliberately clear the
 * window's own bounds so nothing covers the payment UI.
 */
import AnimatedCheckout from "./AnimatedCheckout.astro";

const notes = [
  {
    tag: "AP",
    title: "Apple Pay",
    amount: "+349,00",
    place: "bottom-full mb-4 left-0 sm:-left-10",
    delay: "1.1s",
    drift: "note-a",
  },
  {
    tag: "SP",
    title: "Softpay",
    amount: "+120,00",
    place: "top-full mt-4 right-0 sm:-right-8",
    delay: "1.9s",
    drift: "note-b",
  },
];
---

<div class="relative w-full max-w-[23rem]">
  <AnimatedCheckout />

  {
    notes.map((note) => (
      <div
        class:list={["pointer-events-none absolute z-20 opacity-0", note.place, note.drift]}
        style={`animation-delay:${note.delay}`}
        aria-hidden="true"
      >
        <div class="flex items-center gap-2.5 rounded-2xl border border-white/12 bg-navy/85 px-3.5 py-2.5 shadow-[0_18px_40px_-18px_rgba(0,0,0,0.9)] backdrop-blur-xl">
          <span class="grid h-7 w-7 place-items-center rounded-lg bg-green/12 font-mono text-[9px] font-bold text-green">
            {note.tag}
          </span>
          <span class="text-[11px] font-semibold whitespace-nowrap text-white">{note.title}</span>
          <span class="text-[11px] font-bold whitespace-nowrap text-green">{note.amount}</span>
        </div>
      </div>
    ))
  }
</div>

<style>
  .note-a,
  .note-b {
    animation: note-in 0.7s var(--ease-spring) forwards;
  }

  @keyframes note-in {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.94);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Settle, then drift gently and out of phase with each other. */
  .note-a > div {
    animation: drift 7s ease-in-out 2.2s infinite;
  }

  .note-b > div {
    animation: drift 8.5s ease-in-out 3s infinite reverse;
  }

  @keyframes drift {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-7px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .note-a,
    .note-b {
      opacity: 1;
      animation: none;
    }

    .note-a > div,
    .note-b > div {
      animation: none;
    }
  }
</style>
