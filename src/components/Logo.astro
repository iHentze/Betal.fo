---
import Wordmark from "./Wordmark.astro";

/**
 * The betal wordmark, linked home.
 *
 * The mark is the brand-guide artwork rather than type set in a UI font, so it does
 * not depend on Poppins having loaded and cannot drift as the font stack changes.
 */
interface Props {
  class?: string;
  /** Tailwind text colour class; the wordmark inherits currentColor. */
  wordClass?: string;
  width?: string;
}

const {
  class: className = "",
  wordClass = "text-green",
  width = "6.5rem",
} = Astro.props;
---

<a
  href="/"
  class:list={["inline-flex items-center no-underline", wordClass, className]}
  aria-label="betal, heim"
>
  <Wordmark width={width} />
</a>
