---
interface Props {
  class?: string;
  markClass?: string;
  wordClass?: string;
}

const { class: className = "", markClass = "text-green", wordClass = "text-white" } = Astro.props;
---

<a href="/" class:list={["inline-flex items-center gap-2.5 no-underline", className]} aria-label="betal, heim">
  <svg
    class:list={["h-8 w-8 shrink-0", markClass]}
    viewBox="0 0 32 32"
    fill="currentColor"
    aria-hidden="true"
  >
    <path
      d="M11.2 5.2h6.1c4.4 0 7.3 2.5 7.3 6.3 0 2.4-1.3 4.3-3.4 5.3 2.6 1 4.2 3.1 4.2 5.8 0 4.2-3.2 6.9-8 6.9H11.2V5.2Zm4.4 8.9h1.6c1.9 0 3-1 3-2.5s-1.1-2.4-3-2.4h-1.6v4.9Zm0 8.4h2c2.1 0 3.4-1.1 3.4-2.8s-1.3-2.7-3.4-2.7h-2v5.5Z"
    />
  </svg>
  <span class:list={["text-[1.65rem] font-light leading-none tracking-tight", wordClass]}>betal</span>
</a>
