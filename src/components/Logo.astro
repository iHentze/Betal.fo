---
interface Props {
  class?: string;
  variant?: "green" | "navy";
}

const { class: className = "", variant = "green" } = Astro.props;
const src = variant === "navy" ? "/brand/wordmark-navy.svg" : "/brand/wordmark-green.svg";
---

<a href="/" class:list={["inline-flex items-center no-underline", className]} aria-label="betal, heim">
  <img src={src} alt="" class="h-8 w-auto sm:h-9" />
</a>
