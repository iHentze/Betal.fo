---
import { BETAL_PATH_B } from "../content/logo";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const methods = [
  "Visa",
  "Mastercard",
  "Apple&nbsp;Pay",
  "Google&nbsp;Pay",
  "Dankort",
  "Maestro",
  "Nándgjald / NFC",
  "Gjaldsleinki",
  "Haldgjøld",
];
---

<div class:list={["marquee-mask overflow-hidden", className]}>
  <ul class="marquee items-center gap-3 pr-3" aria-label="Gjaldshættir">
    {
      [0, 1].map((pass) =>
        methods.map((method) => (
          <li
            class="flex shrink-0 items-center gap-2 rounded-full border border-white/10 bg-white/[0.035] px-4 py-2 text-xs font-medium whitespace-nowrap text-white/75"
            aria-hidden={pass === 1 ? "true" : undefined}
          >
            <svg viewBox="0 0 26.8 49.15" class="h-3 w-auto text-green" fill="currentColor" aria-hidden="true">
              <path d={BETAL_PATH_B} />
            </svg>
            <span set:html={method} />
          </li>
        )),
      )
    }
  </ul>
</div>
