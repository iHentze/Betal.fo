---
import { fo } from "../content/fo";
---

<section class="border-y border-white/10">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-5 py-8 sm:flex-row sm:items-center sm:justify-between sm:px-8">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-mist">{fo.methods.label}</p>
    <ul class="flex flex-wrap gap-2">
      {
        fo.methods.items.map((method) => (
          <li class="rounded-full border border-white/15 px-3 py-1.5 text-xs font-semibold text-white">{method}</li>
        ))
      }
    </ul>
  </div>
</section>
