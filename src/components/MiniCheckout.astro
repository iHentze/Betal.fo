---
/**
 * Compact, non-interactive payment window used as artwork inside cards.
 */
import { methods } from "../content/methods";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const googlePay = methods.find((m) => m.name === "Google Pay")!;

const APPLE_GLYPH =
  "M150.37 130.25c-2.45 5.66-5.35 10.87-8.71 15.66-4.58 6.53-8.33 11.05-11.22 13.56-4.48 4.12-9.28 6.23-14.42 6.35-3.69 0-8.14-1.05-13.32-3.18-5.19-2.12-9.97-3.17-14.34-3.17-4.58 0-9.49 1.05-14.75 3.17-5.26 2.13-9.5 3.24-12.74 3.35-4.35.13-9.16-1.9-14.42-6.08-3.69-3.04-7.69-7.86-12-14.46-6.09-9.35-10.86-19.9-14.32-31.65-3.46-11.75-5.19-22.85-5.19-33.3 0-13.48 3.51-24.66 10.53-33.53 7.02-8.87 15.83-13.39 26.43-13.56 5.13.12 10.56 1.44 16.3 3.97 5.74 2.53 9.4 3.86 10.98 3.97 1.35-.11 5.19-1.49 11.53-4.13 6.34-2.64 11.95-3.85 16.84-3.63 12.18.98 21.68 5.68 28.5 14.1-10.76 6.53-16.03 15.44-15.82 26.74.22 8.91 3.58 16.42 10.09 22.52 6.51 6.1 14.19 9.68 23.04 10.77-2.39 7.18-5.33 14.46-8.81 21.84zM119.22 33.74c0-7.39 2.61-14.13 7.84-20.21 5.23-6.09 11.85-10.22 19.86-12.4 1.09 6.85.05 13.59-3.12 20.21-3.17 6.63-8.21 11.74-15.12 15.33-.87-.87-1.96-1.52-3.26-1.96-3.8-1.3-6.2-1.96-7.2-1.96z";
---

<div
  class:list={[
    "w-[19rem] shrink-0 overflow-hidden rounded-2xl border border-white/12 bg-navy/90 shadow-[0_24px_60px_-24px_rgba(0,0,0,0.9)] backdrop-blur-xl",
    className,
  ]}
  aria-hidden="true"
>
  <div class="h-[3px] w-full bg-gradient-to-r from-transparent via-green to-transparent"></div>

  <div class="flex items-center justify-between border-b border-white/8 px-4 py-2.5">
    <span class="text-[10px] font-semibold text-white/70">Trygt gjald</span>
    <span class="text-[11px] font-bold text-white">499,00 kr.</span>
  </div>

  <div class="space-y-2.5 p-4">
    <div class="grid grid-cols-2 gap-2">
      <div class="flex items-center justify-center gap-1 rounded-lg bg-white py-2 text-[10px] font-semibold text-black">
        <svg class="h-3 w-auto fill-current" viewBox="0 0 170 170" aria-hidden="true">
          <path d={APPLE_GLYPH} />
        </svg>
        <span>Pay</span>
      </div>
      <div class="flex items-center justify-center rounded-lg border border-white/12 bg-white/8 py-2">
        <svg viewBox={googlePay.viewBox} class="h-3 w-auto text-white" fill="currentColor" aria-hidden="true">
          <path d={googlePay.path} />
        </svg>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <span class="h-px flex-1 bg-white/10"></span>
      <span class="text-[8px] uppercase tracking-widest text-white/30">ella við korti</span>
      <span class="h-px flex-1 bg-white/10"></span>
    </div>

    <div class="flex items-center justify-between rounded-lg border border-green/35 bg-green/[0.06] px-3 py-2">
      <span class="font-mono text-[10px] tracking-wide text-white">4571 8842 1907 8820</span>
      <span class="rounded bg-green/20 px-1.5 py-0.5 text-[7px] font-bold text-green">VISA</span>
    </div>

    <div class="grid grid-cols-2 gap-2">
      <div class="rounded-lg border border-white/10 bg-white/[0.04] px-3 py-2 font-mono text-[10px] text-white">
        08 / 29
      </div>
      <div class="rounded-lg border border-white/10 bg-white/[0.04] px-3 py-2 font-mono text-[10px] text-white">
        •••
      </div>
    </div>

    <div class="rounded-lg bg-green btn-green py-2 text-center text-[10px] font-bold text-navy">Rinda 499,00 kr.</div>
  </div>
</div>
