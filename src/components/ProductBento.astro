---
import { fo, products } from "../content/fo";
import { productIcons, type ProductIconId } from "../content/brand";
---

<div class="grid gap-5 md:grid-cols-3" data-reveal-group="90">
  {
    products.map((product, i) => {
      const icon = productIcons[product.id as ProductIconId];
      const soon = "comingSoon" in product && product.comingSoon;
      return (
        <a
          href={product.href}
          class="spotlight group relative flex min-h-[16rem] flex-col justify-between overflow-hidden rounded-[1.75rem] border border-white/10 bg-gradient-to-b from-white/[0.05] to-white/[0.012] p-7 transition-all duration-500 hover:-translate-y-1 hover:border-green/40"
          data-reveal
        >
          <span class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-green/70 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100" />

          <div class="flex items-start justify-between gap-3">
            <span class="font-mono text-[11px] font-semibold tracking-[0.2em] text-white/30">
              {String(i + 1).padStart(2, "0")}
            </span>
            {soon && (
              <span class="rounded-full border border-green/30 bg-green/10 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.1em] text-green">
                {fo.comingSoon}
              </span>
            )}
          </div>

          {icon && (
            <span class="mt-5 grid h-14 w-14 place-items-center rounded-2xl border border-white/10 bg-white/[0.03] p-2 transition-transform duration-500 group-hover:scale-105 group-hover:border-green/30">
              <img src={icon.src} alt="" class="h-9 w-auto object-contain" loading="lazy" />
            </span>
          )}

          <div class="mt-6">
            <h3 class="text-xl font-bold tracking-[-0.02em] text-white transition-colors duration-300 group-hover:text-green">
              {product.eyebrow}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-white/60">{product.card}</p>
            <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-green">
              {fo.home.explore}
              <span class="transition-transform duration-300 group-hover:translate-x-1.5" aria-hidden="true">
                →
              </span>
            </span>
          </div>
        </a>
      );
    })
  }
</div>
