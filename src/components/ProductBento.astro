---
import { fo, products } from "../content/fo";
import { productIcons, type ProductIconId } from "../content/brand";
import MiniCheckout from "./MiniCheckout.astro";

const [lead, ...rest] = products;
const leadIcon = productIcons[lead.id as ProductIconId];
---

<div class="grid gap-5" data-reveal-group="90">
  <!-- Flagship card, with live product artwork bleeding out of the corner -->
  <a
    href={lead.href}
    class="spotlight group relative grid overflow-hidden rounded-[1.75rem] border border-white/10 bg-gradient-to-br from-white/[0.06] to-white/[0.012] transition-all duration-500 hover:border-green/40 md:grid-cols-[1fr_auto]"
    data-reveal
  >
    <span
      class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-green/70 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"
    ></span>

    <div class="p-7 sm:p-9">
      <div class="flex items-center gap-3">
        <span class="font-mono text-[11px] font-semibold tracking-[0.2em] text-white/30">01</span>
        {
          leadIcon && (
            <span class="grid h-11 w-11 place-items-center rounded-xl border border-white/10 bg-white/[0.03] p-1.5 transition-transform duration-500 group-hover:scale-105">
              <img src={leadIcon.src} alt="" class="h-7 w-auto object-contain" loading="lazy" />
            </span>
          )
        }
      </div>

      <h3
        class="mt-6 text-2xl font-bold tracking-[-0.02em] text-white transition-colors duration-300 group-hover:text-green sm:text-3xl"
      >
        {lead.eyebrow}
      </h3>
      <p class="mt-3 max-w-md text-sm leading-relaxed text-white/60">{lead.lead}</p>

      <ul class="mt-6 flex flex-wrap gap-2">
        {
          ["Gjaldsvindeyga", "Gjaldsleinki", "Apple Pay", "Google Pay"].map((tag) => (
            <li class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1.5 text-[11px] text-white/65">
              {tag}
            </li>
          ))
        }
      </ul>

      <span class="mt-7 inline-flex items-center gap-2 text-sm font-semibold text-green">
        Kanna loysn
        <span class="transition-transform duration-300 group-hover:translate-x-1.5" aria-hidden="true">→</span>
      </span>
    </div>

    <!-- Artwork column: cropped so the window reads as a real screen -->
    <div class="relative hidden min-h-[19rem] w-[21rem] overflow-hidden md:block">
      <div
        class="absolute -right-6 top-9 transition-transform duration-700 group-hover:-translate-y-2 group-hover:rotate-[-1deg]"
      >
        <MiniCheckout />
      </div>
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-navy/80 via-transparent to-transparent"></div>
    </div>
  </a>

  <!-- Remaining products -->
  <div class="grid gap-5 md:grid-cols-3">
    {
      rest.map((product, i) => {
        const icon = productIcons[product.id as ProductIconId];
        const soon = "comingSoon" in product && product.comingSoon;
        return (
          <a
            href={product.href}
            class="spotlight group relative flex min-h-[15rem] flex-col justify-between overflow-hidden rounded-[1.75rem] border border-white/10 bg-gradient-to-b from-white/[0.05] to-white/[0.012] p-7 transition-all duration-500 hover:-translate-y-1 hover:border-green/40"
            data-reveal
          >
            <span class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-green/70 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100" />

            <div class="flex items-start justify-between gap-3">
              <span class="font-mono text-[11px] font-semibold tracking-[0.2em] text-white/30">
                {String(i + 2).padStart(2, "0")}
              </span>
              {soon && (
                <span class="rounded-full border border-green/30 bg-green/10 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.1em] text-green">
                  {fo.comingSoon}
                </span>
              )}
            </div>

            {icon && (
              <span class="mt-5 grid h-14 w-14 place-items-center rounded-2xl border border-white/10 bg-white/[0.03] p-2 transition-transform duration-500 group-hover:scale-105 group-hover:border-green/30">
                <img src={icon.src} alt="" class="h-9 w-auto object-contain" loading="lazy" />
              </span>
            )}

            <div class="mt-6">
              <h3 class="text-xl font-bold tracking-[-0.02em] text-white transition-colors duration-300 group-hover:text-green">
                {product.eyebrow}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-white/60">{product.card}</p>
              <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-green">
                Kanna loysn
                <span class="transition-transform duration-300 group-hover:translate-x-1.5" aria-hidden="true">
                  →
                </span>
              </span>
            </div>
          </a>
        );
      })
    }
  </div>
</div>
