---
import { fo, type products } from "../content/fo";

interface Props {
  product: (typeof products)[number];
  index: number;
}

const { product, index } = Astro.props;
const n = String(index + 1).padStart(2, "0");
---

<a
  href={product.href}
  class="group relative flex min-h-[220px] flex-col justify-between overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] p-6 transition hover:border-green/60 hover:bg-white/[0.06] sm:p-8"
>
  <div class="absolute inset-y-0 left-0 w-1.5 bg-green opacity-0 transition group-hover:opacity-100"></div>
  <div class="flex items-start justify-between gap-4">
    <span class="text-xs font-semibold tracking-[0.2em] text-mist">{n}</span>
    {
      "comingSoon" in product && product.comingSoon && (
        <span class="rounded-full border border-green/40 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-green">
          {fo.comingSoon}
        </span>
      )
    }
  </div>
  <div>
    <h3 class="text-2xl font-semibold tracking-tight text-white">{product.eyebrow}</h3>
    <p class="mt-2 max-w-sm text-sm leading-relaxed text-white/70">{product.card}</p>
    <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-green">
      Les meira
      <span aria-hidden="true" class="transition group-hover:translate-x-1">→</span>
    </span>
  </div>
</a>
