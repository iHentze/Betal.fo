---
import { fo, type products } from "../content/fo";
import ProductGraphic from "./ProductGraphic.astro";
import AnimatedCheckout from "./AnimatedCheckout.astro";
import BackofficeSimulator from "./BackofficeSimulator.astro";

interface Props {
  product: (typeof products)[number];
}

const { product } = Astro.props;
const extra = "extra" in product ? product.extra : undefined;
const soon = "comingSoon" in product && product.comingSoon;

const showcase =
  product.id === "alnetinum" ? "checkout" : product.id === "hald" ? "backoffice" : extra ? "photo" : "none";
---

<!-- ============================== HERO ============================== -->
<section class="grain relative isolate overflow-hidden">
  <div class="aurora -left-40 -top-32 h-[28rem] w-[28rem] bg-green/14"></div>
  <div class="aurora -right-40 top-20 h-[30rem] w-[30rem] bg-[#4b1fa8]/25"></div>

  <div class="relative mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
    <div class="grid items-center gap-14 lg:grid-cols-[1.05fr_auto]">
      <div data-reveal-group="90" style={`view-transition-name: product-${product.id}`}>
        <div class="flex flex-wrap items-center gap-3" data-reveal>
          <span
            class="inline-flex items-center rounded-full border border-green/25 bg-green/8 px-3.5 py-1.5 text-[11px] font-semibold uppercase tracking-[0.22em] text-green"
          >
            {product.eyebrow}
          </span>
          {
            soon && (
              <span class="inline-flex items-center gap-2 rounded-full bg-green px-3.5 py-1.5 text-[11px] font-bold uppercase tracking-[0.12em] text-navy">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-navy" />
                {fo.comingSoon}
              </span>
            )
          }
        </div>

        <h1
          class="mt-6 text-[2.5rem] font-bold leading-[1.02] tracking-[-0.035em] text-white sm:text-6xl"
          data-reveal
        >
          {product.title}
        </h1>

        <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/70" data-reveal>{product.lead}</p>

        <div class="mt-9 flex flex-wrap items-center gap-3" data-reveal>
          <a
            href={`/samband/?t=${product.id}`}
            class="group rounded-full bg-green px-7 py-3.5 text-sm font-semibold text-navy transition-all duration-300 active:scale-[0.98] hover:brightness-[1.08] hover:shadow-[0_0_35px_-6px_rgba(123,216,101,0.65)]"
          >
            <span class="flex items-center gap-2">
              {fo.productCta.button}
              <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
            </span>
          </a>
          <a
            href="/#loysnir"
            class="rounded-full border border-white/15 bg-white/[0.04] px-7 py-3.5 text-sm font-semibold text-white backdrop-blur-md transition-all duration-300 hover:border-white/30 hover:bg-white/[0.08]"
          >
            {fo.productCta.other}
          </a>
        </div>
      </div>

      <div class="flex justify-center lg:justify-end" data-reveal>
        <div
          class="spotlight grid place-items-center rounded-[2rem] border border-white/10 bg-white/[0.03] p-10 backdrop-blur-xl sm:p-12"
        >
          <ProductGraphic id={product.id} />
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============================ FEATURES ============================ -->
<section class="mx-auto max-w-6xl px-5 pb-14 sm:px-8 sm:pb-20">
  <div class="grid gap-5 md:grid-cols-2" data-reveal-group="90">
    {
      product.points.map((point) => (
        <article
          class="spotlight group rounded-3xl border border-white/10 bg-gradient-to-b from-white/[0.05] to-white/[0.012] p-7 transition-all duration-500 hover:-translate-y-1 hover:border-green/40 sm:p-8"
          data-reveal
        >
          <span class="grid h-9 w-9 place-items-center rounded-xl border border-green/25 bg-green/10 text-green">
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path
                fill-rule="evenodd"
                d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0l-3.5-3.5a1 1 0 111.4-1.4l2.8 2.79 6.8-6.79a1 1 0 011.4 0z"
                clip-rule="evenodd"
              />
            </svg>
          </span>
          <h2 class="mt-5 text-lg font-bold tracking-[-0.01em] text-white transition-colors duration-300 group-hover:text-green">
            {point.title}
          </h2>
          <p class="mt-2.5 text-sm leading-relaxed text-white/60">{point.text}</p>
        </article>
      ))
    }
  </div>

  <div
    class="mt-8 flex flex-col items-start gap-3 rounded-2xl border border-white/10 bg-white/[0.025] p-5 sm:flex-row sm:items-center sm:p-6"
    data-reveal
  >
    <span
      class="shrink-0 rounded-lg border border-green/25 bg-green/10 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-green"
    >
      {fo.audienceLabel}
    </span>
    <p class="text-sm leading-relaxed text-white/70">{product.audience}</p>
  </div>

  <!-- Product-specific showcase -->
  {
    showcase === "checkout" && (
      <div
        class="spotlight mt-14 grid items-center gap-12 rounded-[2rem] border border-white/10 bg-gradient-to-br from-white/[0.05] to-transparent p-7 sm:p-12 lg:grid-cols-2"
        data-reveal
      >
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-green">
            {extra && "eyebrow" in extra ? extra.eyebrow : fo.home.onlineTitle}
          </p>
          <h2 class="mt-3 text-2xl font-bold leading-[1.1] tracking-[-0.02em] text-white sm:text-3xl">
            {extra?.title}
          </h2>
          <p class="mt-4 max-w-lg text-sm leading-relaxed text-white/65">{extra?.body}</p>
          {
            extra && "tags" in extra && extra.tags && (
              <ul class="mt-6 flex flex-wrap gap-2">
                {extra.tags.map((tag) => (
                  <li class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1.5 text-xs text-white/70">
                    {tag}
                  </li>
                ))}
              </ul>
            )
          }
        </div>
        <div class="flex justify-center">
          <AnimatedCheckout />
        </div>
      </div>
    )
  }

  {
    showcase === "backoffice" && (
      <div
        class="spotlight mt-14 grid items-center gap-12 rounded-[2rem] border border-white/10 bg-gradient-to-br from-white/[0.05] to-transparent p-7 sm:p-12 lg:grid-cols-2"
        data-reveal
      >
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-green">
            {extra && "eyebrow" in extra ? extra.eyebrow : fo.home.backofficeEyebrow}
          </p>
          <h2 class="mt-3 text-2xl font-bold leading-[1.1] tracking-[-0.02em] text-white sm:text-3xl">
            {extra?.title}
          </h2>
          <p class="mt-4 max-w-lg text-sm leading-relaxed text-white/65">{extra?.body}</p>
        </div>
        <div class="flex justify-center">
          <BackofficeSimulator />
        </div>
      </div>
    )
  }

  {
    showcase === "photo" && extra && (
      <div
        class="mt-14 grid items-center overflow-hidden rounded-[2rem] border border-white/10 bg-gradient-to-b from-white/[0.045] to-transparent md:grid-cols-2"
        data-reveal
      >
        <div class="p-7 sm:p-12">
          <h2 class="text-2xl font-bold leading-[1.1] tracking-[-0.02em] text-white sm:text-3xl">{extra.title}</h2>
          <p class="mt-4 text-sm leading-relaxed text-white/65">{extra.body}</p>
        </div>
        <div class="relative min-h-[18rem] w-full overflow-hidden">
          <img src={extra.photo} alt={extra.photoAlt} class="h-full w-full object-cover" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-l from-transparent to-navy/60" />
        </div>
      </div>
    )
  }
</section>

<!-- ============================== CTA ============================== -->
<section class="mx-auto max-w-6xl px-5 pb-24 sm:px-8">
  <div class="relative overflow-hidden rounded-[2rem] bg-green p-8 text-navy sm:p-14" data-reveal>
    <div class="pointer-events-none absolute -right-16 -top-20 h-64 w-64 rounded-full bg-white/25 blur-3xl"></div>
    <div class="relative max-w-xl">
      <h2 class="text-3xl font-bold leading-[1.08] tracking-[-0.03em] sm:text-4xl">{fo.productCta.title}</h2>
      <p class="mt-3 text-sm font-medium leading-relaxed text-navy/75 sm:text-base">
        {fo.productCta.lead}
      </p>
      <a
        href={`/samband/?t=${product.id}`}
        class="group mt-8 inline-flex items-center gap-2 rounded-full bg-navy px-7 py-3.5 text-sm font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:shadow-xl"
      >
        {fo.productCta.button}
        <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
