---
import { fo, type products } from "../content/fo";
import ProductGraphic from "./ProductGraphic.astro";

interface Props {
  product: (typeof products)[number];
}

const { product } = Astro.props;
const extra = "extra" in product ? product.extra : undefined;
---

<section class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-y-0 left-0 hidden w-20 bg-green sm:block md:w-28 slab-thin"></div>
  <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-5 py-16 sm:px-8 sm:py-24 sm:pl-32 md:grid-cols-[1.1fr_0.9fr] md:pl-40">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-green">{product.eyebrow}</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight text-white sm:text-6xl">
        {product.title}
      </h1>
      {
        "comingSoon" in product && product.comingSoon && (
          <p class="mt-5 inline-flex rounded-full bg-green px-3 py-1 text-xs font-semibold uppercase tracking-wider text-navy">
            {fo.comingSoon}
          </p>
        )
      }
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/80">{product.lead}</p>
    </div>
    <div class="md:justify-self-end">
      <ProductGraphic id={product.id} />
    </div>
  </div>
</section>

<section class="mx-auto max-w-6xl px-5 py-8 sm:px-8 sm:py-12">
  <div class="grid gap-4 md:grid-cols-2">
    {
      product.points.map((point) => (
        <article class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 sm:p-8">
          <h2 class="text-xl font-semibold text-white">{point.title}</h2>
          <p class="mt-3 text-sm leading-relaxed text-white/70">{point.text}</p>
        </article>
      ))
    }
  </div>
  <p class="mt-10 text-sm text-mist">
    <span class="font-semibold text-white">{fo.audienceLabel}.</span>
    {product.audience}
  </p>
  {
    extra && (
      <div class="mt-12 grid items-center overflow-hidden rounded-3xl border border-white/10 bg-white/[0.03] md:grid-cols-2">
        <div class="p-6 md:p-10">
          <h2 class="text-2xl font-semibold text-white">{extra.title}</h2>
          <p class="mt-3 text-sm leading-relaxed text-white/70">{extra.body}</p>
        </div>
        <img src={extra.photo} alt={extra.photoAlt} class="h-full min-h-[16rem] w-full object-cover" />
      </div>
    )
  }
</section>

<section class="mx-auto max-w-6xl px-5 pb-20 sm:px-8">
  <div class="overflow-hidden rounded-3xl bg-green px-6 py-10 text-navy sm:px-12 sm:py-14">
    <h2 class="max-w-xl text-3xl font-semibold tracking-tight sm:text-4xl">{fo.productCta.title}</h2>
    <a
      href={`/samband/?t=${product.id}`}
      class="mt-6 inline-flex rounded-full bg-navy px-5 py-3 text-sm font-semibold text-white transition hover:bg-navy/90"
    >
      {fo.productCta.button}
    </a>
  </div>
</section>
