---
import { fo, type products } from "../content/fo";
import ProductGraphic from "./ProductGraphic.astro";
import CheckoutSimulator from "./CheckoutSimulator.astro";
import BackofficeSimulator from "./BackofficeSimulator.astro";

interface Props {
  product: (typeof products)[number];
}

const { product } = Astro.props;
const extra = "extra" in product ? product.extra : undefined;
---

<!-- Hero Section for Product Page -->
<section class="relative overflow-hidden py-16 sm:py-24">
  <!-- Glowing subtle lights -->
  <div class="pointer-events-none absolute -top-40 -left-40 w-96 h-96 rounded-full bg-green/10 blur-[130px]"></div>
  <div class="pointer-events-none absolute top-1/2 -right-40 w-80 h-80 rounded-full bg-green/5 blur-[120px]"></div>

  <div class="pointer-events-none absolute inset-y-0 left-0 hidden w-20 bg-green/90 sm:block md:w-28 slab-thin"></div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-5 sm:px-8 sm:pl-32 md:grid-cols-[1.1fr_0.9fr] md:pl-40">
    <div>
      <div class="inline-flex items-center gap-2 rounded-full border border-green/30 bg-green/10 px-3.5 py-1.5 text-xs font-semibold uppercase tracking-[0.2em] text-green w-fit mb-4">
        <span>{product.eyebrow}</span>
      </div>

      <h1 class="text-4xl font-bold tracking-tight text-white sm:text-6xl leading-[1.1]">
        {product.title}
      </h1>

      {
        "comingSoon" in product && product.comingSoon && (
          <div class="mt-5">
            <span class="inline-flex items-center gap-2 rounded-full bg-green px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-navy shadow-lg shadow-green/20">
              <span class="w-2 h-2 rounded-full bg-navy animate-pulse"></span>
              {fo.comingSoon}
            </span>
          </div>
        )
      }

      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/80 font-normal">{product.lead}</p>

      <div class="mt-8 flex flex-wrap gap-4 items-center">
        <a
          href={`/samband/?t=${product.id}`}
          class="rounded-full bg-green px-7 py-3.5 text-sm font-semibold text-navy transition-all duration-200 hover:brightness-110 hover:shadow-[0_0_20px_rgba(122,217,102,0.35)]"
        >
          {fo.productCta.button}
        </a>
        <a
          href="/#loysnir"
          class="rounded-full border border-white/20 bg-white/5 px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-white/10"
        >
          Aðrar loysnir
        </a>
      </div>
    </div>

    <div class="flex justify-center md:justify-end">
      <div class="relative p-6 sm:p-8 rounded-3xl border border-white/10 bg-white/[0.03] backdrop-blur-xl">
        <ProductGraphic id={product.id} />
      </div>
    </div>
  </div>
</section>

<!-- Feature Bento Grid Section -->
<section class="mx-auto max-w-6xl px-5 py-8 sm:px-8 sm:py-12">
  <div class="grid gap-5 md:grid-cols-2">
    {
      product.points.map((point) => (
        <article class="group rounded-3xl border border-white/10 bg-gradient-to-b from-white/[0.04] to-white/[0.01] p-7 sm:p-8 transition-all hover:border-green/40 hover:-translate-y-0.5">
          <div class="flex items-center gap-3 mb-3">
            <div class="h-6 w-6 rounded-full bg-green/15 text-green flex items-center justify-center text-xs font-bold">✓</div>
            <h2 class="text-xl font-bold text-white group-hover:text-green transition-colors">{point.title}</h2>
          </div>
          <p class="text-sm leading-relaxed text-white/70 pl-9">{point.text}</p>
        </article>
      ))
    }
  </div>

  <div class="mt-10 rounded-2xl border border-white/10 bg-white/[0.02] p-5 sm:p-6 flex flex-col sm:flex-row items-start sm:items-center gap-3">
    <span class="rounded-lg bg-green/15 border border-green/30 px-3 py-1 text-xs font-bold uppercase tracking-wider text-green shrink-0">
      {fo.audienceLabel}
    </span>
    <p class="text-sm text-white/80 leading-relaxed">
      {product.audience}
    </p>
  </div>

  <!-- Interactive Component or Photo block based on product -->
  {
    product.id === "alnetinum" ? (
      <div class="mt-14 grid items-center gap-10 rounded-3xl border border-white/10 bg-gradient-to-br from-white/[0.04] to-transparent p-6 sm:p-10 lg:grid-cols-2">
        <div>
          <div class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-green mb-2">
            ePay Checkout
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold text-white">Eingin nethandil? Send eitt trygt gjaldsleinki.</h2>
          <p class="mt-4 text-sm leading-relaxed text-white/75">
            Fakturar, serstøk tilboð ella stakar sølur. Send eitt leinki við telduposti ella SMS. Viðskiftafólkið letur leinkjuna upp og rindar við Apple Pay, Google Pay ella gjaldskorti.
          </p>
          <div class="mt-6 flex flex-wrap gap-2 text-xs">
            <span class="px-3 py-1 rounded-full bg-white/5 border border-white/10 text-white/80">Ongin kassi tørvaður</span>
            <span class="px-3 py-1 rounded-full bg-white/5 border border-white/10 text-white/80">Fullt yvirlit í backoffice</span>
          </div>
        </div>
        <div class="flex justify-center">
          <CheckoutSimulator />
        </div>
      </div>
    ) : product.id === "hald" ? (
      <div class="mt-14 grid items-center gap-10 rounded-3xl border border-white/10 bg-gradient-to-br from-white/[0.04] to-transparent p-6 sm:p-10 lg:grid-cols-2">
        <div>
          <div class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-green mb-2">
            Backoffice & Hald
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold text-white">Fullt eftirlit og sjálvvirkandi inngjaldingar.</h2>
          <p class="mt-4 text-sm leading-relaxed text-white/75">
            Vit seta tína ePay-haldarskipan upp, so gjøld verða drigin sjálvvirkandi eftir avtalu. Fylg við øllum viðskiftafólkum og inngjaldingum á einum stað.
          </p>
        </div>
        <div class="flex justify-center">
          <BackofficeSimulator />
        </div>
      </div>
    ) : extra && (
      <div class="mt-14 grid items-center overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-b from-white/[0.04] to-transparent md:grid-cols-2">
        <div class="p-7 sm:p-10">
          <h2 class="text-2xl sm:text-3xl font-bold text-white">{extra.title}</h2>
          <p class="mt-4 text-sm leading-relaxed text-white/75">{extra.body}</p>
        </div>
        <div class="relative h-full min-h-[18rem] w-full overflow-hidden">
          <img src={extra.photo} alt={extra.photoAlt} class="h-full w-full object-cover" />
        </div>
      </div>
    )
  }
</section>

<!-- Bottom CTA Section -->
<section class="mx-auto max-w-6xl px-5 pb-20 sm:px-8">
  <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-green via-[#8ae676] to-green p-8 sm:p-14 text-navy shadow-2xl">
    <div class="pointer-events-none absolute -top-12 -right-12 w-48 h-48 rounded-full bg-white/20 blur-2xl"></div>
    
    <div class="max-w-xl">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{fo.productCta.title}</h2>
      <p class="mt-3 text-sm sm:text-base text-navy/80 font-medium">
        Fá eitt óbindandi prát um tína gjaldsloysn. Vit svara beinanvegin og hjálpa tær í gongd.
      </p>
      <a
        href={`/samband/?t=${product.id}`}
        class="mt-7 inline-flex rounded-full bg-navy px-7 py-3.5 text-sm font-semibold text-white transition-all duration-200 hover:bg-navy/90 hover:shadow-lg hover:-translate-y-0.5"
      >
        {fo.productCta.button}
      </a>
    </div>
  </div>
</section>
