---
/**
 * The three drawings for the Tilgongdin section.
 *
 * Same hand as ValueGraphic: one 64x40 grid, one stroke weight, MUTED for the
 * body and GREEN for the part that is yours or that just happened. The
 * difference is that these three have to read as a sequence, which the six
 * value drawings do not — so one muted counter line at y=34 opens all three and
 * everything stands on it, and two objects are literally the same object
 * redrawn at the same coordinates: the 17x11.5 screen at x=5,y=17 and the
 * 15x22 terminal, which is green and centre-stage in step 1 and muted at the
 * till in step 3 with its screen lit.
 *
 * Green moves left to right across the set — the offer in the middle, then the
 * merchant's own signature low on the page, then current running into the
 * terminal — so the colour itself carries the direction of travel.
 */

interface Props {
  step: 1 | 2 | 3;
  class?: string;
}

const { step, class: className = "" } = Astro.props;

const MUTED = "rgba(255,255,255,0.32)";
const GREEN = "#7bd865";

/** The surface all three stand on. Drawn first so nothing else sits under it. */
const COUNTER = "M3 34h58";
---

<svg
  viewBox="0 0 64 40"
  width="112"
  height="70"
  fill="none"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class:list={["h-auto overflow-visible", className]}
>
  {
    step === 1 && (
      <g>
        <path d={COUNTER} stroke={MUTED} />

        {/* Where you sell today: your own screen, standing on the counter.
            Returns at these exact coordinates in step 3. */}
        <rect x="5" y="17" width="17" height="11.5" rx="2" stroke={MUTED} />
        <path d="M5 21h17" stroke={MUTED} />
        <path d="M13.5 28.5V34" stroke={MUTED} />

        {/* The fitting solution, set down between the two: tallest thing on the
            counter and the only thing in colour, so the pick needs no arrow. */}
        <rect x="27" y="12" width="15" height="22" rx="3" stroke={GREEN} />
        <rect x="30" y="14.5" width="9" height="6" rx="1" stroke={GREEN} />
        <path d="M30 24.5h9M30 29h9" stroke={GREEN} />

        {/* The half of the sentence the objects cannot draw: the conversation
            that arrives at the recommendation. Tail points back at it. */}
        <rect x="46" y="5" width="15" height="13" rx="3" stroke={MUTED} />
        <path d="M50 18v3.5L53.5 18" stroke={MUTED} />
        <path d="M49 9.5h9M49 13.5h5" stroke={MUTED} />
      </g>
    )
  }

  {
    step === 2 && (
      <g>
        <path d={COUNTER} stroke={MUTED} />

        {/* The agreement standing on the counter: the fields you fill in, and
            the rule your own name goes on. */}
        <rect x="4" y="4" width="28" height="30" rx="2.5" stroke={MUTED} />
        <path d="M9 11h18M9 16h12" stroke={MUTED} />
        <path d="M9 30h18" stroke={MUTED} />

        {/* Samleikin: your identity, on your own phone, beside the sheet. */}
        <rect x="44" y="6" width="15" height="28" rx="3.5" stroke={MUTED} />
        <circle cx="51.5" cy="17" r="3" stroke={MUTED} />
        <path d="M46.5 26.2c1.2-2.9 3-4.2 5-4.2s3.8 1.3 5 4.2" stroke={MUTED} />

        {/* One green gesture in two parts: identity leaves the phone and lands
            on the paper as the one mark only you can make. */}
        <path d="M43.5 24c-2.3 3-5.4 4.2-11.5 4.2" stroke={GREEN} />
        <path
          d="M10 28.1C11.2 22.9 14.6 21.3 15.6 24.5C16.6 27.7 15.8 29.1 17.4 28.9C19.6 28.6 21 23.3 23 24.1C24.6 24.7 24 27.9 26 27.7C27 27.6 27.8 26.7 28.6 25.1"
          stroke={GREEN}
        />

        {/* Approved, a week or two later. Muted: the outcome is ours to report,
            the green belongs to the thing you did. */}
        <path d="m35.4 12.4 2.2 2.4 4.8-5.8" stroke={MUTED} />
      </g>
    )
  }

  {
    step === 3 && (
      <g>
        <path d={COUNTER} stroke={MUTED} />

        {/* Your screen, back at the coordinates it held in step 1 */}
        <rect x="5" y="17" width="17" height="11.5" rx="2" stroke={MUTED} />
        <path d="M5 21h17" stroke={MUTED} />
        <path d="M13.5 28.5V34" stroke={MUTED} />

        {/* The terminal from step 1, now standing at the till and no longer the
            thing being offered — so it drops to muted */}
        <rect x="44" y="12" width="15" height="22" rx="3" stroke={MUTED} />
        <path d="M47 24.5h9M47 29h9" stroke={MUTED} />

        {/* The run between them, ending in a screen that is lit */}
        <path d="M22 24h6a3 3 0 0 1 3 3a3 3 0 0 0 3 3h10" stroke={GREEN} />
        <rect x="47" y="14.5" width="9" height="6" rx="1" fill={GREEN} stroke="none" />
      </g>
    )
  }
</svg>
