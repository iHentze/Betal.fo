---
interface Props {
  amount?: string;
}

const { amount = "249 kr" } = Astro.props;
---

<div class="w-full max-w-[22rem] rounded-3xl border border-white/10 bg-[#160a3d] p-5 shadow-[0_24px_80px_rgba(0,0,0,0.45)]">
  <div class="mb-5 flex items-center justify-between">
    <span class="text-sm font-light tracking-tight text-white">betal</span>
    <span class="text-[11px] text-mist">Trygt gjald</span>
  </div>
  <div class="grid grid-cols-2 gap-2">
    <button type="button" tabindex="-1" class="rounded-xl bg-white px-3 py-2.5 text-center text-xs font-semibold text-navy">
      Apple Pay
    </button>
    <button type="button" tabindex="-1" class="rounded-xl bg-white/10 px-3 py-2.5 text-center text-xs font-semibold text-white">
      Google Pay
    </button>
  </div>
  <p class="mt-5 text-[11px] font-semibold uppercase tracking-[0.16em] text-mist">Ella kort</p>
  <div class="mt-2 space-y-2">
    <div class="rounded-xl border border-white/10 bg-white/5 px-3 py-3">
      <p class="text-[10px] uppercase tracking-wider text-mist">Kortnummar</p>
      <p class="mt-1 font-mono text-sm tracking-wider text-white">4242 4242 4242 4242</p>
    </div>
    <div class="grid grid-cols-2 gap-2">
      <div class="rounded-xl border border-white/10 bg-white/5 px-3 py-3">
        <p class="text-[10px] uppercase tracking-wider text-mist">Gildug</p>
        <p class="mt-1 font-mono text-sm text-white">08 / 28</p>
      </div>
      <div class="rounded-xl border border-white/10 bg-white/5 px-3 py-3">
        <p class="text-[10px] uppercase tracking-wider text-mist">CVC</p>
        <p class="mt-1 font-mono text-sm text-white">•••</p>
      </div>
    </div>
  </div>
  <div class="mt-4 rounded-full bg-green py-3 text-center text-sm font-semibold text-navy">
    Rinda {amount}
  </div>
</div>
