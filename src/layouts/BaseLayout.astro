---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { fo } from "../content/fo";
import { site } from "../content/site";

interface Props {
  title?: string;
  description?: string;
}

const title = Astro.props.title ?? fo.meta.title;
const description = Astro.props.description ?? fo.meta.description;
const canonical = new URL(Astro.url.pathname, site.url).href;
---

<!doctype html>
<html lang="fo">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0D0033" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fo_FO" />
    <meta property="og:site_name" content={site.name} />
  </head>
  <body class="min-h-dvh bg-navy text-white antialiased">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
