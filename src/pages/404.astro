---
import BaseLayout from "../layouts/BaseLayout.astro";
import { fo } from "../content/fo";
---

<BaseLayout title={`Ikki funnið — betal`} description={fo.notFound.lead}>
  <div class="pointer-events-none absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 rounded-full bg-green/10 blur-[140px]"></div>

  <section class="relative mx-auto flex min-h-[65dvh] max-w-6xl flex-col justify-center items-center text-center px-5 py-24 sm:px-8">
    <span class="inline-block rounded-full bg-green/10 border border-green/30 px-4 py-1.5 text-xs font-mono font-bold tracking-widest text-green mb-4">
      404 • FEILUR
    </span>
    <h1 class="max-w-xl text-4xl sm:text-6xl font-bold tracking-tight text-white">{fo.notFound.title}</h1>
    <p class="mt-5 max-w-md text-base sm:text-lg text-white/70 leading-relaxed">{fo.notFound.lead}</p>
    <a
      href="/"
      class="mt-8 inline-flex rounded-full bg-green btn-green px-7 py-3.5 text-sm font-semibold text-navy transition-all duration-200 hover:brightness-110 hover:shadow-[0_0_20px_rgba(122,217,102,0.35)]"
    >
      {fo.notFound.home}
    </a>
  </section>
</BaseLayout>
