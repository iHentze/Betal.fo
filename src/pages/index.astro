---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import MethodsRow from "../components/MethodsRow.astro";
import { fo, products } from "../content/fo";
---

<BaseLayout>
  <section class="relative min-h-[calc(100dvh-4.25rem)] overflow-hidden">
    <div class="absolute inset-0 md:inset-y-0 md:left-auto md:right-0 md:w-[58%]">
      <img
        src="/brand/photo-tote.jpg"
        alt="Betal posi við telefon-ikoninum"
        class="h-full w-full object-cover object-[70%_center]"
      />
    </div>
    <div class="absolute inset-0 bg-navy/80 md:hidden"></div>
    <div class="absolute inset-y-0 left-0 hidden w-[50%] bg-navy md:block slab"></div>
    <div class="relative mx-auto flex min-h-[calc(100dvh-4.25rem)] max-w-6xl flex-col justify-center px-5 py-20 sm:px-8 md:w-[52%] md:pr-10">
      <img src="/brand/wordmark-green.svg" alt="betal" class="mb-8 h-16 w-auto sm:h-20" />
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-green">{fo.home.eyebrow}</p>
      <h1 class="mt-5 max-w-xl text-5xl font-semibold tracking-tight text-white sm:text-7xl">
        {fo.home.title}
      </h1>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-white/75">{fo.home.lead}</p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href="#taenastur"
          class="rounded-full bg-green px-5 py-3 text-sm font-semibold text-navy transition hover:brightness-110"
        >
          {fo.home.primary}
        </a>
        <a
          href="/samband/"
          class="rounded-full border border-white/20 px-5 py-3 text-sm font-semibold text-white transition hover:border-white/50"
        >
          {fo.home.secondary}
        </a>
      </div>
    </div>
  </section>

  <MethodsRow />

  <section class="bg-green">
    <div class="mx-auto flex max-w-6xl items-center justify-center px-5 py-14 sm:px-8 sm:py-20">
      <img src="/brand/wordmark-navy.svg" alt="betal" class="h-14 w-auto sm:h-20" />
    </div>
  </section>

  <section id="taenastur" class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
    <p class="text-xs font-semibold uppercase tracking-[0.22em] text-green">{fo.home.productsEyebrow}</p>
    <h2 class="mt-3 max-w-xl text-3xl font-semibold tracking-tight sm:text-5xl">{fo.home.productsTitle}</h2>
    <p class="mt-4 max-w-xl text-base text-white/70">{fo.home.contrast}</p>
    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {products.map((product, index) => <ProductCard product={product} index={index} />)}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-20 sm:px-8">
    <p class="text-xs font-semibold uppercase tracking-[0.22em] text-green">{fo.steps.eyebrow}</p>
    <h2 class="mt-3 max-w-xl text-3xl font-semibold tracking-tight sm:text-5xl">{fo.steps.title}</h2>
    <ol class="mt-10 grid gap-4 md:grid-cols-3">
      {
        fo.steps.items.map((step, index) => (
          <li class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 sm:p-8">
            <p class="text-xs font-semibold tracking-[0.2em] text-green">{String(index + 1).padStart(2, "0")}</p>
            <h3 class="mt-3 text-xl font-semibold text-white">{step.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-white/70">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-20 sm:px-8">
    <div class="grid overflow-hidden rounded-3xl border border-white/10 md:grid-cols-2">
      <img src="/brand/photo-card.jpg" alt="Betal-kort við skriftmerki" class="h-full min-h-[16rem] w-full object-cover" />
      <div class="px-6 py-10 sm:px-10 sm:py-14">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-green">{fo.home.aboutEyebrow}</p>
        <h2 class="mt-3 max-w-xl text-3xl font-semibold tracking-tight sm:text-4xl">{fo.home.aboutTitle}</h2>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-white/75">{fo.home.about}</p>
        <a
          href="/samband/"
          class="mt-8 inline-flex rounded-full bg-green px-5 py-3 text-sm font-semibold text-navy transition hover:brightness-110"
        >
          {fo.home.secondary}
        </a>
      </div>
    </div>
    <div class="mt-4 grid overflow-hidden rounded-3xl border border-white/10 md:grid-cols-2">
      <div class="order-2 px-6 py-10 sm:px-10 sm:py-14 md:order-1">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-green">{products[1].eyebrow}</p>
        <h2 class="mt-3 max-w-xl text-3xl font-semibold tracking-tight sm:text-4xl">{products[1].title}</h2>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-white/75">{products[1].card}</p>
        <a
          href={products[1].href}
          class="mt-8 inline-flex rounded-full border border-white/20 px-5 py-3 text-sm font-semibold text-white transition hover:border-white/50"
        >
          Les meira
        </a>
      </div>
      <img
        src="/brand/photo-app-icon.jpg"
        alt="Betal-appin á telefonini"
        class="order-1 h-full min-h-[16rem] w-full object-cover md:order-2"
      />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-24 sm:px-8">
    <p class="text-xs font-semibold uppercase tracking-[0.22em] text-green">{fo.faq.eyebrow}</p>
    <h2 class="mt-3 max-w-xl text-3xl font-semibold tracking-tight sm:text-5xl">{fo.faq.title}</h2>
    <dl class="mt-10 divide-y divide-white/10 border-y border-white/10">
      {
        fo.faq.items.map((item) => (
          <div class="grid gap-3 py-6 md:grid-cols-[minmax(0,0.4fr)_1fr] md:gap-10">
            <dt class="text-lg font-semibold text-white">{item.q}</dt>
            <dd class="text-sm leading-relaxed text-white/70">{item.a}</dd>
          </div>
        ))
      }
    </dl>
  </section>
</BaseLayout>
