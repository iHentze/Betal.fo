---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductBento from "../components/ProductBento.astro";
import MethodsRow from "../components/MethodsRow.astro";
import ClientMarquee from "../components/ClientMarquee.astro";
import HeroShowcase from "../components/HeroShowcase.astro";
import AnimatedCheckout from "../components/AnimatedCheckout.astro";
import BackofficeSimulator from "../components/BackofficeSimulator.astro";
import Wordmark from "../components/Wordmark.astro";
import Faq from "../components/Faq.astro";
import ClosingCta from "../components/ClosingCta.astro";
import { fo, products } from "../content/fo";
---

<BaseLayout>
  <!-- ============================= HERO ============================= -->
  <section class="grain relative isolate overflow-hidden">
    <div class="aurora -left-32 -top-40 h-[30rem] w-[30rem] bg-green/18"></div>
    <div class="aurora -right-40 top-24 h-[34rem] w-[34rem] bg-[#4b1fa8]/30"></div>

    <div class="pointer-events-none absolute inset-y-0 right-0 hidden w-[44%] lg:block">
      <img
        src="/brand/photo-tote.jpg"
        alt=""
        aria-hidden="true"
        class="h-full w-full object-cover object-[62%_center] opacity-30"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-navy via-navy/80 to-navy/40"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-navy via-transparent to-navy/70"></div>
    </div>

    <div class="relative mx-auto max-w-6xl px-5 pb-14 pt-14 sm:px-8 sm:pb-20 sm:pt-20">
      <!-- A definite second track: an auto track would size itself to the
           checkout's content, so the window width would shift between states. -->
      <div class="grid items-center gap-16 lg:grid-cols-[1fr_23rem]">
        <div data-reveal-group="90">
          <div data-reveal>
            <Wordmark
              class="h-16 w-auto text-green drop-shadow-[0_0_45px_rgba(123,216,101,0.35)] sm:h-24"
              title="betal"
            />
          </div>

          <div
            class="mt-7 inline-flex w-fit items-center gap-2 rounded-full border border-green/25 bg-green/8 px-3.5 py-1.5"
            data-reveal
          >
            <span class="relative flex h-1.5 w-1.5">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green opacity-70"></span>
              <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-green"></span>
            </span>
            <span class="text-[11px] font-semibold uppercase tracking-[0.22em] text-green">{fo.home.eyebrow}</span>
          </div>

          <h1
            class="mt-5 text-[2.75rem] font-bold leading-[0.98] tracking-[-0.035em] text-white sm:text-7xl lg:text-[5rem]"
            data-reveal
          >
            {fo.home.title}
          </h1>

          <p class="mt-5 text-base font-semibold text-green sm:text-lg" data-reveal>
            {fo.home.kicker}
          </p>

          <p class="mt-4 max-w-xl text-lg leading-relaxed text-white/70" data-reveal>
            {fo.home.lead}
          </p>

          <div class="mt-9 flex flex-wrap items-center gap-3" data-reveal>
            <a
              href="#loysnir"
              class="group rounded-full bg-green px-7 py-3.5 text-sm font-semibold text-navy transition-all duration-300 active:scale-[0.98] hover:brightness-[1.08] hover:shadow-[0_0_35px_-6px_rgba(123,216,101,0.65)]"
            >
              <span class="flex items-center gap-2">
                {fo.home.primary}
                <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
              </span>
            </a>
            <a
              href="/samband/"
              class="rounded-full border border-white/15 bg-white/[0.04] px-7 py-3.5 text-sm font-semibold text-white backdrop-blur-md transition-all duration-300 hover:border-white/30 hover:bg-white/[0.08]"
            >
              {fo.home.secondary}
            </a>
          </div>

          <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-3 text-xs font-medium text-white/55" data-reveal>
            {
              fo.home.pills.map((item) => (
                <li class="flex items-center gap-2">
                  <svg class="h-3.5 w-3.5 shrink-0 text-green" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="flex justify-center lg:justify-end" data-reveal>
          <HeroShowcase />
        </div>
      </div>
    </div>
  </section>

  <!-- ====================== METHODS + REFERENCES ====================== -->
  <MethodsRow />
  <ClientMarquee />

  <!-- ============================ VALUES ============================ -->
  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
    <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-green" data-reveal>
      {fo.values.eyebrow}
    </p>
    <dl class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group="110">
      {
        fo.values.items.map((item) => (
          <div class="spotlight rounded-3xl border border-white/10 bg-white/[0.025] p-7" data-reveal>
            <dt class="text-xl font-bold tracking-[-0.02em] text-green">{item.title}</dt>
            <dd class="mt-3 text-sm leading-relaxed text-white/60">{item.text}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- =========================== PRODUCTS =========================== -->
  <section id="loysnir" class="relative isolate scroll-mt-24 overflow-hidden">
    <div class="aurora -right-40 top-32 h-[30rem] w-[30rem] bg-[#4b1fa8]/25"></div>
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
      <div class="mb-12 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between" data-reveal-group="80">
        <div data-reveal>
          <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-green">{fo.home.productsEyebrow}</p>
          <h2 class="mt-3 max-w-xl text-3xl font-bold leading-[1.05] tracking-[-0.03em] text-white sm:text-5xl">
            {fo.home.productsTitle}
          </h2>
        </div>
        <p class="max-w-sm text-sm leading-relaxed text-white/60" data-reveal>{fo.home.contrast}</p>
      </div>

      <ProductBento />

      <!-- Hard numbers under the solutions: what you get, and when -->
      <dl
        class="mt-5 grid gap-px overflow-hidden rounded-[1.75rem] border border-white/10 bg-white/10 sm:grid-cols-2"
        data-reveal
      >
        {
          fo.home.specs.map((spec) => (
            <div class="flex flex-col gap-1 bg-navy px-7 py-6">
              <dt class="text-[11px] font-semibold uppercase tracking-[0.18em] text-white/40">{spec.label}</dt>
              <dd class="text-xl font-bold tracking-[-0.02em] text-green tabular-nums">{spec.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ========================= ONLINE / EPAY ========================= -->
  <section class="relative isolate overflow-hidden">
    <div class="aurora -left-40 top-10 h-[26rem] w-[26rem] bg-green/10"></div>
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
      <div class="grid items-center gap-14 lg:grid-cols-2">
        <div data-reveal-group="80">
          <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-green" data-reveal>
            {products[0].eyebrow}
          </p>
          <h2 class="mt-3 text-3xl font-bold leading-[1.05] tracking-[-0.03em] text-white sm:text-5xl" data-reveal>
            {fo.home.onlineTitle}
          </h2>
          <p class="mt-5 max-w-lg text-base leading-relaxed text-white/70" data-reveal>
            {fo.home.onlineLead}
          </p>

          <ul class="mt-8 space-y-3" data-reveal-group="70">
            {
              fo.home.onlinePoints.map((row) => (
                <li
                  class="spotlight flex items-start gap-3.5 rounded-2xl border border-white/8 bg-white/[0.025] p-4"
                  data-reveal
                >
                  <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-green/15 text-[10px] font-bold text-green">
                    ✓
                  </span>
                  <span>
                    <span class="block text-sm font-semibold text-white">{row.title}</span>
                    <span class="mt-0.5 block text-xs leading-relaxed text-white/55">{row.text}</span>
                  </span>
                </li>
              ))
            }
          </ul>

          <a
            href={products[0].href}
            class="group mt-8 inline-flex items-center gap-2 text-sm font-semibold text-green"
            data-reveal
          >
            {fo.home.moreAbout} {products[0].eyebrow}
            <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
        </div>

        <div class="flex justify-center lg:justify-end" data-reveal>
          <AnimatedCheckout amount="1.249,00" />
        </div>
      </div>
    </div>
  </section>

  <!-- ========================= BRAND RIBBON ========================= -->
  <section class="relative overflow-hidden bg-green">
    <div class="pointer-events-none absolute -right-16 -top-20 h-64 w-64 rounded-full bg-white/25 blur-3xl"></div>
    <div
      class="relative mx-auto flex max-w-6xl flex-col gap-8 px-5 py-14 sm:px-8 sm:py-16 md:flex-row md:items-center md:justify-between"
    >
      <div>
        <Wordmark class="h-12 w-auto text-navy sm:h-16" title="betal" />
        <p class="mt-3 text-[11px] font-semibold uppercase tracking-[0.24em] text-navy/70">
          {fo.home.ribbonLabel}
        </p>
      </div>
      <div class="md:text-right">
        <p class="text-2xl font-bold tracking-tight text-navy sm:text-3xl">{fo.home.ribbonTitle}</p>
        <p class="mt-1 text-sm font-medium text-navy/70">{fo.home.ribbonText}</p>
      </div>
    </div>
  </section>

  <!-- ========================== BACKOFFICE ========================== -->
  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
    <div
      class="spotlight overflow-hidden rounded-[2rem] border border-white/10 bg-gradient-to-br from-white/[0.05] to-transparent p-7 sm:p-12"
    >
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div data-reveal-group="80">
          <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-green" data-reveal>
            {fo.home.backofficeEyebrow}
          </p>
          <h2 class="mt-3 text-3xl font-bold leading-[1.05] tracking-[-0.03em] text-white sm:text-4xl" data-reveal>
            {fo.home.backofficeTitle}
          </h2>
          <p class="mt-4 max-w-lg text-sm leading-relaxed text-white/65 sm:text-base" data-reveal>
            {fo.home.backofficeLead}
          </p>
          <ul class="mt-6 flex flex-wrap gap-2" data-reveal>
            {
              fo.home.backofficeTags.map((tag) => (
                <li class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1.5 text-xs text-white/70">
                  {tag}
                </li>
              ))
            }
          </ul>
          <a
            href={products[2].href}
            class="group mt-8 inline-flex items-center gap-2 text-sm font-semibold text-green"
            data-reveal
          >
            {fo.home.backofficeCta}
            <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
        </div>
        <div class="flex justify-center" data-reveal>
          <BackofficeSimulator />
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ SOFTPAY ============================ -->
  <section class="mx-auto max-w-6xl px-5 pb-16 sm:px-8 sm:pb-24">
    <div
      class="grid items-center overflow-hidden rounded-[2rem] border border-white/10 bg-gradient-to-b from-white/[0.045] to-transparent md:grid-cols-2"
      data-reveal
    >
      <div class="order-2 p-7 sm:p-12 md:order-1">
        <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-green">{products[1].eyebrow}</p>
        <h2 class="mt-3 text-3xl font-bold leading-[1.05] tracking-[-0.03em] text-white sm:text-4xl">
          {products[1].title}
        </h2>
        <p class="mt-4 max-w-lg text-sm leading-relaxed text-white/65 sm:text-base">
          {fo.home.softpayLead}
        </p>
        <a
          href={products[1].href}
          class="group mt-8 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.05] px-6 py-3.5 text-sm font-semibold text-white transition-all duration-300 hover:border-green/40 hover:bg-white/[0.09]"
        >
          {fo.home.softpayCta}
          <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
      </div>
      <div class="relative order-1 min-h-[19rem] w-full overflow-hidden md:order-2">
        <img src="/brand/photo-app-icon.jpg" alt="Betal-appin á telefonini" class="h-full w-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-r from-navy/70 via-transparent to-transparent md:from-navy/80"></div>
      </div>
    </div>
  </section>

  <!-- ============================= STEPS ============================= -->
  <section class="mx-auto max-w-6xl px-5 pb-16 sm:px-8 sm:pb-24">
    <div class="mx-auto mb-12 max-w-2xl text-center" data-reveal>
      <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-green">{fo.steps.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-bold leading-[1.05] tracking-[-0.03em] text-white sm:text-5xl">
        {fo.steps.title}
      </h2>
    </div>

    <ol class="grid gap-5 md:grid-cols-3" data-reveal-group="110">
      {
        fo.steps.items.map((step, index) => (
          <li class="spotlight relative rounded-3xl border border-white/10 bg-white/[0.025] p-7 sm:p-8" data-reveal>
            <span class="font-mono text-[11px] font-semibold tracking-[0.2em] text-green">
              {String(index + 1).padStart(2, "0")} —
            </span>
            <h3 class="mt-5 text-lg font-bold text-white">{step.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-white/60">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ============================= ABOUT ============================= -->
  <section class="mx-auto max-w-6xl px-5 pb-16 sm:px-8 sm:pb-24">
    <div
      class="grid items-center overflow-hidden rounded-[2rem] border border-white/10 bg-gradient-to-b from-white/[0.045] to-transparent md:grid-cols-2"
      data-reveal
    >
      <div class="relative min-h-[19rem] w-full overflow-hidden">
        <img src="/brand/photo-card.jpg" alt="Betal-kort við skriftmerki" class="h-full w-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-l from-navy/70 via-transparent to-transparent"></div>
      </div>
      <div class="p-7 sm:p-12">
        <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-green">{fo.home.aboutEyebrow}</p>
        <h2 class="mt-3 text-3xl font-bold leading-[1.05] tracking-[-0.03em] text-white sm:text-4xl">
          {fo.home.aboutTitle}
        </h2>
        <p class="mt-4 max-w-lg text-sm leading-relaxed text-white/65 sm:text-base">{fo.home.about}</p>
        <a
          href="/samband/"
          class="mt-8 inline-flex rounded-full bg-green px-7 py-3.5 text-sm font-semibold text-navy transition-all duration-300 active:scale-[0.98] hover:brightness-[1.08] hover:shadow-[0_0_30px_-6px_rgba(123,216,101,0.6)]"
        >
          {fo.home.secondary}
        </a>
      </div>
    </div>
  </section>

  <!-- ============================== FAQ ============================== -->
  <section class="mx-auto max-w-6xl px-5 pb-24 sm:px-8">
    <Faq items={fo.faq.items} />
  </section>

  <ClosingCta />
</BaseLayout>
