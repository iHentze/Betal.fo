---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import { fo, products } from "../content/fo";
---

<BaseLayout>
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-y-0 left-0 hidden w-[22%] max-w-xs bg-green md:block slab"></div>
    <p
      class="watermark pointer-events-none absolute right-4 top-1/2 hidden -translate-y-1/2 text-[7rem] font-light leading-none text-white/5 lg:block xl:right-10 xl:text-[9rem]"
      aria-hidden="true"
    >
      betal
    </p>
    <div class="relative mx-auto flex min-h-[calc(100dvh-4.25rem)] max-w-6xl flex-col justify-center px-5 py-20 sm:px-8 md:pl-44 lg:pl-52">
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-green">{fo.home.eyebrow}</p>
      <h1 class="mt-5 max-w-xl text-5xl font-semibold tracking-tight text-white sm:text-7xl">
        {fo.home.title}
      </h1>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-white/75">{fo.home.lead}</p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href="#taenastur"
          class="rounded-full bg-green px-5 py-3 text-sm font-semibold text-navy transition hover:brightness-110"
        >
          {fo.home.primary}
        </a>
        <a
          href="/samband/"
          class="rounded-full border border-white/20 px-5 py-3 text-sm font-semibold text-white transition hover:border-white/50"
        >
          {fo.home.secondary}
        </a>
      </div>
    </div>
  </section>

  <section id="taenastur" class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
    <p class="text-xs font-semibold uppercase tracking-[0.22em] text-green">{fo.home.productsEyebrow}</p>
    <h2 class="mt-3 max-w-xl text-3xl font-semibold tracking-tight sm:text-5xl">{fo.home.productsTitle}</h2>
    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {products.map((product, index) => <ProductCard product={product} index={index} />)}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-24 sm:px-8">
    <div class="grid overflow-hidden rounded-3xl border border-white/10 md:grid-cols-[minmax(0,0.35fr)_1fr]">
      <div class="hidden bg-green md:block slab-thin min-h-[16rem]"></div>
      <div class="px-6 py-10 sm:px-10 sm:py-14">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-green">{fo.home.aboutEyebrow}</p>
        <h2 class="mt-3 max-w-xl text-3xl font-semibold tracking-tight sm:text-4xl">{fo.home.aboutTitle}</h2>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-white/75">{fo.home.about}</p>
        <a
          href="/samband/"
          class="mt-8 inline-flex rounded-full bg-green px-5 py-3 text-sm font-semibold text-navy transition hover:brightness-110"
        >
          {fo.home.secondary}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
