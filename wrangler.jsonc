{
  "name": "betal-fo",
  // Keep the workers.dev URL alive alongside the custom domain: betal.fo does
  // not resolve until the nameservers move off nic.fo.
  "workers_dev": true,
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Assets are served before the Worker unless this is set, which would skip
    // the HTTPS redirect and the HSTS header entirely.
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "betal.fo", "custom_domain": true },
    { "pattern": "www.betal.fo", "custom_domain": true }
  ]
}
